{% extends "base.html" %}
{% block title %}Absent Today{% endblock %}
{% block page_title %}Absence Report{% endblock %}

{% block content %}
<div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
  <form method="get" class="d-flex align-items-center gap-2">
    <label class="fw-semibold mb-0" style="font-size:.9rem;white-space:nowrap;">Schedule Date</label>
    <input type="date" name="date" value="{{ target_date }}"
           class="form-control form-control-sm" style="width:160px;">
    <button class="btn btn-primary btn-sm" type="submit">
      <i class="bi bi-search me-1"></i>Check
    </button>
  </form>
  <span class="text-muted" style="font-size:.85rem;">
    Showing absences for <strong>{{ target_date }}</strong>
    — {{ records|length }} employee(s) absent
  </span>
  {% if records %}
  <button class="btn btn-outline-secondary btn-sm ms-auto" id="copyTableBtn" onclick="copyTable()">
    <i class="bi bi-clipboard me-1"></i>Copy Table
  </button>
  {% endif %}
</div>

{% if not records %}
<div class="card p-4 text-center">
  <i class="bi bi-check-circle text-success" style="font-size:2.5rem;"></i>
  <div class="mt-2 fw-semibold">No absences found for {{ target_date }}</div>
  <div class="text-muted" style="font-size:.85rem;">All scheduled employees have a time-in record.</div>
</div>
{% else %}

{% set ns = namespace(current_group='') %}
{% for row in records %}
  {% if row.group_name != ns.current_group %}
    {% if ns.current_group != '' %}</tbody></table></div></div>{% endif %}
    {% set ns.current_group = row.group_name %}
    <div class="card mb-3">
      <div class="card-header d-flex align-items-center gap-2 py-2"
           style="background:var(--bg);border-bottom:1px solid var(--border);">
        <i class="bi bi-people-fill" style="color:var(--accent);"></i>
        <span class="fw-semibold" style="font-size:.92rem;">{{ row.group_name or 'No Group' }}</span>
        <span class="badge rounded-pill ms-1"
              style="background:var(--accent);color:#fff;font-size:.72rem;">
          {{ records | selectattr('group_name','eq',row.group_name) | list | length }}
        </span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0 absence-table">
          <thead>
            <tr>
              <th>Employee</th>
              <th>Employee ID</th>
              <th>Team Lead</th>
              <th>Shift</th>
              <th>Status</th>
              <th>Remarks</th>
            </tr>
          </thead>
          <tbody>
  {% endif %}

  {% set emp_leaves = leave_map.get(row.employee_id, []) %}
  {% set emp_cws    = cws_map.get(row.employee_id, []) %}

  <tr>
    <td class="fw-semibold">{{ row.schedule_name }}</td>
    <td>
      <span class="emp-id-copy text-muted" style="font-size:.8rem;cursor:pointer;"
            onclick="copyEmpId(this, '{{ row.employee_id }}')">{{ row.employee_id }}</span>
    </td>
    <td style="font-size:.85rem;">{{ row.tl or '—' }}</td>
    <td>
      <span class="badge rounded-pill"
            style="background:#fef3c7;color:#92400e;border:1px solid #fde68a;font-size:.75rem;">
        <i class="bi bi-clock me-1"></i>{{ row.shift_time }}
      </span>
    </td>
    <td>
      <span class="badge rounded-pill"
            style="background:#fef2f2;color:#991b1b;border:1px solid #fecaca;font-size:.75rem;">
        <i class="bi bi-x-circle me-1"></i>Absent
      </span>
    </td>
    <td>
      <div class="d-flex flex-wrap gap-1 align-items-center">
        {% for lv in emp_leaves %}
          <span class="badge rounded-pill"
                style="background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;font-size:.72rem;">
            <i class="bi bi-calendar-check me-1"></i>On Leave
            {% if lv.leave_type_name %}&mdash; {{ lv.leave_type_name }}{% endif %}
            <span style="opacity:.7;">({{ lv.status | title }})</span>
          </span>
        {% endfor %}
        {% for cw in emp_cws %}
          <span class="badge rounded-pill"
                style="background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;font-size:.72rem;">
            <i class="bi bi-arrow-left-right me-1"></i>CWS
            {% if cw.new_date %}&rarr; {{ cw.new_date }}{% endif %}
            {% if cw.new_time %}{{ cw.new_time }}{% endif %}
            <span style="opacity:.7;">({{ cw.status }})</span>
          </span>
        {% endfor %}
        {% if not emp_leaves and not emp_cws %}
          <span class="text-muted" style="font-size:.8rem;">—</span>
        {% endif %}
      </div>
    </td>
  </tr>
{% endfor %}
</tbody></table></div></div>

{% endif %}
{% endblock %}

{% block scripts %}
<script>
function copyTable() {
  // Collect all rows across all tables into tab-separated text
  const date = '{{ target_date }}';
  const headers = ['Employee', 'Employee ID', 'Group', 'Team Lead', 'Shift', 'Date', 'Remarks'];
  const rows = [headers.join('\t')];

  document.querySelectorAll('.absence-table').forEach(table => {
    // Get group name from the card header above this table
    const cardHeader = table.closest('.card').querySelector('.card-header .fw-semibold');
    const group = cardHeader ? cardHeader.textContent.trim() : '';

    table.querySelectorAll('tbody tr').forEach(tr => {
      const cells = tr.querySelectorAll('td');
      if (cells.length < 6) return;
      const employee  = cells[0].textContent.trim();
      const empId     = cells[1].textContent.trim();
      const tl        = cells[2].textContent.trim();
      const shift     = cells[3].textContent.trim();
      // Remarks: collect badge texts
      const remarkBadges = [...cells[5].querySelectorAll('.badge')]
                             .map(b => b.textContent.replace(/\s+/g, ' ').trim())
                             .join('; ');
      const remarks = remarkBadges || '—';
      rows.push([employee, empId, group, tl, shift, date, remarks].join('\t'));
    });
  });

  const text = rows.join('\n');
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('copyTableBtn');
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Copied!';
    btn.classList.replace('btn-outline-secondary', 'btn-success');
    setTimeout(() => {
      btn.innerHTML = orig;
      btn.classList.replace('btn-success', 'btn-outline-secondary');
    }, 2000);
  }).catch(() => {
    alert('Copy failed — please use Ctrl+A on the table manually.');
  });
}
</script>
{% endblock %}
