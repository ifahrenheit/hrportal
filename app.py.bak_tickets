@app.route('/file-requests/material/final-action', methods=['POST'])
@login_required
def material_final_action():
    if not (session['user']['email'].lower() == MATERIAL_FINAL_EMAIL.lower() or session.get('is_admin') or session.get('permissions', {}).get('can_final_approval')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))

    req_id  = int(request.form.get('req_id'))
    action  = request.form.get('action')
    remarks = request.form.get('remarks', '').strip()

    new_status = 'Approved' if action == 'approve' else 'Rejected'

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("""UPDATE material_requests
                         SET status=%s, final_approver_name=%s,
                             final_action_at=NOW(), final_remarks=%s
                         WHERE id=%s""",
                      (new_status, session['user']['name'], remarks, req_id))
            if new_status == 'Approved':
                c.execute('SELECT * FROM material_requests WHERE id=%s', (req_id,))
                req = c.fetchone()
        cdb.commit()

        if new_status == 'Approved':
            # Notify all material admins to release
            for admin_email in get_material_admin_emails():
              send_material_email(
                admin_email,
                f'[Material Request] Approved — Ready to Release — {req["employee_name"]}',
                f"""<p>The following material request has been <b>approved</b> by {session['user']['name']} and is ready for release:</p>
                <ul>
                  <li><b>Employee:</b> {req['employee_name']} ({req['employee_id']})</li>
                  <li><b>Category:</b> {req['category']}</li>
                  <li><b>Item:</b> {req['item_name']} (x{req['quantity']})</li>
                  <li><b>Admin Remark:</b> {req['admin_remarks']}</li>
                  <li><b>Final Remarks:</b> {remarks or '—'}</li>
                </ul>
                <p>Please <a href='https://hrportal.cohere.ph/file-requests/material/admin-review'>log in to release</a> the item to the employee.</p>"""
            )
    finally:
        cdb.close()

    flash(f'Request {new_status.lower()} successfully.', 'success')
    return redirect(url_for('material_final_approval'))


@app.route('/file-requests/material/release', methods=['POST'])
@login_required
def material_release_action():
    if not (session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))

    req_id        = int(request.form.get('req_id'))
    import secrets
    token         = secrets.token_urlsafe(32)
    release_notes = request.form.get('release_notes', '').strip() or None

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("""UPDATE material_requests
                         SET status='Awaiting Confirmation', released_by=%s,
                             released_at=NOW(), release_notes=%s,
                             confirmation_token=%s
                         WHERE id=%s AND status='Approved'""",
                      (session['user']['name'], release_notes, token, req_id))
            c.execute('SELECT * FROM material_requests WHERE id=%s', (req_id,))
            req = c.fetchone()
        cdb.commit()

        if req:
            # Get employee email from central_db
            with cdb.cursor() as c:
                c.execute('SELECT email FROM gsheet_employees WHERE employee_id=%s', (req['employee_id'],))
                row = c.fetchone()
                emp_email = row['email'] if row else None

            if emp_email:
                confirm_url = f'https://hrportal.cohere.ph/file-requests/material/confirm/{req["confirmation_token"]}'
                send_material_email(
                    emp_email,
                    f'[Material Request] Please Confirm Receipt of Your Item',
                    f"""<p>Hi <b>{req['employee_name']}</b>,</p>
                    <p>Your material request has been <b>released</b> and is ready for pick-up:</p>
                    <ul>
                      <li><b>Category:</b> {req['category']}</li>
                      <li><b>Item:</b> {req['item_name']} (x{req['quantity']})</li>
                      <li><b>Released by:</b> {session['user']['name']}</li>
                      {'<li><b>Notes:</b> ' + release_notes + '</li>' if release_notes else ''}
                    </ul>
                    <p>Once you have received the item, please confirm receipt by clicking the button below:</p>
                    <p style='text-align:center;margin:24px 0;'>
                      <a href='{confirm_url}'
                         style='background:#065f46;color:#fff;padding:12px 28px;border-radius:6px;text-decoration:none;font-weight:bold;'>
                        Confirm Receipt
                      </a>
                    </p>
                    <p style='color:#888;font-size:12px;'>Or copy this link: {confirm_url}</p>
                    <p>If you did not request this item, please ignore this email.</p>"""
                )
    finally:
        cdb.close()

    flash('Item released. Employee has been notified to confirm receipt.', 'success')
    return redirect(url_for('material_admin_review'))


@app.route('/file-requests/material/confirm/<token>')
def material_confirm_receipt(token):
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("""SELECT * FROM material_requests
                          WHERE confirmation_token=%s AND status='Awaiting Confirmation'""", (token,))
            req = c.fetchone()
        if not req:
            return render_template('error.html', message='This confirmation link is invalid or has already been used.'), 404
        with cdb.cursor() as c:
            c.execute("""UPDATE material_requests
                          SET status='Served', confirmed_at=NOW()
                          WHERE id=%s""", (req['id'],))
        cdb.commit()
    finally:
        cdb.close()
    return render_template('file_requests/material_confirm.html', req=req)

@app.route('/api/material-final-pending-count')
@login_required
def material_final_pending_count():
    if not (session['user']['email'].lower() == MATERIAL_FINAL_EMAIL.lower() or session.get('is_admin') or session.get('permissions', {}).get('can_final_approval')):
        return jsonify({'count': 0})
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("SELECT COUNT(*) as cnt FROM material_requests WHERE status='Pending Final Approval' AND deleted_at IS NULL")
            count = c.fetchone()['cnt']
    finally:
        cdb.close()
    return jsonify({'count': count})


