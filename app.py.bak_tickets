            """SELECT original_date, original_time, new_date, new_time,
                      reason, status, approver_name, approved_at, created_at
               FROM cws_requests
               WHERE employee_id = %s
               AND deleted_at IS NULL
               ORDER BY created_at DESC
               LIMIT 30""",
            (employee_id,)
        )
        history = cursor.fetchall()
        cursor.close()

    return render_template('file_requests/cws.html',
                           message=message, msg_type=msg_type,
                           history=history)


