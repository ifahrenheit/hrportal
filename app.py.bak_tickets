@app.route('/file-requests/facilities/review-action', methods=['POST'])
@login_required
def facilities_review_action():
    if not (session.get('is_admin') or session.get('permissions', {}).get('can_facilities_review')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))
    req_id   = int(request.form.get('req_id'))
    remarks  = request.form.get('reviewer_remarks', '').strip()
    priority = request.form.get('priority', '').strip()
    action   = request.form.get('action')

    import json
    # Items table
    descs   = request.form.getlist('item_desc[]')
    qtys    = request.form.getlist('item_qty[]')
    remarks_list = request.form.getlist('item_remarks[]')
    items = [
        {"description": d.strip(), "quantity": q.strip(), "remarks": rm.strip()}
        for d, q, rm in zip(descs, qtys, remarks_list)
        if d.strip()
    ]
    items_json = json.dumps(items) if items else None

    # Attachment
    attachment_path = None
    file = request.files.get('attachment')
    if file and file.filename:
        import os
        from werkzeug.utils import secure_filename
        upload_dir = os.path.join(app.root_path, 'static', 'uploads', 'facilities')
        os.makedirs(upload_dir, exist_ok=True)
        filename = f"FAC-{req_id}-{secure_filename(file.filename)}"
        file.save(os.path.join(upload_dir, filename))
        attachment_path = filename

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            if action == 'reject':
                c.execute("""UPDATE facilities_requests
                             SET status='Rejected', reviewer_name=%s,
                                 reviewer_remarks=%s, reviewed_at=NOW()
                             WHERE id=%s""",
                          (session['user']['name'], remarks, req_id))
                flash('Request rejected.', 'success')
            else:
                c.execute("""UPDATE facilities_requests
                             SET status='Pending Final Approval', reviewer_name=%s,
                                 reviewer_remarks=%s, priority=%s, reviewed_at=NOW(),
                                 items_json=%s, attachment=%s
                             WHERE id=%s""",
                          (session['user']['name'], remarks, priority,
                           items_json, attachment_path, req_id))
                flash('Request sent to final approver.', 'success')
                # Notify final approvers
                cdb.cursor().execute("SELECT * FROM facilities_requests WHERE id=%s", (req_id,))
                _r = cdb.cursor()
                _r.execute("SELECT * FROM facilities_requests WHERE id=%s", (req_id,))
                fac_r = _r.fetchone()
                for email in get_facilities_final_emails():
                    send_facilities_email(
                        email,
                        f'[Facilities] Approval Needed — {fac_r["employee_name"] if fac_r else ""}',
                        f"""<p>A facilities request requires your final approval.</p>
                        <ul>
                          <li><b>Employee:</b> {fac_r["employee_name"] if fac_r else ""}</li>
                          <li><b>Department/Location:</b> {fac_r["department_location"] if fac_r else ""}</li>
                          <li><b>Priority:</b> {priority}</li>
                          <li><b>Reviewer Remarks:</b> {remarks}</li>
                        </ul>
                        <p><a href="https://hrportal.cohere.ph/file-requests/facilities/final-approval">Approve here</a></p>"""
                    )
            cdb.commit()
    finally:
        cdb.close()
    return redirect(url_for('facilities_review'))


