    work_permit     = request.form.get('work_permit_no', '').strip() or None
    pull_out_item   = request.form.get('pull_out_item', '').strip() or None
    pull_out_loc    = request.form.get('pull_out_location', '').strip() or None
    pull_out_date   = request.form.get('pull_out_date', '').strip() or None
    pull_out_by     = request.form.get('pull_out_by', '').strip() or None
    pull_out_sga    = request.form.get('pull_out_sga', '').strip() or None
    returned_date   = request.form.get('returned_date', '').strip() or None
    returned_by     = request.form.get('returned_by', '').strip() or None
    returned_sga    = request.form.get('returned_sga', '').strip() or None
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("""UPDATE facilities_requests
                         SET status='Work In Progress', work_performed=%s,
                             work_permit_no=%s,
                             pull_out_item=%s, pull_out_location=%s, pull_out_date=%s,
                             pull_out_by=%s, pull_out_sga=%s,
                             returned_date=%s, returned_by=%s, returned_sga=%s,
                             work_details_at=NOW()
                         WHERE id=%s""",
                      (work_performed, work_permit,
                       pull_out_item, pull_out_loc, pull_out_date,
                       pull_out_by, pull_out_sga,
                       returned_date, returned_by, returned_sga,
                       req_id))
            cdb.commit()
        flash('Work details saved.', 'success')
    finally:
        cdb.close()
    return redirect(url_for('facilities_review'))


# ── FACILITIES PDF ────────────────────────────────────────────────────────────
@app.route('/file-requests/facilities/<int:req_id>/pdf')
@login_required
def facilities_pdf(req_id):
    from flask import send_file
    from reportlab.lib.pagesizes import A4
    from reportlab.lib import colors
    from reportlab.lib.units import mm
    from reportlab.platypus import Table, TableStyle, Paragraph
    from reportlab.lib.styles import ParagraphStyle
    from reportlab.lib.enums import TA_CENTER, TA_LEFT
    from reportlab.pdfgen import canvas as rl_canvas
    import io

    if not (session.get('is_admin') or
            session.get('permissions', {}).get('can_facilities_review') or
            session.get('permissions', {}).get('can_facilities_final')):
        abort(403)

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("SELECT * FROM facilities_requests WHERE id=%s AND deleted_at IS NULL", (req_id,))
            r = c.fetchone()
    finally:
        cdb.close()

    if not r:
        abort(404)

    buf = io.BytesIO()
    c = rl_canvas.Canvas(buf, pagesize=A4)
    W, H = A4
    M = 18 * mm

    # Header box
    c.setLineWidth(2)
    c.rect(M - 4, H - 38*mm, W - 2*M + 8, 30*mm)
    LOGO = "/var/www/html/leavesystem/static/img/cohere-logo-mrf.jpg"
    LOGO_W = 52*mm
    LOGO_X = W - M - LOGO_W - 2*mm
    LOGO_Y = H - 38*mm + (30*mm - 26*mm) / 2
    try:
        c.drawImage(LOGO, LOGO_X, LOGO_Y, width=LOGO_W, height=26*mm, preserveAspectRatio=True)
    except Exception:
        pass
    c.setFont("Helvetica-Bold", 13)
    c.drawString(M + 2*mm, H - 15*mm, "COHERE OUTSOURCING PHILS. INC")
    c.setFont("Helvetica-Bold", 10)
    c.drawString(M + 2*mm, H - 22*mm, "Facilities Maintenance and Repair Form")

    y = H - 45*mm

    # Date of Request + Form #
    c.setFont("Helvetica", 9)
    c.drawString(M, y, "Date of Request:")
    c.line(M + 32*mm, y - 1.5, M + 70*mm, y - 1.5)
    date_str = r['created_at'].strftime('%B %d, %Y') if r.get('created_at') else ''
    c.drawString(M + 33*mm, y, date_str)
    c.drawString(W/2 + 10*mm, y, "Form #:")
    c.line(W/2 + 24*mm, y - 1.5, W - M, y - 1.5)
    c.drawString(W/2 + 25*mm, y, f"FAC-{req_id:04d}")

    y -= 10*mm

    def section(title):
        nonlocal y
        c.setFont("Helvetica-Bold", 10)
        c.drawString(M, y, title)
        y -= 6*mm

    def field_line(label, value, indent=4):
        nonlocal y
        c.setFont("Helvetica", 9)
        c.drawString(M + indent*mm, y, f"• {label}")
        lw = c.stringWidth(f"• {label}", "Helvetica", 9)
        c.line(M + indent*mm + lw + 2, y - 1.5, W - M, y - 1.5)
        c.drawString(M + indent*mm + lw + 4, y, value or '')
        y -= 7*mm

    def text_block(label, value, indent=4):
        nonlocal y
        c.setFont("Helvetica", 9)
        c.drawString(M + indent*mm, y, f"• {label}")
        y -= 6*mm
        # wrap value
        words = (value or '').split()
        lines, cur = [], ""
        for word in words:
            test = (cur + " " + word).strip()
            if c.stringWidth(test, "Helvetica", 9) <= (W - 2*M - 8*mm):
                cur = test
            else:
                lines.append(cur); cur = word
        if cur: lines.append(cur)
        if not lines: lines = [""]
        for ln in lines[:3]:
            c.drawString(M + indent*mm + 3, y, ln)
            c.line(M + indent*mm, y - 1.5, W - M, y - 1.5)
            y -= 7*mm

    # 1. Requester Info
    section("1. Requester Information")
    field_line("Name:", r.get('employee_name', ''))
    field_line("Department/Location:", r.get('department_location', ''))

    y -= 2*mm
    # 2. Last Maintenance
    section("2. Date of Last Maintenance")
    field_line("(if known):", r.get('last_maintenance', ''))

    y -= 2*mm
    # 3. Issue Description
    section("3. Issue Description")
    text_block("Nature of the Issue (please describe in detail):", r.get('issue_description', ''))

    y -= 2*mm
    # 4. Reviewer Remarks
    section("4. Remarks from Supplier (checkup)")
    text_block("", r.get('reviewer_remarks', '') or '')

    # Priority checkboxes
    BOX = 3.5*mm
    priority = r.get('priority') or ''
    c.setFont("Helvetica", 9)
    c.drawString(M + 4*mm, y, "• Requested Priority")
    y -= 6*mm
    for label, checked in [("Urgent", priority == 'Urgent'), ("Not Urgent", priority == 'Not Urgent')]:
        c.rect(M + 8*mm, y - 1, BOX, BOX)
        if checked:
            c.setLineWidth(1.2)
            c.line(M + 8*mm + 0.5, y + BOX/2, M + 8*mm + BOX*0.4, y - 0.5)
            c.line(M + 8*mm + BOX*0.4, y - 0.5, M + 8*mm + BOX + 0.5, y + BOX)
            c.setLineWidth(0.5)
        c.setFont("Helvetica", 9)
        c.drawString(M + 8*mm + BOX + 2, y, label)
        y -= 6*mm

    y -= 2*mm
    # Reviewed by / Approved by
    c.setFont("Helvetica", 9)
    c.drawString(M, y, "Reviewed by:")
    c.line(M + 26*mm, y - 1.5, M + 80*mm, y - 1.5)
    c.drawString(M + 27*mm, y, r.get('reviewer_name', '') or '')
    c.drawString(W/2 + 10*mm, y, "Approved by:")
    c.line(W/2 + 26*mm, y - 1.5, W - M, y - 1.5)
    c.drawString(W/2 + 27*mm, y, r.get('final_approver_name', '') or '')
    y -= 10*mm

    # 5. Work Details
    section("5. Maintenance or Repair Work Details")
    c.setFont("Helvetica", 8)
    c.drawString(M + 4*mm, y, "(To be filled out by the technician/maintenance team)")
    y -= 6*mm
    text_block("Work Performed:", r.get('work_performed', '') or '')

    # Work Permit + Pull Out Details box
    c.setFont('Helvetica', 9)
    c.drawString(W/2 + 10*mm, y + 14*mm, 'Work Permit #:')
    c.line(W/2 + 32*mm, y + 14*mm - 1.5, W - M, y + 14*mm - 1.5)
    c.drawString(W/2 + 33*mm, y + 14*mm, r.get('work_permit_no', '') or '')
    # Pull Out Details box
    box_x = M
    box_y = y - 4*mm
    box_w = W - 2*M
    c.setLineWidth(0.8)
    c.rect(box_x, box_y - 52*mm, box_w, 52*mm)
    c.setFont('Helvetica-Bold', 9)
    c.drawString(box_x + 2*mm, box_y - 5*mm, 'PULL OUT DETAILS')
    c.setFont('Helvetica', 8.5)
    pull_fields = [
        ('Item:',     r.get('pull_out_item', '') or ''),
        ('Location:', r.get('pull_out_location', '') or ''),
        ('Date:',     r.get('pull_out_date', '') or ''),
        ('By:',       r.get('pull_out_by', '') or ''),
        ('SGA:',      r.get('pull_out_sga', '') or ''),
    ]
    fy = box_y - 11*mm
    for lbl, val in pull_fields:
        c.drawString(box_x + 2*mm, fy, lbl)
        lw2 = c.stringWidth(lbl, 'Helvetica', 8.5)
        c.line(box_x + 2*mm + lw2 + 1, fy - 1, box_x + box_w - 2*mm, fy - 1)
        c.drawString(box_x + 2*mm + lw2 + 2, fy, val)
        fy -= 6*mm
    c.setFont('Helvetica-Bold', 9)
    c.drawString(box_x + 2*mm, fy, 'Returned/Replaced')
    fy -= 6*mm
    c.setFont('Helvetica', 8.5)
    for lbl, val in [('Date:', r.get('returned_date','') or ''), ('By:', r.get('returned_by','') or ''), ('SGA:', r.get('returned_sga','') or '')]:
        c.drawString(box_x + 2*mm, fy, lbl)
        lw2 = c.stringWidth(lbl, 'Helvetica', 8.5)
        c.line(box_x + 2*mm + lw2 + 1, fy - 1, box_x + box_w - 2*mm, fy - 1)
        c.drawString(box_x + 2*mm + lw2 + 2, fy, val)
        fy -= 6*mm
    y -= 58*mm

    # 6. Completion (manual)
    section("6. Completion")
    c.setFont("Helvetica", 9)
    c.drawString(M + 4*mm, y, "• Final Sign-Off by SGA Team:")
    y -= 6*mm
    for lbl in ["Name:", "Signature:", "Number of Days to Complete:", "Date Work Completed:"]:
        field_line(lbl, '')

    c.save()
    buf.seek(0)
    filename = f"FAC-{req_id:04d}_{r['created_at'].strftime('%Y%m%d')}.pdf"
    return send_file(buf, mimetype='application/pdf',
                     as_attachment=True, download_name=filename)
# ── END FACILITIES ROUTES ─────────────────────────────────────────────────────

import json as _json

@app.template_filter('fromjson')
def fromjson_filter(s):
    try:
        return _json.loads(s) if s else []
    except Exception:
        return []


def get_facilities_reviewer_emails():
    """Get emails of users with can_facilities_review permission."""
    emails = set()
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("""
                SELECT u.user_name FROM leave4day_sub_admins sa
                JOIN ohrm_user u ON u.emp_number = sa.emp_number
                WHERE sa.can_facilities_review = 1 AND u.deleted = 0
            """)
            for row in c.fetchall():
                if row['user_name']:
                    emails.add(row['user_name'].lower())
    finally:
        db.close()
    return list(emails)

def get_facilities_final_emails():
    """Get emails of users with can_facilities_final permission."""
    emails = set()
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("""
                SELECT u.user_name FROM leave4day_sub_admins sa
                JOIN ohrm_user u ON u.emp_number = sa.emp_number
                WHERE sa.can_facilities_final = 1 AND u.deleted = 0
            """)
            for row in c.fetchall():
                if row['user_name']:
                    emails.add(row['user_name'].lower())
    finally:
        db.close()
    return list(emails)

def send_facilities_email(to, subject, body_html):
    """Send email for facilities request notifications."""
    try:
        from email.mime.multipart import MIMEMultipart
        from email.mime.text import MIMEText
        msg = MIMEMultipart('alternative')
        msg['Subject'] = subject
        msg['From']    = f"Cohere HR Portal — Facilities <{os.getenv('SMTP_USER')}>"
        msg['To']      = to
        msg.attach(MIMEText(body_html, 'html'))
        with smtplib.SMTP(os.getenv('SMTP_SERVER'), int(os.getenv('SMTP_PORT', 2525))) as s:
            s.login(os.getenv('SMTP_USER'), os.getenv('SMTP_PASSWORD'))
            s.sendmail(os.getenv('SMTP_USER'), [to], msg.as_string())
    except Exception as e:
        app.logger.warning(f'facilities email failed: {e}')

# ── FACILITIES & REPAIR REQUEST ───────────────────────────────────────────────
@app.route('/file-requests/facilities', methods=['GET', 'POST'])
@login_required
def facilities_request():
    if request.method == 'POST':
        dept     = request.form.get('department_location', '').strip()
        last_mnt = request.form.get('last_maintenance', '').strip()
        issue    = request.form.get('issue_description', '').strip()
        if not all([dept, last_mnt, issue]):
            flash('All fields are required.', 'danger')
            return render_template('file_requests/facilities.html', user=session['user'])
        cdb = get_central_db()
        try:
            with cdb.cursor() as c:
                c.execute("""
                    INSERT INTO facilities_requests
                        (employee_id, employee_name, department_location,
                         last_maintenance, issue_description, status)
                    VALUES (%s, %s, %s, %s, %s, 'Pending')
                """, (
                    session['user'].get('employee_id', ''),
                    session['user']['name'],
                    dept, last_mnt, issue
                ))
                cdb.commit()
        finally:
            cdb.close()
        # Notify reviewers
        for email in get_facilities_reviewer_emails():
            send_facilities_email(
                email,
                f'[Facilities] New Request — {session["user"]["name"]}',
                f"""<p>A new facilities/repair request has been submitted.</p>
                <ul>
                  <li><b>Employee:</b> {session['user']['name']}</li>
                  <li><b>Department/Location:</b> {dept}</li>
                  <li><b>Issue:</b> {issue}</li>
                </ul>
                <p><a href="https://hrportal.cohere.ph/file-requests/facilities/review">Review here</a></p>"""
            )
        flash('Facilities request submitted successfully.', 'success')
        return redirect(url_for('dashboard'))
    return render_template('file_requests/facilities.html', user=session['user'])
# ── END FACILITIES REQUEST ─────────────────────────────────────────────────────

@app.route('/file-requests/material/admin-review')
@login_required
def material_admin_review():
    if not (session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("SELECT * FROM material_requests WHERE deleted_at IS NULL ORDER BY FIELD(status,'Recommended','Pending Final Approval','Pending','Approved','Released','Rejected'), created_at DESC")
            requests_ = c.fetchall()
            c.execute("SELECT * FROM material_request_logs ORDER BY created_at DESC")
            all_logs = c.fetchall()
    finally:
        cdb.close()
    # Group logs by request_group_id
    from collections import defaultdict
    logs_by_group = defaultdict(list)
    for log in all_logs:
        logs_by_group[log['request_group_id']].append(log)
    return render_template('file_requests/material_admin.html', requests=requests_, logs_by_group=logs_by_group, user=session['user'])

