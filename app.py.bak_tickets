# ── API: Employee search ───────────────────────────────────

@app.route('/hrportal/api/search-employee')
@permission_required('can_onboarding')
def hrportal_search_employee():
    q = request.args.get('q', '').strip()
    if len(q) < 2:
        return jsonify([])
    try:
        conn = get_db_connection()
        with conn.cursor() as cur:
            cur.execute("""
                SELECT employee_id, schedule_name, email, status, account, tl
                FROM gsheet_employees
                WHERE (employee_id LIKE %s OR schedule_name LIKE %s OR email LIKE %s)
                  AND status != 'Separated'
                LIMIT 10
            """, [f'%{q}%', f'%{q}%', f'%{q}%'])
            results = cur.fetchall()
        conn.close()
        return jsonify(results)
    except Exception as e:
        app.logger.error(f'Employee search error: {e}')
        return jsonify({'error': str(e)}), 500


# ── API: Recent offboardings ───────────────────────────────

@app.route('/hrportal/api/recent-offboardings')
@permission_required('can_onboarding')
def hrportal_recent_offboardings():
    try:
        conn = get_db_connection()
        with conn.cursor() as cur:
            cur.execute("""
                SELECT eo.*, ge.schedule_name AS employee_name
                FROM employee_offboarding eo
                LEFT JOIN gsheet_employees ge ON ge.employee_id = eo.employee_id
                ORDER BY eo.processed_at DESC
                LIMIT 20
            """)
            rows = cur.fetchall()
        conn.close()
        for r in rows:
            if r.get('exit_date'):    r['exit_date']    = str(r['exit_date'])
            if r.get('processed_at'): r['processed_at'] = str(r['processed_at'])
        return jsonify(rows)
    except Exception as e:
        app.logger.error(f'Recent offboardings error: {e}')
        return jsonify({'error': str(e)}), 500


# ── API: Onboard (Create Employee) ────────────────────────

@app.route('/hrportal/api/onboard', methods=['POST'])
@permission_required('can_onboarding')
def hrportal_onboard():
    """Create new employee across all systems"""
    try:
        import bcrypt
        import requests as ext_requests

        data          = request.get_json()
        employee_id   = data.get('employee_id', '').strip()
        schedule_name = data.get('schedule_name', '').strip()
        email         = data.get('email', '').strip()

        if not all([employee_id, schedule_name, email]):
            return jsonify({'error': 'employee_id, schedule_name, and email are required'}), 400

        first_name    = data.get('first_name', '').strip()
        last_name     = data.get('last_name', '').strip()
        schedule_name = data.get('schedule_name', '').strip()

        temp_password = os.environ.get('DEFAULT_PASSWORD', '***REMOVED***')
        processed_by  = session.get('user', {}).get('name', 'System')
        cpanel_domain = os.environ.get('CPANEL_DOMAIN', 'cohere.ph')

        training_date    = data.get('training_date') or datetime.now().strftime('%Y-%m-%d')
        operational_date = data.get('operational_date')
        if operational_date:
            expected_completion = operational_date
        else:
            training_dt         = datetime.strptime(training_date, '%Y-%m-%d')
            expected_completion = (training_dt + timedelta(weeks=3)).strftime('%Y-%m-%d')

        ad = get_ad_config()

        # ── central_db — gsheet_employees, Employees, onboarding ──
        conn = get_db_connection()

        with conn.cursor() as cur:
            cur.execute(
                "SELECT employee_id FROM gsheet_employees WHERE employee_id = %s",
                [employee_id]
            )
            if cur.fetchone():
                conn.close()
                return jsonify({'error': 'Employee ID already exists in dashboard'}), 400

        # ── orangehrm2 — hs_hr_employee, ohrm_user ────────────────
        ohrm = get_db()

        with ohrm.cursor() as ocur:
            ocur.execute(
                "SELECT emp_number FROM hs_hr_employee WHERE employee_id = %s",
                [employee_id]
            )
            if ocur.fetchone():
                ohrm.close()
                conn.close()
                return jsonify({'error': 'Employee ID already exists in OrangeHRM'}), 400

        results = {
            'keycloak_created':          False,
            'ad_created':                False,
            'ad_username':               None,
            'orangehrm_created':         False,
            'email_created':             False,
            'dashboard_account_created': False,
            'dashboard_created':         False,
            'biometric_queued':          False,
            'onboarding_created':        False,
            'emp_number':                None,
        }

        # 1. KEYCLOAK ──────────────────────────────────────
        try:
            kc = get_keycloak_admin()
            kc.create_user({
                "username":      email,
                "email":         email,
                "firstName":     first_name,
                "lastName":      last_name,
                "enabled":       True,
                "emailVerified": True,
                "credentials":   [{"type": "password", "value": temp_password, "temporary": True}]
            })
            results['keycloak_created'] = True
            app.logger.info(f'✅ Keycloak user created: {email}')
        except Exception as e:
            app.logger.error(f'❌ Keycloak error: {e}')

        # 2. ACTIVE DIRECTORY ──────────────────────────────
        try:
            first_name_parts   = first_name.split()
            primary_username   = (first_name_parts[0] + last_name).lower().replace(' ', '')
            secondary_username = (first_name_parts[1] + last_name).lower().replace(' ', '') if len(first_name_parts) > 1 else None

            # Check primary username
            check = ext_requests.post(
                f"{ad['base_url']}/api/user/check",
                json={'username': primary_username},
                headers=ad['headers'], timeout=30
            )

            if check.status_code == 200 and check.json().get('exists'):
                if secondary_username:
                    # Try second first name + last name
                    check2 = ext_requests.post(
                        f"{ad['base_url']}/api/user/check",
                        json={'username': secondary_username},
                        headers=ad['headers'], timeout=30
                    )
                    if check2.status_code == 200 and not check2.json().get('exists'):
                        ad_username = secondary_username
                    else:
                        # Both taken — auto-increment from primary
                        ad_username = primary_username
                        counter = 2
                        while counter < 100:
                            test = f'{primary_username}{counter}'
                            c = ext_requests.post(
                                f"{ad['base_url']}/api/user/check",
                                json={'username': test},
                                headers=ad['headers'], timeout=30
                            )
                            if c.status_code == 200 and not c.json().get('exists'):
                                ad_username = test
                                break
                            counter += 1
                else:
                    # No second first name — auto-increment
                    ad_username = primary_username
                    counter = 2
                    while counter < 100:
                        test = f'{primary_username}{counter}'
                        c = ext_requests.post(
                            f"{ad['base_url']}/api/user/check",
                            json={'username': test},
                            headers=ad['headers'], timeout=30
                        )
                        if c.status_code == 200 and not c.json().get('exists'):
                            ad_username = test
                            break
                        counter += 1
            else:
                ad_username = primary_username

            ad_resp = ext_requests.post(
                f"{ad['base_url']}/api/user/create",
                headers=ad['headers'],
                json={
                    'username':   ad_username,
                    'first_name': first_name,
                    'last_name':  last_name,
                    'email':      email,
                    'password':   temp_password,
                    'target':     data.get('ad_target', 'COHERE')  # NUMA | COHERE | BOTH
                },
                timeout=30
            )
            if ad_resp.status_code == 200:
                results['ad_created']  = True
                results['ad_username'] = ad_username
                app.logger.info(f'✅ AD account created: {ad_username}')
            else:
                app.logger.error(f'❌ AD creation failed: {ad_resp.text}')
        except Exception as e:
            app.logger.error(f'❌ AD error: {e}')

        # 3. ORANGEHRM — employee + user record ───────────
        try:
            with ohrm.cursor() as ocur:
                ocur.execute("""
                    INSERT INTO hs_hr_employee
                    (employee_id, emp_firstname, emp_lastname, emp_middle_name,
                     emp_work_email, joined_date, emp_birthday)
                    VALUES (%s, %s, %s, '', %s, %s, %s)
                """, [employee_id, first_name, last_name, email,
                      training_date, data.get('birthdate')])
                emp_number            = ocur.lastrowid
                results['emp_number'] = emp_number

                ocur.execute("""
                    INSERT INTO ohrm_user
                    (user_role_id, emp_number, user_name, status, date_entered, date_modified)
                    VALUES (2, %s, %s, 1, NOW(), NOW())
                """, [emp_number, email])
            ohrm.commit()
            results['orangehrm_created'] = True
            app.logger.info(f'✅ OrangeHRM employee created: {employee_id} (emp#{emp_number})')
        except Exception as e:
            app.logger.error(f'❌ OrangeHRM error: {e}')
            ohrm.rollback()

        # 4. DASHBOARD EMPLOYEE RECORD (central_db) ───────
        try:
            with conn.cursor() as cur:
                cur.execute("""
                    INSERT INTO gsheet_employees
                    (employee_id, schedule_name, email, training_date, status,
                     account, tl, group_name, batch, birthdate, created_at)
                    VALUES (%s, %s, %s, %s, 'Training', %s, %s, %s, %s, %s, NOW())
                """, [
                    employee_id, schedule_name, email, training_date,
                    data.get('account'), data.get('tl'),
                    data.get('group_name'), data.get('batch'), data.get('birthdate')
                ])
            conn.commit()
            results['dashboard_created'] = True
            app.logger.info(f'✅ Dashboard employee record created: {employee_id}')
        except Exception as e:
            app.logger.error(f'❌ Dashboard record error: {e}')

        # 5. EMAIL ACCOUNT (cPanel) ────────────────────────
        try:
            er = ext_requests.get(
                get_cpanel_url(),
                params={
                    'cpanel_jsonapi_user':   os.environ.get('CPANEL_USERNAME', 'cohere'),
                    'cpanel_jsonapi_module': 'Email',
                    'cpanel_jsonapi_func':   'addpop',
                    'email':                 email.split('@')[0],
                    'domain':                cpanel_domain,
                    'password':              temp_password,
                    'quota':                 512
                },
                headers={'Authorization': get_cpanel_auth()},
                verify=False, timeout=10
            )
            if er.json().get('cpanelresult', {}).get('data', [{}])[0].get('result') == 1:
                results['email_created'] = True
                app.logger.info(f'✅ Email account created: {email}')
            else:
                app.logger.error(f'❌ Email creation failed: {er.text}')
        except Exception as e:
            app.logger.error(f'❌ Email error: {e}')

        # 6. DASHBOARD LOGIN ACCOUNT (central_db.Employees) ──
        try:
            hashed_pw = bcrypt.hashpw(temp_password.encode(), bcrypt.gensalt()).decode()
            with conn.cursor() as cur:
                cur.execute(
                    "SELECT EmployeeID FROM Employees WHERE Email = %s", [email]
                )
                if not cur.fetchone():
                    cur.execute("""
                        INSERT INTO Employees
                        (EmployeeID, FirstName, LastName, Email, Password, role, IsVerified, SOM)
                        VALUES (%s, %s, %s, %s, %s, 'Employee', 1, 'SOM')
                    """, [employee_id, first_name, last_name, email, hashed_pw])
            conn.commit()
            results['dashboard_account_created'] = True
            app.logger.info(f'✅ Dashboard login account created: {email}')
        except Exception as e:
            app.logger.error(f'❌ Dashboard account error: {e}')

        # 7. BIOMETRIC QUEUE (central_db) ─────────────────
        try:
            personid = int(employee_id.replace('-', ''))
            uname    = (first_name[0] + last_name).lower().replace(' ', '')
            with conn.cursor() as cur:
                cur.execute("""
                    INSERT INTO pending_biometric_sync
                    (employee_id, companyid, personid, username, fname, lname, gid, role, status)
                    VALUES (%s, %s, %s, %s, %s, %s, %s, %s, 'pending')
                """, [employee_id, employee_id, personid, uname, first_name, last_name, 21238082, 'Employee'])
            conn.commit()
            results['biometric_queued'] = True
            app.logger.info(f'✅ Biometric sync queued: {employee_id}')
        except Exception as e:
            app.logger.error(f'❌ Biometric queue error: {e}')

        # 8. ONBOARDING RECORD + TASKS (central_db) ───────
        try:
            start_date = datetime.strptime(training_date, '%Y-%m-%d').date()
            with conn.cursor() as cur:
                cur.execute("""
                    INSERT INTO employee_onboarding
                    (employee_id, onboarding_status, start_date, expected_completion_date, training_weeks)
                    VALUES (%s, 'In Progress', %s, %s, 3)
                """, [employee_id, start_date, expected_completion])

                tasks = [
                    ('Keycloak Account Created',  'User created in Keycloak SSO',            True, 'Completed' if results['keycloak_created'] else 'Pending'),
                    ('OrangeHRM Account Created', 'Employee record created in HRIS',          True, 'Completed' if results['orangehrm_created'] else 'Pending'),
                    ('Email Created',             'Email account created in cPanel',          True, 'Completed' if results['email_created'] else 'Pending'),
                    ('Dashboard Access Granted',  'Dashboard login account created',          True, 'Completed' if results['dashboard_account_created'] else 'Pending'),
                    ('AD Account Created',        'Active Directory account created',         True, 'Completed' if results['ad_created'] else 'Pending'),
                    ('Biometrics Registered',     'Register fingerprint in biometric system', True, 'Pending'),
                    ('Slack Account Created',     'Create Slack workspace account',           True, 'Pending'),
                ]

                for task_name, task_desc, is_req, status in tasks:
                    if status == 'Completed':
                        cur.execute("""
                            INSERT INTO onboarding_tasks
                            (employee_id, task_category, task_name, task_description,
                             is_required, status, completed_by, completed_date)
                            VALUES (%s, 'IT', %s, %s, %s, %s, %s, NOW())
                        """, [employee_id, task_name, task_desc, is_req, status, processed_by])
                    else:
                        cur.execute("""
                            INSERT INTO onboarding_tasks
                            (employee_id, task_category, task_name, task_description, is_required, status)
                            VALUES (%s, 'IT', %s, %s, %s, %s)
                        """, [employee_id, task_name, task_desc, is_req, status])

            conn.commit()
            results['onboarding_created'] = True
            app.logger.info(f'✅ Onboarding record + tasks created: {employee_id}')
        except Exception as e:
            app.logger.error(f'❌ Onboarding tasks error: {e}')

        ohrm.close()
        conn.close()

        results['success']       = True
        results['employee_id']   = employee_id
        results['temp_password'] = temp_password
        return jsonify(results)

    except Exception as e:
        app.logger.error(f'❌ Onboarding error: {e}', exc_info=True)
        return jsonify({'error': str(e)}), 500


# ── API: Offboard (Disable Employee) ──────────────────────

@app.route('/hrportal/api/offboard/<employee_id>', methods=['POST'])
@permission_required('can_onboarding')
def hrportal_offboard(employee_id):
    """Disable employee across all systems"""
    try:
        import secrets
        import requests as ext_requests

        data          = request.get_json() or {}
        exit_date     = data.get('exit_date', datetime.now().strftime('%Y-%m-%d'))
        reason        = data.get('reason', 'Voluntary Resignation')
        notes         = data.get('notes', '')
        processed_by  = session.get('user', {}).get('name', 'System')
        cpanel_domain = os.environ.get('CPANEL_DOMAIN', 'cohere.ph')

        ad   = get_ad_config()
        conn = get_db_connection()

        with conn.cursor() as cur:
            cur.execute(
                "SELECT * FROM gsheet_employees WHERE employee_id = %s", [employee_id]
            )
            employee = cur.fetchone()

        if not employee:
            conn.close()
            return jsonify({'error': 'Employee not found'}), 404

        email         = employee['email']
        schedule_name = employee['schedule_name']
        name_parts    = schedule_name.split()
        last_name     = name_parts[-1] if name_parts else ''
        first_name    = ' '.join(name_parts[:-1]) if len(name_parts) > 1 else (name_parts[0] if name_parts else '')

        results = {
            'employee_id':        employee_id,
            'employee_name':      schedule_name,
            'keycloak_disabled':  False,
            'ad_disabled':        False,
            'email_suspended':    False,
            'dashboard_disabled': False,
            'orangehrm_updated':  False,
            'biometric_retained': True,   # intentional — never deleting
            'status_updated':     False,
        }

        # 1. KEYCLOAK — first (blocks all SSO immediately) ──
        try:
            kc    = get_keycloak_admin()
            users = kc.get_users({"email": email})
            if users:
                kc.update_user(users[0]['id'], {"enabled": False})
                results['keycloak_disabled'] = True
                app.logger.info(f'✅ Keycloak disabled: {email}')
            else:
                app.logger.warning(f'⚠️ Keycloak user not found: {email}')
        except Exception as e:
            app.logger.error(f'❌ Keycloak disable error: {e}')

        # 2. ACTIVE DIRECTORY ──────────────────────────────
        try:
            first_name_parts = first_name.split()
            ad_username = (first_name_parts[0] + last_name).lower().replace(' ', '')
            ar = ext_requests.post(
                f"{ad['base_url']}/api/user/disable",
                headers=ad['headers'],
                json={'username': ad_username, 'reason': reason},
                timeout=30
            )
            results['ad_disabled'] = ar.status_code == 200
            if results['ad_disabled']:
                app.logger.info(f'✅ AD disabled: {ad_username}')
            else:
                app.logger.error(f'❌ AD disable failed: {ar.text}')
        except Exception as e:
            app.logger.error(f'❌ AD disable error: {e}')

        # 3. EMAIL — rotate password + lock ───────────────
        try:
            random_pw = f"OFFBOARDED_{datetime.now().strftime('%Y%m%d_%H%M%S')}_{secrets.token_hex(16)}"
            er = ext_requests.get(
                get_cpanel_url(),
                params={
                    'cpanel_jsonapi_user':   os.environ.get('CPANEL_USERNAME', 'cohere'),
                    'cpanel_jsonapi_module': 'Email',
                    'cpanel_jsonapi_func':   'passwdpop',
                    'email':                 email.split('@')[0],
                    'domain':                cpanel_domain,
                    'password':              random_pw
                },
                headers={'Authorization': get_cpanel_auth()},
                verify=False, timeout=10
            )
            if er.json().get('cpanelresult', {}).get('data', [{}])[0].get('result') == 1:
                results['email_suspended'] = True
                app.logger.info(f'✅ Email locked: {email}')
            else:
                app.logger.error(f'❌ Email lock failed: {er.text}')
        except Exception as e:
            app.logger.error(f'❌ Email lock error: {e}')

        # 4. DASHBOARD LOGIN ACCOUNT (central_db.Employees) ──
        try:
            with conn.cursor() as cur:
                cur.execute("""
                    UPDATE Employees
                    SET IsActive = 0, DisabledAt = NOW(),
                        DisabledBy = %s, DisabledReason = %s
                    WHERE Email = %s
                """, [processed_by, reason, email])
                results['dashboard_disabled'] = cur.rowcount > 0
            conn.commit()
            app.logger.info(f'✅ Dashboard account disabled: {email}')
        except Exception as e:
            app.logger.error(f'❌ Dashboard disable error: {e}')

        # 5. ORANGEHRM — termination record ───────────────
        try:
            ohrm = get_db()
            with ohrm.cursor() as ocur:
                ocur.execute(
                    "SELECT emp_number FROM hs_hr_employee WHERE employee_id = %s",
                    [employee_id]
                )
                row = ocur.fetchone()
                if row:
                    emp_num = row['emp_number']
                    ocur.execute("""
                        INSERT INTO ohrm_emp_termination
                        (emp_number, reason_id, termination_date, note)
                        VALUES (%s, 1, %s, %s)
                        ON DUPLICATE KEY UPDATE
                            termination_date = VALUES(termination_date),
                            note = VALUES(note)
                    """, [emp_num, exit_date, notes])
                    ocur.execute(
                        "SELECT id FROM ohrm_emp_termination WHERE emp_number = %s",
                        [emp_num]
                    )
                    tid_row = ocur.fetchone()
                    if tid_row:
                        ocur.execute(
                            "UPDATE hs_hr_employee SET termination_id = %s WHERE emp_number = %s",
                            [tid_row['id'], emp_num]
                        )
                    ohrm.commit()
                    results['orangehrm_updated'] = True
                    app.logger.info(f'✅ OrangeHRM termination recorded: {employee_id}')
                else:
                    app.logger.warning(f'⚠️ OrangeHRM employee not found: {employee_id}')
            ohrm.close()
        except Exception as e:
            app.logger.error(f'❌ OrangeHRM disable error: {e}')

        # 6. EMPLOYEE STATUS (central_db) ──────────────────
        try:
            with conn.cursor() as cur:
                cur.execute("""
                    UPDATE gsheet_employees
                    SET status = 'Separated', exit_date = %s,
                        updated_by = %s, last_modified_at = NOW()
                    WHERE employee_id = %s
                """, [exit_date, processed_by, employee_id])
            conn.commit()
            results['status_updated'] = True
            app.logger.info(f'✅ Employee status → Separated: {employee_id}')
        except Exception as e:
            app.logger.error(f'❌ Status update error: {e}')

        # 7. OFFBOARDING AUDIT RECORD (central_db) ─────────
        try:
            with conn.cursor() as cur:
                cur.execute("""
                    CREATE TABLE IF NOT EXISTS employee_offboarding (
                        id                 INT AUTO_INCREMENT PRIMARY KEY,
                        employee_id        VARCHAR(20) NOT NULL,
                        exit_date          DATE NOT NULL,
                        reason             VARCHAR(255),
                        notes              TEXT,
                        processed_by       VARCHAR(100),
                        processed_at       TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                        ad_disabled        BOOLEAN DEFAULT FALSE,
                        keycloak_disabled  BOOLEAN DEFAULT FALSE,
                        email_suspended    BOOLEAN DEFAULT FALSE,
                        dashboard_disabled BOOLEAN DEFAULT FALSE,
                        biometric_deleted  BOOLEAN DEFAULT FALSE,
                        orangehrm_updated  BOOLEAN DEFAULT FALSE,
                        status_updated     BOOLEAN DEFAULT FALSE,
                        INDEX idx_employee (employee_id)
                    )
                """)
                cur.execute("""
                    INSERT INTO employee_offboarding
                    (employee_id, exit_date, reason, notes, processed_by,
                     ad_disabled, keycloak_disabled, email_suspended,
                     dashboard_disabled, biometric_deleted,
                     orangehrm_updated, status_updated, biometric_deactivated)
                    VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
                """, [
                    employee_id, exit_date, reason, notes, processed_by,
                    results['ad_disabled'], results['keycloak_disabled'],
                    results['email_suspended'], results['dashboard_disabled'], False,
                    results['orangehrm_updated'], results['status_updated'],
                    results.get('biometric_deactivated', False)
                ])
            conn.commit()
            app.logger.info(f'✅ Offboarding audit record saved: {employee_id}')
        except Exception as e:
            app.logger.error(f'❌ Offboarding audit record error: {e}')


        # 8. BIOMETRIC DEACTIVATION (all local servers + blade) ──
        biometric_servers = [
            {'host': '172.12.7.203', 'user': 'root', 'password': '', 'database': 'timekeep'},
        ]
        biometric_results = {}
        try:
            import pymysql
            for srv in biometric_servers:
                host = srv['host']
                try:
                    bio_conn = pymysql.connect(
                        host=host, user=srv['user'],
                        password=srv['password'], database=srv['database'],
                        connect_timeout=5
                    )
                    with bio_conn.cursor() as bc:
                        bc.execute(
                            "UPDATE userdata SET active = 0 WHERE companyid = %s",
                            [employee_id]
                        )
                        affected = bc.rowcount
                    bio_conn.commit()
                    bio_conn.close()
                    biometric_results[host] = affected
                    app.logger.info(f'Biometric deactivated on {host}: {affected} row(s)')
                except Exception as bio_err:
                    biometric_results[host] = -1
                    app.logger.error(f'Biometric deactivation failed on {host}: {bio_err}')
            results['biometric_deactivated'] = all(v >= 0 for v in biometric_results.values())
            results['biometric_details'] = biometric_results
        except Exception as e:
            app.logger.error(f'Biometric deactivation error: {e}')
            results['biometric_deactivated'] = False

        conn.close()
        results['success'] = True
        return jsonify(results)

    except Exception as e:
        app.logger.error(f'❌ Offboarding error: {e}', exc_info=True)
        return jsonify({'error': str(e)}), 500


@app.route('/admin/absences')
def admin_absences():
    if not session.get('is_admin') and not session.get('permissions', {}).get('can_absences'):
        return redirect(url_for('dashboard'))

    from datetime import date, timedelta, datetime as dt
    yesterday = date.today() - timedelta(days=1)

    def parse_date(val, fallback):
        try:
            return date.fromisoformat(val) if val else fallback
        except ValueError:
            return fallback

    date_from = parse_date(request.args.get('date_from'), yesterday)
    date_to   = parse_date(request.args.get('date_to'),   yesterday)
    if date_to < date_from:
        date_to = date_from

    # ── Step 1: All scheduled active employees in date range ──
    scheduled = []
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("""
                SELECT
                    g.employee_id,
                    g.schedule_name,
                    COALESCE(g.tl, '-')                AS tl,
                    COALESCE(g.group_name, 'No Group') AS group_name,
                    es.shift_time,
                    es.schedule_date                   AS absent_date,
                    u.personid
                FROM employee_schedules es
                JOIN gsheet_employees g
                    ON g.employee_id COLLATE utf8mb4_unicode_ci = es.employee_id COLLATE utf8mb4_unicode_ci
                JOIN (
                    SELECT companyid,
                           SUBSTRING_INDEX(GROUP_CONCAT(personid ORDER BY personid DESC), ',', 1) AS personid
                    FROM userdata
                    GROUP BY companyid
                ) u ON u.companyid COLLATE utf8mb4_unicode_ci = es.employee_id COLLATE utf8mb4_unicode_ci
                WHERE es.schedule_date BETWEEN %s AND %s
                    AND es.is_rest_day   = 0
                    AND es.shift_time   IS NOT NULL
                    AND g.status         = 'Active'
                ORDER BY g.group_name, g.tl, es.schedule_date, g.schedule_name
            """, (date_from, date_to))
            scheduled = c.fetchall()
    finally:
        cdb.close()

    records   = []
    leave_map = {}
    cws_map   = {}

    if scheduled:
        # Build lookup: personid -> employee info
        personid_map = {}
        for row in scheduled:
            pid = int(row['personid']) if row['personid'] else None
            if pid:
                personid_map.setdefault(pid, row)

        personids = list(personid_map.keys())

        # ── Step 2: Fetch ALL time records with a buffer day on each side ──
        # Buffer before: to catch INs from the day before date_from (for overnight shifts)
        raw_logs = {}  # personid -> [(datetime, type), ...]
        if personids:
            ph         = ','.join(['%s'] * len(personids))
            window_start = date_from - timedelta(days=1)
            window_end   = date_to   + timedelta(days=1)
            cdb2 = get_central_db()
            try:
                with cdb2.cursor() as c:
                    c.execute(f"""
                        SELECT personid, date, type
                        FROM dailytimerecordsfiltered
                        WHERE personid IN ({ph})
                          AND date_only BETWEEN %s AND %s
                        ORDER BY personid, date
                    """, personids + [window_start, window_end])
                    for row in c.fetchall():
                        pid = int(row['personid'])
                        raw_logs.setdefault(pid, []).append((row['date'], row['type']))
            finally:
                cdb2.close()

        # ── Step 3: PHP-style sequential pairing per employee ──
        # Returns list of {day, time_in, time_out, status} for each employee
        MAX_HOURS    = 18 * 3600  # 18-hour pairing window
        NOON_SECONDS = 12 * 3600  # noon threshold for prev-day attribution

        # Build a map: (personid, date) -> {status, time_in, time_out}
        attendance_map = {}

        for pid, logs in raw_logs.items():
            previous_in = None  # (datetime, type='in') log entry

            for (log_dt, log_type) in logs:
                log_date = log_dt.date()
                log_time = log_dt.time()
                log_ts   = log_dt.timestamp()

                if log_type == 'in':
                    if previous_in:
                        prev_ts   = previous_in.timestamp()
                        time_diff = log_ts - prev_ts

                        if time_diff > MAX_HOURS:
                            # Previous IN has no OUT within 18hrs -> FTS OUT
                            prev_date = previous_in.date()
                            attendance_map[(pid, prev_date)] = {
                                'status':   'FTS OUT',
                                'time_in':  previous_in.strftime('%b %d %H:%M'),
                                'time_out': None,
                            }
                            previous_in = None

                    if previous_in is None:
                        previous_in = log_dt

                elif log_type == 'out':
                    log_time_secs = log_dt.hour * 3600 + log_dt.minute * 60 + log_dt.second

                    # If OUT before noon -> attribute to previous calendar day
                    if log_time_secs < NOON_SECONDS:
                        record_date = (log_dt - timedelta(days=1)).date()
                    else:
                        record_date = log_date

                    if previous_in:
                        in_ts     = previous_in.timestamp()
                        time_diff = log_ts - in_ts

                        if time_diff <= MAX_HOURS:
                            # Valid pair
                            pair_date = previous_in.date()
                            attendance_map[(pid, pair_date)] = {
                                'status':   'Present',
                                'time_in':  previous_in.strftime('%b %d %H:%M'),
                                'time_out': log_dt.strftime('%b %d %H:%M'),
                            }
                            previous_in = None
                        else:
                            # Gap too large -> OUT is FTS IN (no valid prior IN)
                            attendance_map[(pid, record_date)] = {
                                'status':   'FTS IN',
                                'time_in':  None,
                                'time_out': log_dt.strftime('%b %d %H:%M'),
                            }
                    else:
                        # No prior IN -> FTS IN
                        attendance_map[(pid, record_date)] = {
                            'status':   'FTS IN',
                            'time_in':  None,
                            'time_out': log_dt.strftime('%b %d %H:%M'),
                        }

            # Leftover unpaired IN -> FTS OUT
            if previous_in:
                prev_date = previous_in.date()
                # Don't flag if it's past the filter end date (might still be working)
                if prev_date <= date_to:
                    attendance_map[(pid, prev_date)] = {
                        'status':   'FTS OUT',
                        'time_in':  previous_in.strftime('%b %d %H:%M'),
                        'time_out': None,
                    }

        # ── Step 4: Match scheduled rows to attendance_map ──
        for row in scheduled:
            pid        = int(row['personid']) if row['personid'] else None
            sched_date = row['absent_date']
            key        = (pid, sched_date)

            att = attendance_map.get(key)

            if att is None:
                status   = 'Absent'
                time_in  = None
                time_out = None
            elif att['status'] == 'Present':
                continue  # exclude from report
            else:
                status   = att['status']
                time_in  = att['time_in']
                time_out = att['time_out']

            r = dict(row)
            r['attendance_status'] = status
            r['time_in']           = time_in
            r['time_out']          = time_out
            records.append(r)

        # ── Step 5: Remarks (leave + CWS) ──
        emp_ids = list({r['employee_id'] for r in records})
        if emp_ids:
            placeholders = ','.join(['%s'] * len(emp_ids))

            odb = get_db()
            try:
                with odb.cursor() as c:
                    c.execute(f"""
                        SELECT lr.employee_id, lt.name AS leave_type_name,
                               lr.status, lr.leave_date
                        FROM leave4day_requests lr
                        JOIN ohrm_leave_type lt ON lt.id = lr.leave_type_id
                        WHERE lr.employee_id IN ({placeholders})
                          AND lr.leave_date BETWEEN %s AND %s
                          AND lr.status NOT IN ('Rejected','Cancelled','Deleted','rejected','cancelled')
                    """, emp_ids + [date_from, date_to])
                    for row in c.fetchall():
                        key = '{}|{}'.format(row['employee_id'], row['leave_date'])
                        leave_map.setdefault(key, []).append(row)
            finally:
                odb.close()

            cdb3 = get_central_db()
            try:
                with cdb3.cursor() as c:
                    c.execute(f"""
                        SELECT employee_id, original_date, original_time,
                               new_date, new_time, status
                        FROM cws_requests
                        WHERE employee_id IN ({placeholders})
                          AND original_date BETWEEN %s AND %s
                          AND status NOT IN ('Rejected','Cancelled','Deleted')
                    """, emp_ids + [date_from, date_to])
                    for row in c.fetchall():
                        key = '{}|{}'.format(row['employee_id'], row['original_date'])
                        cws_map.setdefault(key, []).append(row)
            finally:
                cdb3.close()

    summary = {
        'absent':  sum(1 for r in records if r['attendance_status'] == 'Absent'),
        'fts_in':  sum(1 for r in records if r['attendance_status'] == 'FTS IN'),
        'fts_out': sum(1 for r in records if r['attendance_status'] == 'FTS OUT'),
    }

    return render_template('admin_absences.html',
                           records=records,
                           date_from=str(date_from),
                           date_to=str(date_to),
                           leave_map=leave_map,
                           cws_map=cws_map,
                           summary=summary)

# MAGIC CWS
# ─────────────────────────────────────────────────────────────

SHIFTS_5DAY = [
    ("12mn-9am","00:00","09:00"), ("1am-10am","01:00","10:00"),
    ("2am-11am","02:00","11:00"), ("3am-12nn","03:00","12:00"),
    ("4am-1pm","04:00","13:00"),  ("5am-2pm","05:00","14:00"),
    ("6am-3pm","06:00","15:00"),  ("7am-4pm","07:00","16:00"),
    ("8am-5pm","08:00","17:00"),  ("9am-6pm","09:00","18:00"),
    ("10am-7pm","10:00","19:00"), ("11am-8pm","11:00","20:00"),
    ("12nn-9pm","12:00","21:00"), ("1pm-10pm","13:00","22:00"),
    ("2pm-11pm","14:00","23:00"), ("3pm-12mn","15:00","00:00"),
    ("4pm-1am","16:00","01:00"),  ("5pm-2am","17:00","02:00"),
    ("6pm-3am","18:00","03:00"),  ("7pm-4am","19:00","04:00"),
    ("8pm-5am","20:00","05:00"),  ("9pm-6am","21:00","06:00"),
    ("10pm-7am","22:00","07:00"), ("11pm-8am","23:00","08:00"),
]

SHIFTS_4DAY = [
    ("12mn-11am","00:00","11:00"), ("1am-12nn","01:00","12:00"),
    ("2am-1pm","02:00","13:00"),   ("3am-2pm","03:00","14:00"),
    ("4am-3pm","04:00","15:00"),   ("5am-4pm","05:00","16:00"),
    ("6am-5pm","06:00","17:00"),   ("7am-6pm","07:00","18:00"),
    ("8am-7pm","08:00","19:00"),   ("9am-8pm","09:00","20:00"),
    ("10am-9pm","10:00","21:00"),  ("11am-10pm","11:00","22:00"),
    ("12nn-11pm","12:00","23:00"), ("1pm-12mn","13:00","00:00"),
    ("2pm-1am","14:00","01:00"),   ("3pm-2am","15:00","02:00"),
    ("4pm-3am","16:00","03:00"),   ("5pm-4am","17:00","04:00"),
    ("6pm-5am","18:00","05:00"),   ("7pm-6am","19:00","06:00"),
    ("8pm-7am","20:00","07:00"),   ("9pm-8am","21:00","08:00"),
    ("10pm-9am","22:00","09:00"),  ("11pm-10am","23:00","10:00"),
]

SHIFT_MAP_5DAY = {s[0]: (s[1], s[2]) for s in SHIFTS_5DAY}
SHIFT_MAP_4DAY = {s[0]: (s[1], s[2]) for s in SHIFTS_4DAY}


def _get_magic_leave_type_id():
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT id FROM orangehrm2.ohrm_leave_type WHERE name = %s AND deleted = 0",
              ("Magic Leave",))
    row = c.fetchone()
    return row['id'] if row else None


def _init_magic_cws_balance(conn, emp_number, employee_id):
    c = conn.cursor()
    c.execute("SELECT initial_hrs, used_hrs FROM magic_cws_balance WHERE emp_number = %s",
              (emp_number,))
    row = c.fetchone()
    if row:
        return round(float(row['initial_hrs']) - float(row['used_hrs']), 2)

    leave_type_id = _get_magic_leave_type_id()
    initial_hrs = 0.0
    if leave_type_id:
        ohrm = get_db()
        oc = ohrm.cursor()
        oc.execute("""
            SELECT (no_of_days - days_used) * 8 AS remaining_hrs
            FROM orangehrm2.ohrm_leave_entitlement
            WHERE emp_number = %s AND leave_type_id = %s
              AND YEAR(from_date) = YEAR(CURDATE()) AND deleted = 0
            ORDER BY id DESC LIMIT 1
        """, (emp_number, leave_type_id))
        r = oc.fetchone()
        if r and r['remaining_hrs']:
            initial_hrs = float(r['remaining_hrs'])

    c.execute("""
        INSERT INTO magic_cws_balance (emp_number, employee_id, initial_hrs, used_hrs)
        VALUES (%s, %s, %s, 0)
        ON DUPLICATE KEY UPDATE employee_id = VALUES(employee_id)
    """, (emp_number, employee_id, initial_hrs))
    conn.commit()
    return round(initial_hrs, 2)


def _get_work_mode(emp_number):
    ohrm = get_db()
    c = ohrm.cursor()
    c.execute("SELECT work_mode FROM leave4day_emp_settings WHERE emp_number = %s",
              (emp_number,))
    r = c.fetchone()
    return r['work_mode'] if r else "4day"


def _calc_deduction(orig_date_str, orig_start_str, new_date_str, new_start_str, work_mode):
    from datetime import datetime
    fmt = "%Y-%m-%d %H:%M"
    orig_dt = datetime.strptime(f"{orig_date_str} {orig_start_str}", fmt)
    new_dt  = datetime.strptime(f"{new_date_str} {new_start_str}", fmt)
    diff_hrs   = abs((new_dt - orig_dt).total_seconds()) / 3600
    hours_diff = round(diff_hrs, 2)
    max_hrs    = 10 if work_mode == "4day" else 8
    deduction  = round(min(hours_diff, max_hrs), 2)
    return hours_diff, deduction


@app.route("/file-requests/magic-cws", methods=["GET", "POST"])
@login_required
def magic_cws_form():
    emp_number  = session['user']['emp_number']
    employee_id = session['user'].get('employee_id', '').strip()

    conn      = get_central_db()
    work_mode = _get_work_mode(emp_number)
    shifts    = SHIFTS_4DAY if work_mode == "4day" else SHIFTS_5DAY
    balance   = _init_magic_cws_balance(conn, emp_number, employee_id)

    if request.method == "POST":
        orig_shift = request.form.get("original_shift", "").strip()
        new_shift  = request.form.get("new_shift", "").strip()
        orig_date  = request.form.get("original_date", "").strip()
        new_date   = request.form.get("new_date", "").strip()
        reason     = request.form.get("reason", "").strip()

        shift_map = SHIFT_MAP_4DAY if work_mode == "4day" else SHIFT_MAP_5DAY

        if orig_shift not in shift_map or new_shift not in shift_map:
            flash("Invalid shift selected.", "danger")
            return redirect(url_for("magic_cws_form"))

        orig_start, orig_end = shift_map[orig_shift]
        new_start,  new_end  = shift_map[new_shift]
        hours_diff, deduction = _calc_deduction(orig_date, orig_start, new_date, new_start, work_mode)

        employee_name = session.get("name", "")
        c = conn.cursor()
        c.execute("""
            INSERT INTO magic_cws_requests
              (emp_number, employee_id, employee_name,
               original_date, original_shift, original_shift_start, original_shift_end,
               new_date, new_shift, new_shift_start, new_shift_end,
               hours_difference, deduction_hours, reason, status)
            VALUES (%s,%s,%s, %s,%s,%s,%s, %s,%s,%s,%s, %s,%s,%s,'Pending')
        """, (emp_number, employee_id, employee_name,
              orig_date, orig_shift, orig_start, orig_end,
              new_date,  new_shift,  new_start,  new_end,
              hours_diff, deduction, reason))
        conn.commit()

        try:
            sup_email = get_supervisor_email(emp_number)
            if sup_email:
                _send_magic_cws_email(employee_name, employee_id,
                                      orig_date, orig_shift,
                                      new_date,  new_shift,
                                      hours_diff, deduction, sup_email)
        except Exception as e:
            app.logger.warning(f"Magic CWS email error: {e}")

        flash("Magic CWS request filed successfully.", "success")
        return redirect(url_for("magic_cws_form"))

    c = conn.cursor()
    c.execute("""
        SELECT id, original_date, original_shift, new_date, new_shift,
               hours_difference, deduction_hours, reason, status, filed_at
        FROM magic_cws_requests
        WHERE emp_number = %s AND status != 'Deleted'
        ORDER BY filed_at DESC LIMIT 20
    """, (emp_number,))
    my_requests = c.fetchall()

    return render_template("file_requests/magic_cws_form.html",
                           shifts=shifts,
                           work_mode=work_mode,
                           balance=balance,
                           my_requests=my_requests)


def _send_magic_cws_email(employee_name, employee_id,
                           orig_date, orig_shift,
                           new_date, new_shift,
                           hours_diff, deduction, sup_email):
    subject = f"Magic CWS Request — {employee_name}"
    body = f"""
    <p>{employee_name} ({employee_id}) filed a Magic CWS request.</p>
    <table style="border-collapse:collapse;font-family:sans-serif;font-size:14px">
      <tr><td style="padding:4px 16px 4px 0;font-weight:bold">Original Shift</td>
          <td>{orig_date} &nbsp; {orig_shift}</td></tr>
      <tr><td style="padding:4px 16px 4px 0;font-weight:bold">New Shift</td>
          <td>{new_date} &nbsp; {new_shift}</td></tr>
      <tr><td style="padding:4px 16px 4px 0;font-weight:bold">Hours Difference</td>
          <td>{hours_diff} hrs</td></tr>
      <tr><td style="padding:4px 16px 4px 0;font-weight:bold;color:#6f42c1">Deduction</td>
          <td style="color:#6f42c1;font-weight:bold">{deduction} hrs</td></tr>
    </table>
    <p>Log in to the HR Portal to approve or reject.</p>
    """
    send_email(sup_email, subject, body)


@app.route("/file-requests/magic-cws/action", methods=["POST"])
@login_required
def magic_cws_action():
    action        = request.form.get("action")
    req_id        = request.form.get("req_id")
    delete_reason = request.form.get("delete_reason", "")
    next_url      = request.form.get("next", url_for("approvals"))

    is_admin = session.get("is_admin")
    is_sup   = session.get("is_supervisor")
    if not (is_admin or is_sup):
        flash("Access denied.", "danger")
        return redirect(next_url)

    conn = get_central_db()
    c    = conn.cursor()
    c.execute("SELECT * FROM magic_cws_requests WHERE id = %s", (req_id,))
    row = c.fetchone()
    if not row:
        flash("Request not found.", "danger")
        return redirect(next_url)

    cols = [d[0] for d in c.description]
    req  = dict(zip(cols, row))

    if action == "approve" and req["status"] == "Pending":
        deduction = float(req["deduction_hours"] or 0)
        _init_magic_cws_balance(conn, req["emp_number"], req["employee_id"])
        c.execute("""
            UPDATE magic_cws_balance
            SET used_hrs = used_hrs + %s
            WHERE emp_number = %s
        """, (deduction, req["emp_number"]))
        c.execute("""
            UPDATE magic_cws_requests
            SET status = 'Approved', approved_by = %s, approved_at = NOW()
            WHERE id = %s
        """, (session.get("emp_number"), req_id))
        conn.commit()
        flash("Magic CWS approved.", "success")

    elif action == "reject" and req["status"] == "Pending":
        c.execute("UPDATE magic_cws_requests SET status = 'Rejected' WHERE id = %s", (req_id,))
        conn.commit()
        flash("Magic CWS rejected.", "warning")

    elif action == "delete" and is_admin:
        if req["status"] == "Approved":
            deduction = float(req["deduction_hours"] or 0)
            c.execute("""
                UPDATE magic_cws_balance
                SET used_hrs = GREATEST(0, used_hrs - %s)
                WHERE emp_number = %s
            """, (deduction, req["emp_number"]))
        c.execute("""
            UPDATE magic_cws_requests
            SET status = 'Deleted', delete_reason = %s
            WHERE id = %s
        """, (delete_reason, req_id))
        conn.commit()
        flash("Magic CWS deleted.", "info")

    return redirect(next_url)

