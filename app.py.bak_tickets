                """SELECT id FROM cws_requests
                   WHERE employee_id = %s
                   AND original_date = %s
                   AND original_time = %s
                   AND new_date = %s
                   AND new_time = %s
                   AND deleted_at IS NULL""",
                (employee_id, original_date, original_time, new_date, new_time)
            )
            if cursor.fetchone():
                message = 'You already submitted this exact CWS request.'
                msg_type = 'warning'
            else:
                cursor.execute(
                    """INSERT INTO cws_requests
                       (employee_id, original_date, original_time,
                        new_date, new_time, reason, status)
                       VALUES (%s, %s, %s, %s, %s, %s, 'Pending')""",
