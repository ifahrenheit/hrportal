                           entitlement_source=current_source,
                           quick_links_visible=quick_links_visible,
                           user=session['user'])

@app.route('/admin/settings/quick-links', methods=['POST'])
@permission_required('can_settings')
def toggle_quick_links():
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("SELECT setting_value FROM leave4day_settings WHERE setting_key = 'quick_links_visible'")
            row = c.fetchone()
            new_val = '0' if row and row['setting_value'] == '1' else '1'
            c.execute("""INSERT INTO leave4day_settings (setting_key, setting_value, updated_by)
                          VALUES ('quick_links_visible', %s, %s)
                          ON DUPLICATE KEY UPDATE setting_value = %s, updated_by = %s""",
                      (new_val, session['user']['emp_number'], new_val, session['user']['emp_number']))
        db.commit()
        flash('Quick Links visibility updated!', 'success')
    except Exception as e:
        db.rollback()
        flash(f'Error: {e}', 'danger')
    finally:
        db.close()
    return redirect(url_for('admin_quick_links'))

@app.route('/admin/schedules')
@permission_required('can_schedules')
def admin_schedules():
    from datetime import date
    default_month = date.today().strftime('%Y-%m')
    month_filter  = request.args.get('month', default_month)
    emp_search    = request.args.get('emp_search', '').strip()
    group_filter  = request.args.get('group', '')
    shift_filter  = request.args.get('shift', '')

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            # Available months
            c.execute("SELECT DISTINCT month FROM employee_schedules ORDER BY month DESC")
            months = [r['month'] for r in c.fetchall()]

            # Available groups
            c.execute("""SELECT DISTINCT group_name FROM gsheet_employees
                         WHERE group_name IS NOT NULL AND status != 'Separated'
                         ORDER BY group_name""")
            groups = [r['group_name'] for r in c.fetchall()]

            # Available shifts for selected month
            c.execute("""SELECT DISTINCT shift_time FROM employee_schedules
                         WHERE month=%s AND shift_time IS NOT NULL
                         ORDER BY shift_time""", (month_filter,))
            shifts = [r['shift_time'] for r in c.fetchall()]

            # Build query - group by employee, show their schedule for the month
            where  = ['s.month = %s']
            params = [month_filter]

            if emp_search:
                where.append('(g.employee_id LIKE %s OR g.schedule_name LIKE %s)')
                params += [f'%{emp_search}%', f'%{emp_search}%']
            if group_filter:
                where.append('g.group_name = %s')
                params.append(group_filter)

            # Get all schedules for the month
            c.execute(f"""
                SELECT s.employee_id, s.schedule_date, s.shift_time, s.is_rest_day,
                       g.schedule_name, g.group_name, g.tl
                FROM employee_schedules s
                LEFT JOIN gsheet_employees g ON g.employee_id = s.employee_id
                WHERE {' AND '.join(where)}
                ORDER BY g.group_name, g.schedule_name, s.schedule_date
            """, params)
            rows = c.fetchall()

            # Structure: {employee_id: {info, days: {date: {shift, is_rest}}}}
            from collections import defaultdict
            emp_map = {}
            all_dates = sorted(set(str(r['schedule_date']) for r in rows))

            for r in rows:
                eid = r['employee_id']
                if eid not in emp_map:
                    emp_map[eid] = {
                        'employee_id': eid,
                        'name': r['schedule_name'] or eid,
                        'group_name': r['group_name'] or '—',
                        'tl': r['tl'] or '—',
                        'days': {}
                    }
                emp_map[eid]['days'][str(r['schedule_date'])] = {
                    'shift': r['shift_time'],
                    'is_rest': bool(r['is_rest_day'])
                }

            # Filter by shift if selected
            if shift_filter:
                emp_map = {k: v for k, v in emp_map.items()
                           if any(d['shift'] == shift_filter for d in v['days'].values())}

            employees = list(emp_map.values())

            from datetime import datetime as dt
            date_headers = []
            for d in all_dates:
                obj = dt.strptime(d, '%Y-%m-%d')
                date_headers.append({'date': d, 'day': obj.strftime('%d'), 'weekday': obj.strftime('%a')})

    finally:
        cdb.close()

    return render_template('admin/schedules.html',
                           employees=employees, all_dates=all_dates, date_headers=date_headers,
                           months=months, groups=groups, shifts=shifts,
                           month_filter=month_filter, emp_search=emp_search,
                           group_filter=group_filter, shift_filter=shift_filter,
                           user=session['user'])

@app.route('/api/employee-search')
@login_required
def employee_search():
    q = request.args.get('q', '').strip()
    if len(q) < 2:
        return jsonify([])
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("""
                SELECT DISTINCT
                    schedule_name AS name,
                    employee_id
                FROM gsheet_employees
                WHERE status != 'Separated'
                AND (schedule_name LIKE %s OR employee_id LIKE %s)
                ORDER BY schedule_name
                LIMIT 10
            """, (f'%{q}%', f'%{q}%'))
            results = [{'name': r['name'] or r['employee_id'], 'id': r['employee_id']} for r in c.fetchall()]
    finally:
        cdb.close()
    return jsonify(results)


@app.route('/admin/all-leaves')
@permission_required('can_all_leaves')
def admin_all_leaves():
    # Filters from GET params
    date_from  = request.args.get('date_from', '')
    date_to    = request.args.get('date_to', '')
    status     = request.args.get('status', '')
    leave_type = request.args.get('leave_type', '')
    emp_search = request.args.get('emp_search', '')
    tl_filter  = request.args.get('tl', '')

    db = get_db()
    try:
        with db.cursor() as c:
            # Leave types for dropdown
            c.execute("SELECT id, name FROM ohrm_leave_type ORDER BY name")
            leave_types = c.fetchall()

            # Distinct TLs from gsheet_employees for dropdown
            # After (shows only TLs under this approver)
            if session.get('is_admin'):
                c.execute("""
                    SELECT DISTINCT TL FROM central_db.gsheet_employees
                    WHERE TL IS NOT NULL AND TL != '' AND status != 'Separated'
                    ORDER BY TL
                """)
            else:
                approver_name = session['user']['name']  # "Firstname Lastname"
                c.execute("""
                    SELECT DISTINCT TL FROM central_db.gsheet_employees
                    WHERE Approver = %s
                    AND TL IS NOT NULL AND TL != ''
                    AND status != 'Separated'
                    ORDER BY TL
                """, (approver_name,))
            tl_list = [r['TL'] for r in c.fetchall()]

            # Build dynamic query
            where  = ["1=1"]
            params = []

            if date_from:
                where.append("r.leave_date >= %s")
                params.append(date_from)
            if date_to:
                where.append("r.leave_date <= %s")
                params.append(date_to)
            if status:
                where.append("r.status = %s")
                params.append(status)
            if leave_type:
                where.append("r.leave_type_id = %s")
                params.append(leave_type)
            if emp_search:
                where.append("(e.emp_firstname LIKE %s OR e.emp_lastname LIKE %s OR e.employee_id LIKE %s)")
                params.extend([f'%{emp_search}%', f'%{emp_search}%', f'%{emp_search}%'])
            if tl_filter:
                where.append("g.TL = %s")
                params.append(tl_filter)

            query = f"""
                SELECT r.*, lt.name AS leave_type_name,
                    e.emp_firstname, e.emp_lastname, e.employee_id,
                    g.TL, g.group_name
                FROM leave4day_requests r
                JOIN ohrm_leave_type lt ON r.leave_type_id = lt.id
                JOIN hs_hr_employee e   ON r.emp_number = e.emp_number
                LEFT JOIN central_db.gsheet_employees g ON g.employee_id COLLATE utf8mb4_unicode_ci = e.employee_id
                WHERE {' AND '.join(where)}
                ORDER BY g.TL, r.filed_at DESC
                LIMIT 500
            """
            c.execute(query, params)
            records = c.fetchall()
    finally:
        db.close()

    # Get display name for emp_search if it's an employee_id
    emp_display = emp_search
    if emp_search and records:
        # Try gsheet schedule_name first
        try:
            cdb2 = get_central_db()
            with cdb2.cursor() as cc:
                cc.execute('SELECT schedule_name FROM gsheet_employees WHERE employee_id = %s LIMIT 1', (emp_search,))
                gs = cc.fetchone()
                emp_display = gs['schedule_name'] if gs and gs['schedule_name'] else (records[0]['emp_firstname'] + ' ' + records[0]['emp_lastname'])
            cdb2.close()
        except:
            emp_display = records[0]['emp_firstname'] + ' ' + records[0]['emp_lastname']

    return render_template('admin/all_leaves.html',
                           records=records, user=session['user'],
                           leave_types=leave_types, tl_list=tl_list,
                           date_from=date_from, date_to=date_to,
                           status=status, leave_type=leave_type,
                           emp_search=emp_search, emp_display=emp_display,
                           tl_filter=tl_filter)

@app.route('/api/import-schedule', methods=['POST'])
def import_schedule():
    if request.headers.get('X-API-Key', '') != app.config['IMPORT_API_KEY']:
        return jsonify({'error': 'Unauthorized'}), 401
    data = request.get_json(force=True, silent=True)
    if not data or 'schedules' not in data:
        return jsonify({'error': 'Invalid payload'}), 400
    valid_days = {'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'}
    db = get_db()
    inserted, errors = 0, []
    try:
        with db.cursor() as c:
            for row in data['schedules']:
                email      = (row.get('email') or '').lower().strip()
                week_start = (row.get('week_start') or '').strip()
                off_day    = (row.get('off_day') or '').strip().capitalize()
                if not email or not week_start or off_day not in valid_days:
                    errors.append(f"Invalid row: {row}"); continue
                c.execute("SELECT emp_number FROM ohrm_user WHERE user_name = %s", (email,))
                emp = c.fetchone()
                if not emp:
                    errors.append(f"Employee not found: {email}"); continue
                c.execute("""
                    INSERT INTO leave4day_schedule (emp_number, week_start, off_day)
                    VALUES (%s, %s, %s)
                    ON DUPLICATE KEY UPDATE off_day = VALUES(off_day)
                """, (emp['emp_number'], week_start, off_day))
                inserted += 1
        db.commit()
        return jsonify({'status': 'ok', 'inserted': inserted, 'errors': errors})
    except Exception as e:
        db.rollback()
        return jsonify({'error': str(e)}), 500
    finally:
        db.close()

@app.route('/supervisor/pending')
@login_required
def supervisor_pending():
    from datetime import date as _date
    emp_number   = session['user']['emp_number']
    subordinates = get_subordinates(emp_number)
    if not subordinates and not session.get('is_admin'):
        flash('You have no subordinates assigned.', 'warning')
        return redirect(url_for('dashboard'))

    emp_search        = request.args.get('emp_search', '').strip()
    date_from         = request.args.get('date_from', _date.today().strftime('%Y-01-01'))
    date_to           = request.args.get('date_to',   _date.today().strftime('%Y-12-31'))
    tl_filter         = request.args.get('tl', '')
    leave_type_filter = request.args.get('leave_type', '')

    db = get_db()
    try:
        with db.cursor() as c:
            # TL list
            if session.get('is_admin'):
                c.execute("""SELECT DISTINCT tl FROM central_db.gsheet_employees
                             WHERE tl IS NOT NULL AND tl != '' AND status != 'Separated'
                             ORDER BY tl""")
            else:
                if subordinates:
                    fmt = ','.join(['%s'] * len(subordinates))
                    c.execute(f"""SELECT DISTINCT g.tl FROM central_db.gsheet_employees g
                                  JOIN hs_hr_employee h ON h.employee_id = g.employee_id
                                  WHERE h.emp_number IN ({fmt})
                                    AND g.tl IS NOT NULL AND g.tl != ''
                                  ORDER BY g.tl""", subordinates)
                else:
                    c.execute("SELECT DISTINCT tl FROM central_db.gsheet_employees WHERE 1=0")
            tl_list = [r['tl'] for r in c.fetchall()]

            # Build filters
            where  = ["r.status = 'pending'"]
            params = []

            if date_from:
                where.append("r.leave_date >= %s"); params.append(date_from)
            if date_to:
                where.append("r.leave_date <= %s"); params.append(date_to)
            if emp_search:
                where.append("(e.emp_firstname LIKE %s OR e.emp_lastname LIKE %s OR e.employee_id LIKE %s)")
                params += [f'%{emp_search}%', f'%{emp_search}%', f'%{emp_search}%']
            if tl_filter:
                where.append("g.tl = %s"); params.append(tl_filter)
            if leave_type_filter:
                where.append("r.leave_type_id = %s"); params.append(leave_type_filter)
            if not session.get('is_admin') and subordinates:
                fmt = ','.join(['%s'] * len(subordinates))
                where.append(f"r.emp_number IN ({fmt})")
                params += subordinates

            # Fetch leave types for filter
            c.execute("SELECT id, name FROM ohrm_leave_type ORDER BY name")
            leave_types = c.fetchall()

            # Include shift_half in select
            query = f"""
                SELECT
                    r.emp_number, r.employee_id, r.leave_type_id, MIN(r.filed_at) AS filed_at, r.notes, r.status,
                    MIN(r.id) AS id,
                    r.leave_request_id,
                    SUM(r.hours_deducted) AS hours_deducted,
                    SUM(r.days_deducted)  AS days_deducted,
                    GROUP_CONCAT(r.leave_date ORDER BY r.leave_date) AS dates,
                    GROUP_CONCAT(r.id ORDER BY r.leave_date) AS record_ids,
                    lt.name AS leave_type_name,
                    e.emp_firstname, e.emp_lastname,
                    g.tl,
                    r.shift_half
                FROM leave4day_requests r
                JOIN ohrm_leave_type lt ON r.leave_type_id = lt.id
                JOIN hs_hr_employee e   ON r.emp_number = e.emp_number
                LEFT JOIN central_db.gsheet_employees g ON g.employee_id COLLATE utf8mb4_unicode_ci = e.employee_id
                WHERE {' AND '.join(where)}
                GROUP BY r.leave_request_id, r.emp_number, r.employee_id, r.leave_type_id,
                         r.notes, r.status, lt.name, e.emp_firstname, e.emp_lastname, g.tl, r.shift_half
                ORDER BY MIN(r.leave_date) ASC
            """
            c.execute(query, params)
            pending = c.fetchall()
    finally:
        db.close()

    return render_template('supervisor/pending.html', pending=pending,
                           tl_list=tl_list, emp_search=emp_search,
                           date_from=date_from, date_to=date_to, tl_filter=tl_filter,
                           leave_types=leave_types, leave_type_filter=leave_type_filter,
                           user=session['user'], is_admin=session.get('is_admin', False))

@app.route('/supervisor/team-calendar')
@login_required
def supervisor_team_calendar():
    from datetime import date as _date
    import calendar as _cal

    emp_number   = session['user']['emp_number']
    subordinates = get_subordinates(emp_number)
    if not subordinates and not session.get('is_admin'):
        flash('You have no subordinates assigned.', 'warning')
        return redirect(url_for('dashboard'))

    today  = _date.today()
    year   = int(request.args.get('year',  today.year))
    month  = int(request.args.get('month', today.month))
    tl_filter = request.args.get('tl', '')

    # First and last day of the month
    first_day = _date(year, month, 1)
    last_day  = _date(year, month, _cal.monthrange(year, month)[1])

    db = get_db()
    try:
        with db.cursor() as c:
            # TL list
            if session.get('is_admin'):
                c.execute("""SELECT DISTINCT tl FROM central_db.gsheet_employees
                             WHERE tl IS NOT NULL AND tl != '' AND status != 'Separated'
                             ORDER BY tl""")
            else:
                if subordinates:
                    fmt = ','.join(['%s']*len(subordinates))
                    c.execute(f"""SELECT DISTINCT g.tl FROM central_db.gsheet_employees g
                                 JOIN hs_hr_employee h ON h.employee_id = g.employee_id
                                 WHERE h.emp_number IN ({fmt})
                                 AND g.tl IS NOT NULL ORDER BY g.tl""", subordinates)
                else:
                    c.execute("SELECT DISTINCT tl FROM central_db.gsheet_employees WHERE 1=0")
            tl_list = [r['tl'] for r in c.fetchall()]

            # Get leaves for the month
            where  = ["r.leave_date BETWEEN %s AND %s",
                      "r.status IN ('approved','scheduled','pending')",
                      "r.is_off_day = 0"]
            params = [first_day, last_day]

            if not session.get('is_admin') and subordinates:
                fmt = ','.join(['%s']*len(subordinates))
                where.append(f"r.emp_number IN ({fmt})")
                params += subordinates

            if tl_filter:
                where.append("g.tl = %s")
                params.append(tl_filter)

            c.execute(f"""
                SELECT r.emp_number, r.leave_date, r.status,
                       r.hours_deducted, lt.name AS leave_type,
                       e.emp_firstname, e.emp_lastname,
                       COALESCE(g.zd_name, CONCAT(e.emp_firstname,' ',e.emp_lastname)) AS display_name,
                       g.tl, g.group_name
                FROM leave4day_requests r
                JOIN ohrm_leave_type lt ON lt.id = r.leave_type_id
                JOIN hs_hr_employee e   ON e.emp_number = r.emp_number
                LEFT JOIN central_db.gsheet_employees g ON g.employee_id COLLATE utf8mb4_unicode_ci = e.employee_id
                WHERE {' AND '.join(where)}
                ORDER BY g.tl, e.emp_lastname, r.leave_date
            """, params)
            leave_rows = c.fetchall()
    finally:
        db.close()

    # Build calendar data: {date: [employee_info, ...]}
    from collections import defaultdict
    cal_data = defaultdict(list)
    for r in leave_rows:
        cal_data[r['leave_date']].append({
            'name':       r['display_name'],
            'leave_type': r['leave_type'],
            'status':     r['status'],
            'tl':         r['tl'] or '—',
        })

    # Build list of dates in month
    dates = [_date(year, month, d) for d in range(1, last_day.day + 1)]

    # Prev/next month
    if month == 1:
        prev_year, prev_month = year-1, 12
    else:
        prev_year, prev_month = year, month-1
    if month == 12:
        next_year, next_month = year+1, 1
    else:
        next_year, next_month = year, month+1

    month_name = first_day.strftime('%B %Y')

    return render_template('supervisor/team_calendar.html',
                           cal_data=cal_data, dates=dates,
                           month_name=month_name, today=today,
                           year=year, month=month,
                           prev_year=prev_year, prev_month=prev_month,
                           next_year=next_year, next_month=next_month,
                           tl_list=tl_list, tl_filter=tl_filter,
                           user=session['user'])


@app.route('/supervisor/bulk-action', methods=['POST'])
@login_required
def supervisor_bulk_action():
    emp_number   = session['user']['emp_number']
    subordinates = get_subordinates(emp_number)

    action   = request.form.get('action')
    selected = request.form.getlist('selected_leaves')  # "emp|leave_type_id|filed_at"

    if not selected:
        flash('No leaves selected.', 'warning')
        return redirect(request.form.get('next', url_for('supervisor_pending')))

    if action not in ('approve', 'reject'):
        flash('Invalid action.', 'danger')
        return redirect(request.form.get('next', url_for('supervisor_pending')))

    processed = 0
    db = get_db()

    try:
        for item in selected:
            parts = item.split('|')
            if len(parts) < 3:
                continue

            emp_raw          = parts[0]
            leave_type_id    = int(parts[1])
            filed_at         = parts[2]
            leave_request_id = parts[3] if len(parts) > 3 else None

            target_emp = resolve_emp_number(emp_raw, emp_raw)
            if not target_emp:
                continue

            if not session.get('is_admin') and target_emp not in subordinates:
                continue
            with db.cursor() as c:
                if leave_request_id:
                    c.execute("""
                        SELECT * FROM leave4day_requests
                        WHERE (emp_number = %s OR employee_id = %s)
                          AND leave_request_id = %s AND status = 'pending'
                    """, (target_emp, emp_raw, leave_request_id))
                else:
                    c.execute("""
                        SELECT * FROM leave4day_requests
                        WHERE (emp_number = %s OR employee_id = %s)
                          AND leave_type_id = %s
                          AND filed_at = %s AND status = 'pending'
                    """, (target_emp, emp_raw, leave_type_id, filed_at))

                records = c.fetchall()

                if not records:
                    continue

                total_days = sum(r['days_deducted'] for r in records)

                for r in records:
                    if action == 'approve':
                        record_status = 'scheduled' if r['leave_date'] > date.today() else 'approved'
                        ohrm_status   = 3 if r['leave_date'] <= date.today() else 2

                        c.execute("""
                            UPDATE leave4day_requests
                            SET status=%s, approver_name=%s, approved_at=NOW()
                            WHERE id=%s
                        """, (record_status, session['user']['name'], r['id']))

                        c.execute("""
                            UPDATE ohrm_leave
                            SET status=%s
                            WHERE emp_number=%s AND date=%s
                              AND leave_type_id=%s AND status=1
                        """, (ohrm_status, target_emp, r['leave_date'], leave_type_id))

                    else:
                        c.execute("""
                            UPDATE leave4day_requests
                            SET status='rejected', approver_name=%s, approved_at=NOW()
                            WHERE id=%s
                        """, (session['user']['name'], r['id']))

                        c.execute("""
                            UPDATE ohrm_leave
                            SET status=-1
                            WHERE emp_number=%s AND date=%s AND leave_type_id=%s
                        """, (target_emp, r['leave_date'], leave_type_id))

                # ✅ Reverse credits ONLY if rejected
                if action == 'reject' and total_days > 0:
                    c.execute("""
                        UPDATE ohrm_leave_entitlement
                        SET days_used = GREATEST(0, days_used - %s)
                        WHERE emp_number=%s AND leave_type_id=%s AND deleted=0
                    """, (total_days, target_emp, leave_type_id))

            db.commit()
            processed += 1

            # ✅ Notify employee
            db_mail = get_db()
            try:
                with db_mail.cursor() as c:
                    c.execute("""
                        SELECT u.user_name, e.emp_firstname
                        FROM ohrm_user u
                        JOIN hs_hr_employee e ON e.emp_number = u.emp_number
                        WHERE u.emp_number = %s
                    """, (target_emp,))
                    agent = c.fetchone()

                if agent:
                    label = 'Approved' if action == 'approve' else 'Rejected'
                    send_email(
                        agent['user_name'],
                        f'Your Leave has been {label}',
                        f"<p>Hi {agent['emp_firstname']},</p>"
                        f"<p>Your leave request has been <b>{label}</b> by {session['user']['name']}.</p>"
                    )
            finally:
                db_mail.close()

    except Exception as e:
        db.rollback()
        flash(f'Error: {e}', 'danger')
        return redirect(request.form.get('next', url_for('supervisor_pending')))
    finally:
        db.close()

    label = 'approved' if action == 'approve' else 'rejected'
    flash(f'{processed} leave request(s) {label} successfully.', 'success')
    return redirect(request.form.get('next', url_for('supervisor_pending')))


@app.route('/supervisor/active-leaves')
@login_required
def supervisor_active_leaves():
    emp_number   = session['user']['emp_number']
    subordinates = get_subordinates(emp_number)
    if not subordinates and not session.get('is_admin'):
        flash('You have no subordinates assigned.', 'warning')
        return redirect(url_for('dashboard'))

    date_from  = request.args.get('date_from', '')
    date_to    = request.args.get('date_to', '')
    status     = request.args.get('status', '')
    leave_type = request.args.get('leave_type', '')
    tl_filter  = request.args.get('tl', '')
    emp_search = request.args.get('emp_search', '')

    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("SELECT id, name FROM ohrm_leave_type ORDER BY name")
            leave_types = c.fetchall()

            if session.get('is_admin'):
                c.execute("""
                    SELECT DISTINCT tl FROM central_db.gsheet_employees
                    WHERE tl IS NOT NULL AND tl != '' AND status != 'Separated'
                    ORDER BY tl
                """)
            else:
                c.execute("""
                    SELECT DISTINCT g.tl
                    FROM central_db.gsheet_employees g
                    WHERE g.approver = %s
                      AND g.tl IS NOT NULL AND g.tl != ''
                      AND g.status != 'Separated'
                    ORDER BY g.tl
                """, (session['user']['email'],))
            tl_list = [r['tl'] for r in c.fetchall()]

            where  = ["r.status != 'cancelled'"]
            params = []

            if not session.get('is_admin'):
                fmt = ','.join(['%s'] * len(subordinates))
                where.append(f"r.emp_number IN ({fmt})")
                params.extend(subordinates)
            if date_from:
                where.append("r.leave_date >= %s")
                params.append(date_from)
            if date_to:
                where.append("r.leave_date <= %s")
                params.append(date_to)
            if status:
                where.append("r.status = %s")
                params.append(status)
            if leave_type:
                where.append("r.leave_type_id = %s")
                params.append(leave_type)
            if tl_filter:
                where.append("g.tl = %s")
                params.append(tl_filter)
            if emp_search:
                where.append("(e.emp_firstname LIKE %s OR e.emp_lastname LIKE %s OR e.employee_id LIKE %s)")
                params.extend([f'%{emp_search}%', f'%{emp_search}%', f'%{emp_search}%'])

            query = f"""
                SELECT r.*, lt.name AS leave_type_name,
                       e.emp_firstname, e.emp_lastname, e.employee_id,
                       g.tl, g.group_name
                FROM leave4day_requests r
                JOIN ohrm_leave_type lt ON r.leave_type_id = lt.id
                JOIN hs_hr_employee e   ON r.emp_number = e.emp_number
                LEFT JOIN central_db.gsheet_employees g ON g.employee_id COLLATE utf8mb4_unicode_ci = e.employee_id
                WHERE {' AND '.join(where)}
                ORDER BY r.leave_date DESC
            """
            c.execute(query, params)
            active = c.fetchall()
    finally:
        db.close()

    return render_template('supervisor/active_leaves.html', active=active,
                           user=session['user'], is_admin=session.get('is_admin', False),
                           leave_types=leave_types, tl_list=tl_list,
                           date_from=date_from, date_to=date_to,
                           status=status, leave_type=leave_type,
                           tl_filter=tl_filter, emp_search=emp_search)

@app.route('/supervisor/action', methods=['POST'])
@login_required
def supervisor_action():
    emp_number   = session['user']['emp_number']
    subordinates = get_subordinates(emp_number)

    action        = request.form.get('action')
    raw_emp       = request.form.get('target_emp')
    leave_type_id = int(request.form.get('leave_type_id'))
    filed_at      = request.form.get('filed_at')
    leave_request_id = request.form.get('leave_request_id')

    # Resolve emp_number from employee_id string or integer
    target_emp = resolve_emp_number(raw_emp, raw_emp)
    target_eid = raw_emp  # keep original employee_id string for DB query

    if not session.get('is_admin'):
        # Check authorization by emp_number if available, else skip
        if target_emp and target_emp not in subordinates:
            flash('Unauthorized action.', 'danger')
            return redirect(request.form.get('next', url_for('supervisor_pending')))

    if action not in ('approve', 'reject'):
        flash('Invalid action.', 'danger')
        return redirect(request.form.get('next', url_for('supervisor_pending')))

    db = get_db()
    try:
        with db.cursor() as c:
            # Fetch records by employee_id (string) or emp_number (int)
            if leave_request_id:
                if target_emp:
                    c.execute("""
                        SELECT * FROM leave4day_requests
                        WHERE (emp_number = %s OR employee_id = %s) AND leave_request_id = %s
                          AND status = 'pending'
                    """, (target_emp, target_eid, leave_request_id))
                else:
                    c.execute("""
                        SELECT * FROM leave4day_requests
                        WHERE employee_id = %s AND leave_request_id = %s
                          AND status = 'pending'
                    """, (target_eid, leave_request_id))
            else:
                if target_emp:
                    c.execute("""
                        SELECT * FROM leave4day_requests
                        WHERE (emp_number = %s OR employee_id = %s) AND leave_type_id = %s
                          AND filed_at = %s AND status = 'pending'
                    """, (target_emp, target_eid, leave_type_id, filed_at))
                else:
                    c.execute("""
                        SELECT * FROM leave4day_requests
                        WHERE employee_id = %s AND leave_type_id = %s
                          AND filed_at = %s AND status = 'pending'
                    """, (target_eid, leave_type_id, filed_at))

            records = c.fetchall()

            if not records:
                flash('No pending records found.', 'warning')
                return redirect(request.form.get('next', url_for('supervisor_pending')))

            total_days = sum(r['days_deducted'] for r in records)

            for r in records:
                # ✅ Determine status
                record_status = 'scheduled' if r['leave_date'] > date.today() else 'approved'
                final_status  = record_status if action == 'approve' else 'rejected'

                # ✅ Update main table
                c.execute("""
                    UPDATE leave4day_requests
                    SET status = %s, approver_name = %s, approved_at = NOW()
                    WHERE id = %s
                """, (final_status, session['user']['name'], r['id']))

                if action == 'approve':
                    # Future = SCHEDULED(2), Past/today = TAKEN(3)
                    ohrm_status = 3 if r['leave_date'] <= date.today() else 2
                    c.execute("""
                        UPDATE ohrm_leave
                        SET status = %s
                        WHERE emp_number = %s AND date = %s
                          AND leave_type_id = %s AND status = 1
                    """, (ohrm_status, target_emp, r['leave_date'], leave_type_id))
                else:
                    # Reject in OrangeHRM
                    c.execute("""
                        UPDATE ohrm_leave
                        SET status = -1
                        WHERE emp_number = %s AND date = %s AND leave_type_id = %s
                    """, (target_emp, r['leave_date'], leave_type_id))

            # ✅ Reverse credits ONCE (not per row)
            if action == 'reject' and total_days > 0:
                c.execute("""
                    UPDATE ohrm_leave_entitlement
                    SET days_used = GREATEST(0, days_used - %s)
                    WHERE emp_number = %s AND leave_type_id = %s AND deleted = 0
                """, (total_days, target_emp, leave_type_id))

        db.commit()

        flash(
            'Leave approved successfully.' if action == 'approve'
            else 'Leave rejected. Credits reversed.',
            'success'
        )

        # ✅ Notify agent
        db_mail = get_db()
        try:
            with db_mail.cursor() as c:
                c.execute("""
                    SELECT u.user_name, e.emp_firstname, e.emp_lastname
                    FROM ohrm_user u
                    JOIN hs_hr_employee e ON e.emp_number = u.emp_number
                    WHERE u.emp_number = %s
                """, (target_emp,))
                agent = c.fetchone()

            if agent:
                action_label = 'Approved' if action == 'approve' else 'Rejected'
                send_email(
                    agent['user_name'],
                    f'Your Leave has been {action_label}',
                    f"""<p>Hi {agent['emp_firstname']},</p>
                    <p>Your leave request has been <b>{action_label}</b> by your supervisor.</p>
                    <p><a href="https://hrportal.cohere.ph">View HR Portal</a></p>"""
                )
        finally:
            db_mail.close()

    except Exception as e:
        db.rollback()
        flash(f'Error: {str(e)}', 'danger')
    finally:
        db.close()

    return redirect(request.form.get('next', url_for('supervisor_pending')))

@app.route('/cancel-leave/<int:leave_id>', methods=['POST'])
@login_required
def cancel_leave(leave_id):
    emp_number = session['user']['emp_number']
    is_admin   = session.get('is_admin', False)
    db = get_db()
    try:
        with db.cursor() as c:
            # Get the leave request
            c.execute("""
                SELECT * FROM leave4day_requests WHERE id = %s
            """, (leave_id,))
            leave = c.fetchone()

            if not leave:
                flash('Leave request not found.', 'danger')
                return redirect(url_for('dashboard'))

            # Permission check
            if leave['emp_number'] != emp_number and not is_admin and not session.get('is_supervisor'):
                flash('You do not have permission to cancel this leave.', 'danger')
                return redirect(url_for('dashboard'))

            # Status check
            allowed_statuses = ['scheduled', 'pending']
            if is_admin or session.get('is_supervisor'):
                allowed_statuses += ['approved', 'taken']
            if leave['status'] not in allowed_statuses:
                flash(f'Cannot cancel a leave with status: {leave["status"]}.', 'danger')
                return redirect(url_for('dashboard'))

            # Delete from ohrm_leave
            c.execute("""
                DELETE FROM ohrm_leave
                WHERE emp_number = %s AND date = %s AND leave_type_id = %s
            """, (leave['emp_number'], leave['leave_date'], leave['leave_type_id']))

            # Delete from ohrm_leave_request if no more ohrm_leave records
            if leave.get('leave_request_id'):
                c.execute("""
                    SELECT COUNT(*) as cnt FROM ohrm_leave
                    WHERE leave_request_id = %s
                """, (leave['leave_request_id'],))
                row = c.fetchone()
                if row['cnt'] == 0:
                    c.execute("DELETE FROM ohrm_leave_request WHERE id = %s",
                              (leave['leave_request_id'],))

            # Reverse credits in ohrm_leave_entitlement
            c.execute("""
                UPDATE ohrm_leave_entitlement
                SET days_used = GREATEST(0, days_used - %s)
                WHERE emp_number = %s AND leave_type_id = %s AND deleted = 0
            """, (leave['days_deducted'], leave['emp_number'], leave['leave_type_id']))

            # Mark as cancelled in leave4day_requests
            c.execute("""
                UPDATE leave4day_requests SET status = 'cancelled' WHERE id = %s
            """, (leave_id,))

        db.commit()
        flash('Leave has been cancelled successfully.', 'success')

        # Notify agent if cancelled by someone else
        db_mail = get_db()
        try:
            with db_mail.cursor() as c:
                c.execute("""
                    SELECT u.user_name, e.emp_firstname
                    FROM ohrm_user u JOIN hs_hr_employee e ON e.emp_number = u.emp_number
                    WHERE u.emp_number = %s
                """, (leave['emp_number'],))
                agent = c.fetchone()
            if agent and agent['user_name'] != session['user']['email']:
                send_email(agent['user_name'], 'Your Leave has been Cancelled',
                    f"""<p>Hi {agent['emp_firstname']},</p>
                    <p>Your leave on <b>{leave['leave_date']}</b> has been cancelled by your supervisor/admin.</p>
                    <p><a href="https://hrportal.cohere.ph">View HR Portal</a></p>""")
        finally:
            db_mail.close()
    except Exception as e:
        db.rollback()
        flash(f'Error cancelling leave: {e}', 'danger')
    finally:
        db.close()

    return redirect(request.referrer or url_for('dashboard'))



@app.route('/admin/file-leave', methods=['GET', 'POST'])
@permission_required('can_file_for_emp')
def admin_file_leave():
    if False:
        pass
    # Load employees from gsheet_employees
    cdb_tmp = get_central_db()
    try:
        with cdb_tmp.cursor() as c:
            c.execute("""
                SELECT g.employee_id, g.schedule_name,
                       h.emp_number
                FROM gsheet_employees g
                LEFT JOIN orangehrm2.hs_hr_employee h ON h.employee_id = g.employee_id COLLATE utf8mb4_unicode_ci
                WHERE g.status NOT IN ('Separated')
                AND g.schedule_name IS NOT NULL
                ORDER BY g.schedule_name
            """)
            employees = c.fetchall()
    finally:
        cdb_tmp.close()
    balances = []
    if request.method == 'POST':
        target_emp = resolve_emp_number(request.form.get('emp_number'), request.form.get('employee_id'))
        balances, portal_balances = get_leave_balances(target_emp)

        # Just loading balances after employee selection
        if 'leave_type_id' not in request.form or not request.form.get('start_date'):
            return render_template('admin/file_leave_admin.html',
                                   employees=employees, balances=balances,
                                   selected_emp=request.form.get('employee_id', ''), user=session['user'])

        leave_type_id = int(request.form['leave_type_id'])
        start_date    = datetime.strptime(request.form['start_date'], '%Y-%m-%d').date()
        end_date      = datetime.strptime(request.form['end_date'], '%Y-%m-%d').date()
        notes         = request.form.get('notes', '').strip()

        if start_date > end_date:
            flash('Start date must be before end date.', 'danger')
            return render_template('admin/file_leave_admin.html',
                                   employees=employees, balances=balances, user=session['user'])

        duration   = request.form.get('duration', 'full')
        deductions = calculate_deduction(target_emp, start_date, end_date, duration)
        if not deductions:
            flash('No valid working days in selected range.', 'warning')
            return render_template('admin/file_leave_admin.html',
                                   employees=employees, balances=balances, user=session['user'])

        total_days  = sum(d['days'] for d in deductions)
        total_hours = sum(d['hours'] for d in deductions)
        balance     = next((b for b in balances if b['leave_type_id'] == leave_type_id), None)

        if not balance or (float(balance['remaining_days']) - total_days) < 0:
            flash('Insufficient leave balance.', 'danger')
            return render_template('admin/file_leave_admin.html',
                                   employees=employees, balances=balances, user=session['user'])

        # File the leave — same logic as regular filing, no 7-day check
        try:
            db2 = get_db()
            with db2.cursor() as c:
                now = datetime.now()
                c.execute("""
                    INSERT INTO ohrm_leave_request
                        (leave_type_id, date_applied, emp_number)
                    VALUES (%s, %s, %s)
                """, (leave_type_id, start_date, target_emp))
                leave_request_id = c.lastrowid

                # Get employee_id
                c.execute("SELECT employee_id FROM hs_hr_employee WHERE emp_number = %s", (target_emp,))
                emp_row = c.fetchone()
                emp_employee_id = emp_row['employee_id'] if emp_row else None

                for d in deductions:
                    # Auto-approve: future = SCHEDULED(2), past/today = TAKEN(3)
                    ohrm_status   = 3 if d['date'] <= date.today() else 2
                    leave4day_status = 'approved' if d['date'] <= date.today() else 'scheduled'
                    c.execute("""
                        INSERT INTO ohrm_leave
                            (date, length_hours, length_days, status,
                             emp_number, leave_type_id, leave_request_id, duration_type)
                        VALUES (%s, %s, %s, %s, %s, %s, %s, 0)
                    """, (d['date'], d['hours'], d['days'], ohrm_status,
                          target_emp, leave_type_id, leave_request_id))
                    c.execute("""
                        INSERT INTO leave4day_requests
                            (emp_number, employee_id, leave_type_id, leave_date, hours_deducted,
                             days_deducted, is_off_day, status, notes, leave_request_id)
                        VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
                    """, (target_emp, emp_employee_id, leave_type_id, d['date'], d['hours'],
                          d['days'], d['is_off_day'], leave4day_status, notes, leave_request_id))

                c.execute("""
                    UPDATE ohrm_leave_entitlement
                    SET days_used = days_used + %s
                    WHERE emp_number = %s AND leave_type_id = %s AND deleted = 0
                """, (total_days, target_emp, leave_type_id))

            db2.commit()
            flash(f'Leave filed successfully for employee.', 'success')
            return redirect(url_for('admin_all_leaves'))
        except Exception as e:
            db2.rollback()
            flash(f'Error filing leave: {e}', 'danger')
        finally:
            db2.close()

    return render_template('admin/file_leave_admin.html',
                           employees=employees, balances=balances, user=session['user'])

@app.route('/debug-approver')
@login_required
def debug_approver():
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("""
                SELECT DISTINCT approver FROM central_db.gsheet_employees
                WHERE approver IS NOT NULL AND approver != ''
            """)
            approvers = [r['approver'] for r in c.fetchall()]

            c.execute("""
                SELECT employee_id, tl, approver FROM central_db.gsheet_employees
                WHERE approver IS NOT NULL AND approver != ''
                LIMIT 5
            """)
            sample = c.fetchall()
    finally:
        db.close()
    return jsonify({
        'session_name': session['user']['name'],
        'distinct_approvers': approvers,
        'sample': [dict(r) for r in sample]
    })

def get_central_employee_id(email):
    """Map session email to central_db EmployeeID."""
    conn = get_central_db()
    cursor = conn.cursor()
    cursor.execute(
        "SELECT EmployeeID FROM Employees WHERE LOWER(Email) = %s",
        (email.lower().strip(),)
    )
    row = cursor.fetchone()
    cursor.close()
    return row['EmployeeID'] if row else None

