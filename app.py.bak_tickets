@app.route('/admin/inventory', methods=['GET', 'POST'])
@login_required
@permission_required('can_material_requests')
def admin_inventory():
    search   = request.args.get('search', '').strip()
    category = request.args.get('category', '')
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            if request.method == 'POST':
                action = request.form.get('action')

                if action == 'add':
                    c.execute("""
                        INSERT INTO inventory_items
                            (category, item_name, description, unit, current_stock,
                             min_stock_alert, max_stock, reorder_quantity, supplier, unit_cost, location)
                        VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)
                    """, (
                        request.form.get('category'),
                        request.form.get('item_name'),
                        request.form.get('description', ''),
                        request.form.get('unit', 'pcs'),
                        int(request.form.get('current_stock', 0)),
                        int(request.form.get('min_stock_alert', 5)),
                        int(request.form.get('max_stock', 0)),
                        int(request.form.get('reorder_quantity', 0)),
                        request.form.get('supplier', ''),
                        request.form.get('unit_cost') or None,
                        request.form.get('location', '')
                    ))
                    cdb.commit()
                    # Log transaction
                    item_id = c.lastrowid
                    qty = int(request.form.get('current_stock', 0))
                    if qty > 0:
                        c.execute("""
                            INSERT INTO inventory_transactions
                                (item_id, transaction_type, quantity, reference_type, notes, performed_by)
                            VALUES (%s,'in',%s,'initial','Initial stock entry',%s)
                        """, (item_id, qty, session['user']['name']))
                        cdb.commit()
                    flash('Item added successfully!', 'success')

                elif action == 'edit':
                    c.execute("""
                        UPDATE inventory_items SET
                            category=%s, item_name=%s, description=%s, unit=%s,
                            min_stock_alert=%s, max_stock=%s, reorder_quantity=%s,
                            supplier=%s, unit_cost=%s, location=%s
                        WHERE id=%s
                    """, (
                        request.form.get('category'),
                        request.form.get('item_name'),
                        request.form.get('description', ''),
                        request.form.get('unit', 'pcs'),
                        int(request.form.get('min_stock_alert', 5)),
                        int(request.form.get('max_stock', 0)),
                        int(request.form.get('reorder_quantity', 0)),
                        request.form.get('supplier', ''),
                        request.form.get('unit_cost') or None,
                        request.form.get('location', ''),
                        int(request.form.get('item_id'))
                    ))
                    cdb.commit()
                    flash('Item updated!', 'success')

                elif action == 'adjust':
                    item_id  = int(request.form.get('item_id'))
                    qty      = int(request.form.get('quantity', 0))
                    adj_type = request.form.get('adj_type', 'in')
                    notes    = request.form.get('notes', '')
                    c.execute("SELECT current_stock FROM inventory_items WHERE id=%s", (item_id,))
                    row = c.fetchone()
                    if row:
                        new_stock = row['current_stock'] + qty if adj_type == 'in' else max(0, row['current_stock'] - qty)
                        c.execute("UPDATE inventory_items SET current_stock=%s WHERE id=%s", (new_stock, item_id))
                        c.execute("""
                            INSERT INTO inventory_transactions
                                (item_id, transaction_type, quantity, reference_type, notes, performed_by)
                            VALUES (%s,%s,%s,'manual',%s,%s)
                        """, (item_id, adj_type, qty, notes, session['user']['name']))
                        cdb.commit()
                        flash(f'Stock adjusted! New stock: {new_stock}', 'success')

                elif action == 'deactivate':
                    c.execute("UPDATE inventory_items SET is_active=0 WHERE id=%s", (request.form.get('item_id'),))
                    cdb.commit()
                    flash('Item deactivated.', 'success')

                elif action == 'upload_excel':
                    import openpyxl, io
                    f_file = request.files.get('excel_file')
                    if f_file:
                        wb = openpyxl.load_workbook(io.BytesIO(f_file.read()))
                        ws = wb.active
                        count = 0
                        for row in ws.iter_rows(min_row=2, values_only=True):
                            if not row[0] or not row[1]:
                                continue
                            c.execute("""
                                INSERT INTO inventory_items
                                    (category, item_name, description, unit, current_stock,
                                     min_stock_alert, max_stock, reorder_quantity, supplier, unit_cost, location)
                                VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)
                                ON DUPLICATE KEY UPDATE
                                    description=VALUES(description), unit=VALUES(unit),
                                    current_stock=VALUES(current_stock), max_stock=VALUES(max_stock)
                            """, (
                                str(row[0]).strip(),
                                str(row[1]).strip(),
                                str(row[2]).strip() if row[2] else '',
                                str(row[3]).strip() if row[3] else 'pcs',
                                int(row[4]) if row[4] else 0,
                                int(row[5]) if row[5] else 5,
                                int(row[6]) if row[6] else 0,
                                int(row[7]) if row[7] else 0,
                                str(row[8]).strip() if row[8] else '',
                                float(row[9]) if row[9] else None,
                                str(row[10]).strip() if row[10] else ''
                            ))
                            count += 1
                        cdb.commit()
                        flash(f'Imported {count} items from Excel!', 'success')

                return redirect(url_for('admin_inventory'))

            # GET — fetch items
            sql = "SELECT * FROM inventory_items WHERE is_active=1"
            params = []
            if search:
                sql += " AND (item_name LIKE %s OR description LIKE %s OR supplier LIKE %s)"
                params += [f'%{search}%', f'%{search}%', f'%{search}%']
            if category:
                sql += " AND category=%s"
                params.append(category)
            sql += " ORDER BY category, item_name"
            c.execute(sql, params)
            items = c.fetchall()

            # Recent transactions
            c.execute("""
                SELECT t.*, i.item_name FROM inventory_transactions t
                JOIN inventory_items i ON i.id = t.item_id
                ORDER BY t.performed_at DESC LIMIT 20
            """)
            transactions = c.fetchall()

    finally:
        cdb.close()

    categories = ['IT Equipment', 'Office Supplies', 'Peripherals', 'Others', 'Events & Programs']
    return render_template('admin/inventory.html',
                           items=items, transactions=transactions,
                           categories=categories, search=search,
                           category=category, user=session['user'])


@app.route('/api/inventory-items')
@login_required
def api_inventory_items():
    """Returns active inventory items for material request dropdown."""
    category = request.args.get('category', '')
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            if category:
                c.execute("""
                    SELECT id, item_name, current_stock, min_stock_alert, unit
                    FROM inventory_items
                    WHERE is_active=1 AND category=%s
                    ORDER BY item_name
                """, (category,))
            else:
                c.execute("""
                    SELECT id, item_name, current_stock, min_stock_alert, unit, category
                    FROM inventory_items
                    WHERE is_active=1
                    ORDER BY category, item_name
                """)
            items = c.fetchall()
    finally:
        cdb.close()
    return jsonify([{
        'id': r['id'],
        'item_name': r['item_name'],
        'current_stock': r['current_stock'],
        'min_stock_alert': r['min_stock_alert'],
        'unit': r['unit'],
        'low_stock': r['current_stock'] <= r['min_stock_alert']
    } for r in items])


# ── Material Requests ────────────────────────────────────────────────
MATERIAL_ADMIN_EMAIL  = os.getenv('MATERIAL_ADMIN_EMAIL', 'andrewvincentt@gmail.com')
MATERIAL_FINAL_EMAIL  = os.getenv('MATERIAL_FINAL_EMAIL', 'andrew.tacdoro@cohere.ph')
MATERIAL_CATEGORIES   = ['IT Equipment', 'Office Supplies', 'Peripherals', 'Others', 'Events & Programs']

def get_material_admin_emails():
    """Get all emails of users with can_material_requests permission + MATERIAL_ADMIN_EMAIL."""
    emails = set()
    if MATERIAL_ADMIN_EMAIL:
        emails.add(MATERIAL_ADMIN_EMAIL)
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("""
                SELECT u.user_name FROM leave4day_sub_admins sa
                JOIN ohrm_user u ON u.emp_number = sa.emp_number
                WHERE sa.can_material_requests = 1 AND u.deleted = 0
            """)
            for row in c.fetchall():
                if row['user_name']:
                    emails.add(row['user_name'].lower())
    finally:
        db.close()
    return list(emails)



def get_material_final_emails():
    """Get all emails of users with can_final_approval permission."""
    emails = set()
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("""
                SELECT u.user_name FROM leave4day_sub_admins sa
                JOIN ohrm_user u ON u.emp_number = sa.emp_number
                WHERE sa.can_final_approval = 1 AND u.deleted = 0
            """)
            for row in c.fetchall():
                if row['user_name']:
                    emails.add(row['user_name'].lower())
    finally:
        db.close()
    return list(emails)

def send_material_email(to, subject, body_html):
    """Send email for material request notifications."""
    try:
        from email.mime.multipart import MIMEMultipart
        from email.mime.text import MIMEText
        msg = MIMEMultipart('alternative')
        msg['Subject'] = subject
        msg['From']    = f"Cohere HR Portal — Material Requests <{os.getenv('SMTP_USER')}>"
        msg['To']      = to
        msg.attach(MIMEText(body_html, 'html'))
        with smtplib.SMTP(os.getenv('SMTP_SERVER'), int(os.getenv('SMTP_PORT', 2525))) as s:
            s.login(os.getenv('SMTP_USER'), os.getenv('SMTP_PASSWORD'))
            s.sendmail(os.getenv('SMTP_USER'), [to], msg.as_string())
    except Exception as e:
        app.logger.warning(f'material email failed: {e}')


@app.route('/file-requests/material/edit/<group_id>', methods=['GET', 'POST'])
@login_required
def material_edit(group_id):
    employee_id = session['user'].get('employee_id', '')
    is_admin    = session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            # Fetch all items in this group
            c.execute("""
                SELECT * FROM material_requests
                WHERE request_group_id = %s AND deleted_at IS NULL
                ORDER BY id
            """, (group_id,))
            items = c.fetchall()
        if not items:
            flash('Request not found.', 'danger')
            return redirect(url_for('file_material'))
        # Permission check — employee can only edit their own
        if not is_admin and items[0]['employee_id'] != employee_id:
            flash('You do not have permission to edit this request.', 'danger')
            return redirect(url_for('file_material'))
        # Block editing if already at final approval or beyond
        blocked_statuses = ('Released', 'Rejected')
        if items[0]['status'] in blocked_statuses:
            flash(f'This request cannot be edited at status: {items[0]["status"]}.', 'warning')
            return redirect(url_for('file_material'))
        if request.method == 'POST':
            item_ids    = request.form.getlist('item_id[]')
            item_names  = request.form.getlist('item_name[]')
            quantities  = request.form.getlist('quantity[]')
            unit_costs  = request.form.getlist('unit_cost[]')
            purchase_totals = request.form.getlist('purchase_total[]')
            reason      = request.form.get('reason', '').strip()
            date_needed = request.form.get('date_needed', '').strip() or None
            editor_name = session['user']['name']
            editor_id   = session['user'].get('employee_id', '')
            changes = []
            with cdb.cursor() as c:
                for i, item_id in enumerate(item_ids):
                    iname = item_names[i].strip() if i < len(item_names) else ''
                    qty   = max(1, int(quantities[i] or 1)) if i < len(quantities) else 1
                    if iname:
                        # Get old values for comparison
                        c.execute("SELECT item_name, quantity, reason, date_needed, purchase_unit_cost, purchase_total FROM material_requests WHERE id=%s", (item_id,))
                        old_row = c.fetchone()
                        if old_row:
                            if old_row['item_name'] != iname:
                                changes.append(f"Item name: '{old_row['item_name']}' → '{iname}'")
                            if int(old_row['quantity']) != qty:
                                changes.append(f"Quantity: {old_row['quantity']} → {qty}")
                            old_reason = old_row['reason'] or ''
                            if old_reason != reason:
                                changes.append(f"Reason: '{old_reason}' → '{reason}'")
                            old_date = old_row['date_needed'].strftime('%Y-%m-%d') if old_row['date_needed'] else ''
                            new_date = date_needed or ''
                            if old_date != new_date:
                                changes.append(f"Date needed: '{old_date or 'N/A'}' → '{new_date or 'N/A'}'")
                        unit_cost = float(unit_costs[i] or 0) if i < len(unit_costs) else None
                        pur_total = float(purchase_totals[i] or 0) if i < len(purchase_totals) else None
                        if unit_cost is not None and unit_cost != float(old_row.get('purchase_unit_cost') or 0):
                            changes.append(f"Unit Cost: {old_row.get('purchase_unit_cost') or 0} -> {unit_cost}")
                        c.execute("""
                            UPDATE material_requests
                            SET item_name=%s, quantity=%s, reason=%s, date_needed=%s,
                                purchase_unit_cost=%s, purchase_total=%s
                            WHERE id=%s AND request_group_id=%s
                        """, (iname, qty, reason, date_needed,
                                unit_cost or None, pur_total or None,
                                item_id, group_id))
            details = "; ".join(changes) if changes else "No changes detected"
            with cdb.cursor() as c:
                c.execute("""
                    INSERT INTO material_request_logs
                        (request_group_id, action, performed_by, performed_by_id, details)
                    VALUES (%s, %s, %s, %s, %s)
                """, (group_id, 'edit', editor_name, editor_id, details))
            cdb.commit()
            flash('Request updated successfully.', 'success')
            if is_admin:
                return redirect(url_for('material_admin_review'))
            return redirect(url_for('file_material'))
        with cdb.cursor() as c:
            c.execute("""
                SELECT * FROM material_request_logs
                WHERE request_group_id = %s
                ORDER BY created_at DESC
            """, (group_id,))
            logs = c.fetchall()
    finally:
        cdb.close()
    return render_template('file_requests/material_edit.html',
                           items=items, group_id=group_id, logs=logs, user=session['user'])


@app.route('/file-requests/material', methods=['GET', 'POST'])
@login_required
def file_material():
    email       = session['user']['email']
    employee_id = get_central_employee_id(email)
    emp_name    = session['user']['name']
    error = success = None

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            if request.method == "POST":
                categories_list = request.form.getlist("category[]")
                item_names_list = request.form.getlist("item_name[]")
                quantities_list = request.form.getlist("quantity[]")
                reason      = request.form.get("reason","").strip()
                date_needed = request.form.get("date_needed","").strip() or None
                items = [(cat.strip(), iname.strip(), max(1, int(qty or 1)))
                         for cat, iname, qty in zip(categories_list, item_names_list, quantities_list)
                         if cat.strip() and iname.strip()]
                if not items:
                    error = "At least one item with category and name is required."
                else:
                    import uuid as _uuid
                    group_id = str(_uuid.uuid4())
                    items_html = "".join(f"<li><b>{cat}</b> - {iname} (x{qty})</li>" for cat, iname, qty in items)
                    for cat, iname, qty in items:
                        c.execute("""
                            INSERT INTO material_requests
                                (employee_id, employee_name, request_group_id, category, item_name,
                                 quantity, reason, date_needed, status)
                            VALUES (%s,%s,%s,%s,%s,%s,%s,%s,"Pending")
                        """, (employee_id, emp_name, group_id, cat, iname, qty, reason, date_needed))
                    cdb.commit()
                    sup_email = get_supervisor_email(session["user"]["emp_number"])
                    if sup_email:
                        body = (f"<p><b>{emp_name}</b> filed a material request:</p><ul>{items_html}</ul>"
                                f"<p><b>Reason:</b> {reason or chr(8212)}</p>"
                                f"<p><b>Date Needed:</b> {date_needed or chr(8212)}</p>"
                                "<p><a href='https://hrportal.cohere.ph/file-requests/material/som-approvals'>Review here</a></p>")
                        send_material_email(sup_email, f"[Material Request] New Request from {emp_name}", body)
                    success = f"{len(items)} item(s) submitted. Your supervisor has been notified."

            c.execute("""SELECT * FROM material_requests
                         WHERE employee_id=%s AND deleted_at IS NULL
                         ORDER BY created_at DESC LIMIT 50""", (employee_id,))
            history = c.fetchall()
    finally:
        cdb.close()

    return render_template('file_requests/material.html',
                           categories=MATERIAL_CATEGORIES, history=history,
                           error=error, success=success, user=session['user'])


@app.route('/file-requests/material/som-approvals')
@login_required
def material_som_approvals():
    if not (session.get('is_supervisor') or session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))

    user_email = session['user']['email']
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            if session.get('is_admin'):
                c.execute("""SELECT * FROM material_requests
                             WHERE deleted_at IS NULL
                             ORDER BY FIELD(status,'Pending','Recommended','Rejected'), created_at DESC""")
            else:
                # Get employee IDs under this supervisor (regular assignments)
                sub_ids = get_supervisor_central_employees(user_email) or []
                # Also get employees with material-specific override to this supervisor
                c.execute("""SELECT employee_id FROM material_supervisor_overrides
                              WHERE supervisor_email=%s""", (user_email,))
                override_ids = [r['employee_id'] for r in c.fetchall()]
                # Merge and deduplicate
                all_ids = list(set(sub_ids + override_ids))
                if not all_ids:
                    requests_ = []
                else:
                    ph = ','.join(['%s'] * len(all_ids))
                    c.execute(f"""SELECT * FROM material_requests
                                  WHERE employee_id IN ({ph}) AND deleted_at IS NULL
                                  ORDER BY FIELD(status,'Pending','Recommended','Rejected'), created_at DESC""",
                              all_ids)
            requests_ = c.fetchall()
    finally:
        cdb.close()

    return render_template('file_requests/material_som.html',
                           requests=requests_, user=session['user'])


@app.route('/file-requests/material/som-action', methods=['POST'])
@login_required
def material_som_action():
    if not (session.get('is_supervisor') or session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))

    req_id   = int(request.form.get('req_id'))
    action   = request.form.get('action')
    remarks  = request.form.get('remarks','').strip()

    new_status = 'Recommended' if action == 'recommend' else 'Rejected'

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("""UPDATE material_requests
                         SET status=%s, som_name=%s, som_action_at=NOW(), som_remarks=%s
                         WHERE id=%s AND status='Pending'""",
                      (new_status, session['user']['name'], remarks, req_id))
            if new_status == 'Recommended':
                # Fetch request details for admin email
                c.execute("SELECT * FROM material_requests WHERE id=%s", (req_id,))
                req = c.fetchone()
        cdb.commit()

        if new_status == 'Recommended' and req:
            for admin_email in get_material_admin_emails():
              send_material_email(
                admin_email,
                f"Material Request Recommended — {req['employee_name']}",
                f"""<p><b>{req['employee_name']}</b>'s material request has been recommended by <b>{session['user']['name']}</b>:</p>
                <ul>
                  <li><b>Category:</b> {req['category']}</li>
                  <li><b>Item:</b> {req['item_name']} (x{req['quantity']})</li>
                  <li><b>Reason:</b> {req['reason'] or '—'}</li>
                  <li><b>Date Needed:</b> {req['date_needed'] or '—'}</li>
                  <li><b>SOM Remarks:</b> {remarks or '—'}</li>
                </ul>
                <p>Please <a href="https://hrportal.cohere.ph/file-requests/material/admin-review">click here</a> to process this request.</p>"""
              )
    finally:
        cdb.close()

    flash(f'Request {new_status.lower()} successfully.', 'success')
    return redirect(url_for('material_som_approvals'))


@app.route('/api/material-requests-pending-count')
@login_required
def material_requests_pending_count():
    is_supervisor = session.get('is_supervisor')
    is_admin      = session.get('is_admin')
    if not (is_supervisor or is_admin):
        return jsonify({'count': 0})

    user_email = session['user']['email']
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            if is_admin:
                c.execute("""SELECT COUNT(*) as cnt FROM material_requests
                             WHERE status='Pending' AND deleted_at IS NULL""")
            else:
                sub_ids = get_supervisor_central_employees(user_email) or []
                if not sub_ids:
                    return jsonify({'count': 0})
                ph = ','.join(['%s'] * len(sub_ids))
                c.execute(f"""SELECT COUNT(*) as cnt FROM material_requests
                              WHERE status='Pending' AND deleted_at IS NULL
                              AND employee_id IN ({ph})""", sub_ids)
            count = c.fetchone()['cnt']
    finally:
        cdb.close()
    return jsonify({'count': count})


