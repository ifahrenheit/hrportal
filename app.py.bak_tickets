def get_db_connection():
    """Main app DB — central_db (gsheet_employees, Employees, etc.)"""
    return pymysql.connect(
        host=os.environ.get('MAIN_DB_HOST', 'localhost'),
        port=int(os.environ.get('MAIN_DB_PORT', 3306)),
        user=os.environ.get('MAIN_DB_USER', 'employee_sync'),
        password=os.environ.get('MAIN_DB_PASSWORD', '***REMOVED***'),
        database=os.environ.get('MAIN_DB_NAME', 'central_db'),
        charset='utf8mb4',
        cursorclass=pymysql.cursors.DictCursor,
        autocommit=False
    )

def get_db():
    return pymysql.connect(
        host=app.config['DB_HOST'],
        user=app.config['DB_USER'],
        password=app.config['DB_PASSWORD'],
        database=app.config['DB_NAME'],
        cursorclass=pymysql.cursors.DictCursor,
        autocommit=False
    )

def get_central_db():
    return pymysql.connect(
        host=app.config["DB_HOST"],
        user=app.config["DB_USER"],
        password=app.config["DB_PASSWORD"],
        database="central_db",
        cursorclass=pymysql.cursors.DictCursor,
        autocommit=False
    )

def _send_email_worker(to, subject, body):
    try:
        msg = MIMEMultipart('alternative')
        msg['Subject'] = subject
        msg['From']    = f"{os.getenv('SMTP_FROM_NAME', 'Leave Management System')} <{os.getenv('SMTP_USER')}>"
        msg['To']      = to
        msg.attach(MIMEText(body, 'html'))
        with smtplib.SMTP(os.getenv('SMTP_SERVER'), int(os.getenv('SMTP_PORT', 2525)), timeout=10) as smtp:
            smtp.login(os.getenv('SMTP_USER'), os.getenv('SMTP_PASSWORD'))
            smtp.sendmail(os.getenv('SMTP_USER'), to, msg.as_string())
    except Exception as e:
        print(f"Email error: {e}")

def send_email(to, subject, body):
    import threading
    threading.Thread(target=_send_email_worker, args=(to, subject, body), daemon=True).start()

def get_supervisor_email(emp_number):
    db = get_db()
    try:
        with db.cursor() as c:
            # Step 1: Check leave4day_supervisor_assignments override (by employee_id)
            c.execute("""
                SELECT sa.sup_employee_id,
                       COALESCE(g.email, u.user_name) AS supervisor_email
                FROM leave4day_supervisor_assignments sa
                LEFT JOIN central_db.gsheet_employees g ON g.employee_id = sa.sup_employee_id COLLATE utf8mb4_unicode_ci
                LEFT JOIN hs_hr_employee he ON he.employee_id = sa.sup_employee_id COLLATE utf8mb4_unicode_ci
                LEFT JOIN ohrm_user u ON u.emp_number = he.emp_number
                WHERE sa.emp_number = %s LIMIT 1
            """, (emp_number,))
            row = c.fetchone()
            if row and row['supervisor_email']:
                return row['supervisor_email']

            # Step 2: Use gsheet_employees.approver (SOM email)
            c.execute("""
                SELECT g.approver FROM central_db.gsheet_employees g
                JOIN hs_hr_employee h ON h.employee_id = g.employee_id COLLATE utf8mb4_unicode_ci
                WHERE h.emp_number = %s
                AND g.approver IS NOT NULL AND g.approver != ''
                LIMIT 1
            """, (emp_number,))
            row = c.fetchone()
            if row and row['approver']:
                return row['approver']

            # Step 3: Fallback to OrangeHRM reportto
            c.execute("""
                SELECT u.user_name FROM hs_hr_emp_reportto r
                JOIN ohrm_user u ON u.emp_number = r.erep_sup_emp_number
                WHERE r.erep_sub_emp_number = %s LIMIT 1
            """, (emp_number,))
            row = c.fetchone()
            return row['user_name'] if row else None
    finally:
        db.close()

def login_required(f):
    @wraps(f)
    def decorated(*args, **kwargs):
        if 'user' not in session:
            return redirect(url_for('login'))
        return f(*args, **kwargs)
    return decorated

def has_permission(perm):
    if session.get('is_admin'):
        return True
    return session.get('permissions', {}).get(perm, False)

def admin_required(f):
    @wraps(f)
    def decorated(*args, **kwargs):
        if 'user' not in session:
            return redirect(url_for('login'))
        if not session.get('is_admin'):
            flash('Admin access required.', 'danger')
            return redirect(url_for('dashboard'))
        return f(*args, **kwargs)
    return decorated

def permission_required(perm):
    def decorator(f):
        @wraps(f)
        def decorated(*args, **kwargs):
            if not session.get('user'):
                return redirect(url_for('login'))
            if not session.get('is_admin') and not session.get('permissions', {}).get(perm, False):
                flash('You do not have permission to access this page.', 'danger')
                return redirect(url_for('dashboard'))
            return f(*args, **kwargs)
        return decorated
    return decorator

def get_employee_by_email(email):
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("""
                SELECT u.emp_number, u.user_role_id,
                       e.emp_firstname, e.emp_lastname, e.employee_id
                FROM ohrm_user u
                JOIN hs_hr_employee e ON u.emp_number = e.emp_number
                WHERE u.user_name = %s
            """, (email,))
            return c.fetchone()
    finally:
        db.close()

def get_leave_balances(emp_number):
    """Returns (ohrm_balances, portal_balances) — always both sources."""
    db = get_db()
    try:
        with db.cursor() as c:
            # OrangeHRM balances
            c.execute("""
                SELECT lt.id AS leave_type_id, lt.name AS leave_type_name,
                       le.no_of_days * 8 AS total_hours,
                       COALESCE((
                           SELECT SUM(r.hours_deducted)
                           FROM leave4day_requests r
                           WHERE r.emp_number = le.emp_number
                             AND r.leave_type_id = le.leave_type_id
                             AND r.status NOT IN ('rejected', 'cancelled', 'Deleted')
                             AND r.is_off_day = 0
                             AND YEAR(r.leave_date) = YEAR(CURDATE())
                       ), 0) AS used_hours
                FROM ohrm_leave_entitlement le
                JOIN ohrm_leave_type lt ON lt.id = le.leave_type_id
                WHERE le.emp_number = %s AND le.deleted = 0
                  AND YEAR(le.from_date) = YEAR(CURDATE())
                ORDER BY lt.name
            """, (emp_number,))
            ohrm_rows = c.fetchall()

            # Portal DB balances
            c.execute("""
                SELECT lt.id AS leave_type_id, lt.name AS leave_type_name,
                       e.no_of_days * 8 AS total_hours,
                       e.days_used * 8 AS used_hours
                FROM leave4day_entitlements e
                JOIN leave4day_leave_types lt ON lt.id = e.leave_type_id
                WHERE e.emp_number = %s
                  AND YEAR(e.from_date) = YEAR(CURDATE())
                  AND lt.is_active = 1
                ORDER BY lt.name
            """, (emp_number,))
            portal_rows = c.fetchall()

        def build(rows):
            out = []
            for r in rows:
                total = float(r['total_hours'])
                used  = float(r['used_hours'])
                remaining = max(total - used, 0)
                out.append({
                    'leave_type_id':   r['leave_type_id'],
                    'leave_type_name': r['leave_type_name'],
                    'total_hours':     total,
                    'used_hours':      used,
                    'remaining_hours': remaining,
                    'remaining_days':  round(remaining / 8, 2),
                })
            return out

        return build(ohrm_rows), build(portal_rows)
    finally:
        db.close()

def is_holiday(target_date):
    db = get_db()
    try:
        with db.cursor() as c:
            # Check OrangeHRM holidays
            c.execute("""
                SELECT id FROM ohrm_holiday 
                WHERE date = %s
                   OR (recurring = 1 AND MONTH(date) = %s AND DAY(date) = %s)
            """, (target_date, target_date.month, target_date.day))
            if c.fetchone():
                return True
            # Check own holidays
            c.execute("""
                SELECT id FROM leave4day_holidays
                WHERE date = %s
                   OR (recurring = 1 AND MONTH(date) = %s AND DAY(date) = %s)
            """, (target_date, target_date.month, target_date.day))
            return c.fetchone() is not None
    finally:
        db.close()

def get_sub_admin_permissions(emp_number):
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("SELECT * FROM leave4day_sub_admins WHERE emp_number = %s", (emp_number,))
            row = c.fetchone()
            if not row:
                return None
            return {
                'can_all_leaves':   bool(row['can_all_leaves']),
                'can_approve':      bool(row['can_approve']),
                'can_file_for_emp': bool(row['can_file_for_emp']),
                'can_schedules':    bool(row['can_schedules']),
                'can_reports':      bool(row['can_reports']),
                'can_absences':     bool(row.get('can_absences', 0)),
                'can_work_mode':    bool(row['can_work_mode']),
                'can_settings':     bool(row['can_settings']),
                'can_entitlements': bool(row['can_entitlements']),
                'can_file_requests': bool(row['can_file_requests']),
                'can_material_requests': bool(row['can_material_requests']),
                'can_final_approval': bool(row['can_final_approval']),
                'can_view_tickets': bool(row.get('can_view_tickets', 0)),
                'can_facilities_review': bool(row.get('can_facilities_review', 0)),
                'can_facilities_final': bool(row.get('can_facilities_final', 0)),
                'can_view_approved_items': bool(row.get('can_view_approved_items', 0)),
                'can_onboarding': bool(row.get('can_onboarding', 0)),
            }
    finally:
        db.close()

def get_entitlement_source():
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("SELECT setting_value FROM leave4day_settings WHERE setting_key = 'entitlement_source'")
            row = c.fetchone()
            return row['setting_value'] if row else 'orangehrm'
    finally:
        db.close()

def get_work_mode(emp_number=None):
    db = get_db()
    try:
        with db.cursor() as c:
            # Check per-employee setting first
            if emp_number:
                c.execute("SELECT work_mode FROM leave4day_emp_settings WHERE emp_number = %s", (emp_number,))
                row = c.fetchone()
                if row:
                    return row['work_mode']
            # Fall back to global setting
            c.execute("SELECT setting_value FROM leave4day_settings WHERE setting_key = 'work_mode'")
            row = c.fetchone()
            return row['setting_value'] if row else '4day'
    finally:
        db.close()

def get_off_day(emp_number, target_date):
    import calendar
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("""
                SELECT employee_id FROM hs_hr_employee WHERE emp_number = %s
            """, (emp_number,))
            row = c.fetchone()
            if not row:
                return None
            employee_id = row['employee_id']

            c.execute("""
                SELECT is_rest_day FROM central_db.employee_schedules
                WHERE employee_id = %s AND schedule_date = %s
            """, (employee_id, target_date))
            sched = c.fetchone()

            if sched is not None:
                return calendar.day_name[target_date.weekday()] if sched['is_rest_day'] == 1 else None

            # Fallback to leave4day_schedule
            week_start = target_date - timedelta(days=target_date.weekday())
            c.execute("""
                SELECT off_day FROM leave4day_schedule
                WHERE emp_number = %s AND week_start = %s
            """, (emp_number, week_start))
            row = c.fetchone()
            return row['off_day'] if row else None
    finally:
        db.close()

# Leave types that require 7-day advance notice
ADVANCE_NOTICE_TYPES = {'Vacation Leave', 'Carry-Over Leave'}
ADVANCE_NOTICE_DAYS  = 7

def check_advance_notice(leave_type_name, dates):
    """
    Returns list of dates that violate the advance notice rule.
    Only applies to Vacation Leave and Carry-Over Leave.
    """
    if leave_type_name not in ADVANCE_NOTICE_TYPES:
        return []
    min_date = date.today() + timedelta(days=ADVANCE_NOTICE_DAYS)
    return [d for d in dates if d < min_date]

def get_subordinates(supervisor_emp_number):
    db = get_db()
    try:
        with db.cursor() as c:
            # Override assignments
            c.execute("""
                SELECT emp_number FROM leave4day_supervisor_assignments
                WHERE supervisor_emp = %s
            """, (supervisor_emp_number,))
            overrides = [row['emp_number'] for row in c.fetchall()]
            # OrangeHRM assignments (exclude those already overridden to someone else)
            c.execute("""
                SELECT r.erep_sub_emp_number AS emp_number
                FROM hs_hr_emp_reportto r
                WHERE r.erep_sup_emp_number = %s
                AND r.erep_sub_emp_number NOT IN (
                    SELECT emp_number FROM leave4day_supervisor_assignments
                )
            """, (supervisor_emp_number,))
            ohrm = [row['emp_number'] for row in c.fetchall()]
            return list(set(overrides + ohrm))
    finally:
        db.close()

def is_supervisor(emp_number):
    return len(get_subordinates(emp_number)) > 0

DAY_NAMES          = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
HOURS_PER_4DAY     = 10
OHRM_HOURS_PER_DAY = 8

def calculate_deduction(emp_number, start_date, end_date, duration='full'):
    results = []
    current = start_date
    while current <= end_date:
        day_name = DAY_NAMES[current.weekday()]

        # Always skip public holidays
        if is_holiday(current):
            current += timedelta(days=1)
            continue

        work_mode = get_work_mode(emp_number)

        if work_mode == '5day':
            off_day = get_off_day(emp_number, current)
            if off_day is not None:
                current += timedelta(days=1)
                continue
            if current.weekday() >= 5:
                db_ohrm = get_db()
                try:
                    with db_ohrm.cursor() as _c:
                        _c.execute("SELECT employee_id FROM hs_hr_employee WHERE emp_number = %s", (emp_number,))
                        _row = _c.fetchone()
                        _eid = _row['employee_id'] if _row else None
                finally:
                    db_ohrm.close()
                has_entry = None
                if _eid:
                    db_chk = get_central_db()
                    try:
                        with db_chk.cursor() as _c:
                            _c.execute("SELECT id FROM employee_schedules WHERE employee_id = %s AND schedule_date = %s AND is_rest_day = 0", (_eid, current))
                            has_entry = _c.fetchone()
                    finally:
                        db_chk.close()
                if not has_entry:
                    current += timedelta(days=1)
                    continue
            is_off   = False
            full_hrs = 8
            half_hrs = 4
        else:
            off_day  = get_off_day(emp_number, current)
            is_off   = (off_day is not None)
            full_hrs = 0 if is_off else HOURS_PER_4DAY
            half_hrs = 0 if is_off else 5

        if is_off:
            hours = 0
            days  = 0.0
            note  = "Off-day — 0 hrs deducted"
        elif duration == 'first_half':
            hours = half_hrs
            days  = round(half_hrs / OHRM_HOURS_PER_DAY, 4)
            note  = f"1st Half of the Shift — {half_hrs} hrs deducted"
        elif duration == 'second_half':
            hours = half_hrs
            days  = round(half_hrs / OHRM_HOURS_PER_DAY, 4)
            note  = f"2nd Half of the Shift — {half_hrs} hrs deducted"
        else:
            hours = full_hrs
            days  = round(full_hrs / OHRM_HOURS_PER_DAY, 4)
            note  = f"Working day — {full_hrs} hrs deducted"

        results.append({'date': current, 'day_name': day_name, 'is_off_day': is_off,
                        'hours': hours, 'days': days, 'note': note})
        current += timedelta(days=1)
    return results

def get_supervisor_central_employees(supervisor_email):
    """
    Return list of central_db EmployeeIDs managed by this supervisor.
    Mirrors the same two-step lookup as get_supervisor_email:
      1. leave4day_supervisor_assignments (override table in orangehrm2)
      2. hs_hr_emp_reportto (OrangeHRM default)
    Then maps emp_numbers back to central_db EmployeeIDs via Email.
    """
    sup_email = supervisor_email.lower().strip()
    emp_numbers = []

    # ── Step 1: find supervisor's emp_number from ohrm_user ──
    db = get_db()  # orangehrm2
    try:
        with db.cursor() as c:
            c.execute(
                "SELECT emp_number FROM ohrm_user WHERE LOWER(user_name) = %s LIMIT 1",
                (sup_email,)
            )
            row = c.fetchone()
            if not row:
                return []
            sup_emp_number = row['emp_number']

            # ── Step 2a: override assignments ──────────────
            c.execute(
                """SELECT emp_number FROM leave4day_supervisor_assignments
                   WHERE supervisor_emp = %s""",
                (sup_emp_number,)
            )
            overrides = [r['emp_number'] for r in c.fetchall()]

            # ── Step 2b: OrangeHRM default reportto ────────
            c.execute(
                """SELECT erep_sub_emp_number AS emp_number
                   FROM hs_hr_emp_reportto
                   WHERE erep_sup_emp_number = %s""",
                (sup_emp_number,)
            )
            defaults = [r['emp_number'] for r in c.fetchall()]

            # Override takes priority; merge both lists deduplicated
            seen = set(overrides)
            emp_numbers = list(overrides)
            for e in defaults:
                if e not in seen:
                    emp_numbers.append(e)
                    seen.add(e)

            if not emp_numbers:
                return []


            # Step 3: map emp_numbers -> employee_id directly (no email dependency)
            placeholders = ','.join(['%s'] * len(emp_numbers))
            c.execute(
                f"""SELECT employee_id FROM hs_hr_employee
                    WHERE emp_number IN ({placeholders})
                    AND employee_id IS NOT NULL AND employee_id != ''""",
                emp_numbers
            )
            return [r['employee_id'] for r in c.fetchall()]
    finally:
        db.close()

def resolve_emp_number(emp_number=None, employee_id=None):
    """
    Accepts either emp_number (int) or employee_id (string like '260105-23').
    Returns the correct OrangeHRM emp_number as int.
    """
    val = emp_number or employee_id
    if not val:
        return None

    # Try as integer first (OrangeHRM emp_number)
    try:
        return int(val)
    except (ValueError, TypeError):
        pass

    # Try as employee_id string lookup
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("""
                SELECT emp_number FROM hs_hr_employee
                WHERE employee_id = %s LIMIT 1
            """, (str(val),))
            row = c.fetchone()
            return row['emp_number'] if row else None
    finally:
        db.close()

def notify_file_request(emp_number, request_type, details_html):
    """Send confirmation to employee and notification to supervisor."""
    agent_email = session['user']['email']
    agent_name  = session['user']['name']

    # Email to employee
    send_email(
        agent_email,
        f'{request_type} Request Filed Successfully',
        f"""<p>Hi {agent_name},</p>
        <p>Your <b>{request_type}</b> request has been filed and is awaiting approval.</p>
        {details_html}
        <p><a href="https://hrportal.cohere.ph">View HR Portal</a></p>"""
    )

    # Email to supervisor
    sup_email = get_supervisor_email(emp_number)
    if sup_email:
        send_email(
            sup_email,
            f'{request_type} Request from {agent_name}',
            f"""<p>Hi,</p>
            <p><b>{agent_name}</b> has filed a <b>{request_type}</b> request
            awaiting your approval.</p>
            {details_html}
            <p><a href="https://hrportal.cohere.ph/file-requests/approvals">
            Approve / Reject on HR Portal</a></p>"""
        )

@app.route('/')
def index():
    if 'user' in session:
        return redirect(url_for('dashboard'))
    return render_template('login.html')

@app.route('/login')
def login():
    redirect_uri = url_for('auth_callback', _external=True)
    return keycloak.authorize_redirect(redirect_uri)

@app.route('/auth/callback')
def auth_callback():
    try:
        token = keycloak.authorize_access_token()
    except Exception as e:
        if 'mismatching_state' in str(e).lower() or 'mismatchingstate' in str(type(e).__name__).lower():
            session.clear()
            flash('Session expired. Please log in again.', 'warning')
            return redirect(url_for('login'))
        raise
    userinfo = token.get('userinfo', {})
    email    = userinfo.get('email', '').lower().strip()
    employee = get_employee_by_email(email)

    if not employee:
        # Fallback: check gsheet_employees
        cdb = get_central_db()
        try:
            with cdb.cursor() as c:
                c.execute("""SELECT employee_id, schedule_name, email, status
                             FROM gsheet_employees
                             WHERE LOWER(email) = %s AND status != 'Separated'
                             LIMIT 1""", (email,))
                gs_emp = c.fetchone()
        finally:
            cdb.close()

        if not gs_emp:
            flash('Your account was not found. Please contact HR.', 'danger')
            return redirect(url_for('index'))

        # Check if portal user already exists
        db_p = get_db()
        try:
            with db_p.cursor() as c:
                c.execute("SELECT * FROM leave4day_portal_users WHERE email = %s", (email,))
                portal_user = c.fetchone()
                if not portal_user:
                    # Auto-provision portal user with negative emp_number
                    c.execute("SELECT MIN(emp_number) as min_emp FROM leave4day_portal_users")
                    row = c.fetchone()
                    min_emp = row['min_emp'] if row['min_emp'] else 0
                    new_emp = min(min_emp - 1, -1000)
                    name_parts = (gs_emp['schedule_name'] or email.split('@')[0]).split()
                    firstname = name_parts[0] if name_parts else email.split('@')[0]
                    lastname  = ' '.join(name_parts[1:]) if len(name_parts) > 1 else ''
                    c.execute("""INSERT INTO leave4day_portal_users
                                 (emp_number, email, firstname, lastname, employee_id)
                                 VALUES (%s, %s, %s, %s, %s)""",
                              (new_emp, email, firstname, lastname, gs_emp['employee_id']))
                    db_p.commit()
                    c.execute("SELECT * FROM leave4day_portal_users WHERE email = %s", (email,))
                    portal_user = c.fetchone()
        finally:
            db_p.close()

        session.permanent = True
        session['user'] = {
            'email':      email,
            'emp_number': portal_user['emp_number'],
            'name':       f"{portal_user['firstname']} {portal_user['lastname']}",
            'employee_id': ''
        }
        session['is_admin']      = False
        session['is_supervisor'] = False
        session['is_sub_admin']  = False
        session['permissions']   = {}
        return redirect(url_for('dashboard'))

    session.permanent = True
    session['user'] = {
        'email':      email,
        'emp_number': employee['emp_number'],
        'name':       f"{employee['emp_firstname']} {employee['emp_lastname']}",
        'employee_id': employee.get('employee_id', '')
    }
    # Check admin from central_db.Employees role
    db_tmp = get_db()
    try:
        with db_tmp.cursor() as c:
            c.execute("""
                SELECT role FROM central_db.Employees
                WHERE LOWER(Email) = %s
            """, (email,))
            row = c.fetchone()
            central_role = row['role'].strip() if row and row['role'] else 'Employee'
    finally:
        db_tmp.close()
    session['is_admin'] = (central_role == 'Admin')
    session['is_supervisor'] = is_supervisor(employee['emp_number'])

    # Check sub-admin permissions
    if not session['is_admin']:
        perms = get_sub_admin_permissions(employee['emp_number'])
        if perms:
            session['is_sub_admin'] = True
            session['permissions']  = perms
            # Grant supervisor access if can_approve
            if perms['can_approve']:
                session['is_supervisor'] = True
        else:
            session['is_sub_admin'] = False
            session['permissions']  = {}
    else:
        session['is_sub_admin'] = False
        session['permissions']  = {
            'can_all_leaves': True, 'can_approve': True,
            'can_file_for_emp': True, 'can_schedules': True,
            'can_reports': True, 'can_work_mode': True,
            'can_settings': True, 'can_entitlements': True, 'can_file_requests': True, 'can_material_requests': True, 'can_final_approval': True, 'can_view_tickets': True, 'can_facilities_review': True, 'can_facilities_final': True, 'can_view_approved_items': True, 'can_onboarding': True,
        }
    return redirect(url_for('dashboard'))

@app.route('/admin/login-as/<target_emp>', methods=['POST'])
@admin_required
def login_as(target_emp):
    # Store original admin session
    session['original_admin'] = {
        'emp_number': session['user']['emp_number'],
        'email':      session['user']['email'],
        'name':       session['user']['name'],
        'is_admin':   session.get('is_admin'),
    }
    # Load target employee — supports both emp_number (int) and employee_id (string)
    db = get_db()
    try:
        with db.cursor() as c:
            # Try by employee_id first (e.g. '260113-01')
            c.execute("""
                SELECT u.emp_number, u.user_name, e.emp_firstname, e.emp_lastname
                FROM ohrm_user u
                JOIN hs_hr_employee e ON e.emp_number = u.emp_number
                WHERE e.employee_id = %s
                LIMIT 1
            """, (target_emp,))
            emp = c.fetchone()
            # Fallback: try as integer emp_number
            if not emp:
                try:
                    emp_num = int(target_emp)
                    c.execute("""
                        SELECT u.emp_number, u.user_name, e.emp_firstname, e.emp_lastname
                        FROM ohrm_user u
                        JOIN hs_hr_employee e ON e.emp_number = u.emp_number
                        WHERE u.emp_number = %s
                    """, (emp_num,))
                    emp = c.fetchone()
                except ValueError:
                    pass
    finally:
        db.close()

    if not emp:
        flash('Employee not found.', 'danger')
        return redirect(url_for('admin_sub_admins'))

    # Rebuild session as target user
    session['user'] = {
        'email':      emp['user_name'],
        'emp_number': emp['emp_number'],
        'name':       f"{emp['emp_firstname']} {emp['emp_lastname']}",
        'employee_id': emp.get('employee_id', '')
    }
    session['is_admin']      = False
    session['is_supervisor'] = is_supervisor(emp['emp_number'])
    session['is_sub_admin']  = False

    perms = get_sub_admin_permissions(emp['emp_number'])
    if perms:
        session['is_sub_admin'] = True
        session['permissions']  = perms
        if perms.get('can_approve'):
            session['is_supervisor'] = True
    else:
        session['permissions'] = {}

    flash(f'Now viewing as {emp["emp_firstname"]} {emp["emp_lastname"]}. Click the banner below to switch back.', 'warning')
    return redirect(url_for('dashboard'))


@app.route('/admin/login-as-back')
@login_required
def login_as_back():
    if 'original_admin' not in session:
        flash('No admin session to restore.', 'warning')
        return redirect(url_for('dashboard'))

    original = session.pop('original_admin')
    session['user'] = {
        'email':      original['email'],
        'emp_number': original['emp_number'],
        'name':       original['name'],
        'employee_id': original.get('employee_id', '')
    }
    session['is_admin']      = original['is_admin']
    session['is_supervisor'] = is_supervisor(original['emp_number'])
    session['is_sub_admin']  = False
    session['permissions']   = {
        'can_all_leaves': True, 'can_approve': True,
        'can_file_for_emp': True, 'can_schedules': True,
        'can_reports': True, 'can_work_mode': True,
        'can_settings': True, 'can_entitlements': True,
        'can_file_requests': True, 'can_material_requests': True,
        'can_final_approval': True, 'can_facilities_review': True, 'can_facilities_final': True, 'can_view_approved_items': True, 'can_onboarding': True,
    }
    flash('Returned to admin session.', 'success')
    return redirect(url_for('dashboard'))


@app.route('/logout')
def logout():
    session.clear()
    keycloak_logout_url = (
        f"{app.config['KEYCLOAK_META_URL'].replace('/.well-known/openid-configuration', '')}"
        f"/protocol/openid-connect/logout"
        f"?post_logout_redirect_uri=https://hrportal.cohere.ph"
        f"&client_id={app.config['KEYCLOAK_CLIENT_ID']}"
    )
    return redirect(keycloak_logout_url)

@app.route('/dashboard')
@login_required
def dashboard():
    emp_number = session['user']['emp_number']
    balances, portal_balances = get_leave_balances(emp_number)
    today      = date.today()
    off_day    = get_off_day(emp_number, today)
    # Check if any schedule exists this week
    week_start = today - timedelta(days=today.weekday())
    schedule_exists = False
    db_tmp = get_db()
    try:
        with db_tmp.cursor() as c:
            c.execute("""
                SELECT COUNT(*) as cnt FROM central_db.employee_schedules
                WHERE employee_id = (
                    SELECT employee_id FROM hs_hr_employee WHERE emp_number = %s
                ) AND schedule_date BETWEEN %s AND DATE_ADD(%s, INTERVAL 6 DAY)
            """, (emp_number, week_start, week_start))
            row = c.fetchone()
            schedule_exists = row['cnt'] > 0
    finally:
        db_tmp.close()
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("""
                SELECT r.*, lt.name AS leave_type_name
                FROM leave4day_requests r
                JOIN ohrm_leave_type lt ON r.leave_type_id = lt.id
                WHERE r.emp_number = %s
                ORDER BY r.leave_date DESC LIMIT 15
            """, (emp_number,))
            recent = c.fetchall()
    finally:
        db.close()
    # DTR records from central_db
    dtr_records = []
    try:
        cdb = get_central_db()
        with cdb.cursor() as c:
            dtr_page  = int(request.args.get("dtr_page", 1))
            dtr_from  = request.args.get("dtr_from", "")
            dtr_to    = request.args.get("dtr_to", "")
            dtr_per_page = 10
            user_email   = session["user"]["email"].lower()
            if dtr_from and dtr_to:
                date_filter = "AND d.date BETWEEN %s AND %s "
                date_params = [dtr_from + " 00:00:00", dtr_to + " 23:59:59"]
            elif dtr_from:
                date_filter = "AND d.date >= %s "
                date_params = [dtr_from + " 00:00:00"]
            elif dtr_to:
                date_filter = "AND d.date <= %s "
                date_params = [dtr_to + " 23:59:59"]
            else:
                date_filter = "AND d.date >= DATE_SUB(NOW(), INTERVAL 1 YEAR) "
                date_params = []
            base_where = ("FROM dailytimerecord d JOIN userdata u ON u.personid = d.personid WHERE LOWER(u.email) = %s AND d.date > " + "'2000-01-01' ") + date_filter
            c.execute("SELECT COUNT(*) as cnt " + base_where, [user_email] + date_params)
            dtr_total = c.fetchone()["cnt"]
            dtr_pages = max(1, (dtr_total + dtr_per_page - 1) // dtr_per_page)
            dtr_page  = min(dtr_page, dtr_pages)
            dtr_offset = (dtr_page - 1) * dtr_per_page
            c.execute("SELECT DATE(d.date) AS day, TIME(d.date) AS time, d.type " + base_where + "ORDER BY d.date DESC LIMIT %s OFFSET %s", [user_email] + date_params + [dtr_per_page, dtr_offset])
            dtr_records = c.fetchall()
        cdb.close()
    except Exception:
        dtr_records = []
        dtr_page = dtr_pages = 1
        dtr_from = dtr_to = ""
    # Quick links visibility
    db_ql = get_db()
    try:
        with db_ql.cursor() as c:
            c.execute("SELECT setting_value FROM leave4day_settings WHERE setting_key = 'quick_links_visible'")
            row = c.fetchone()
            quick_links_visible = (row['setting_value'] == '1') if row else False
            if quick_links_visible:
                c.execute("SELECT * FROM leave4day_quick_links WHERE is_active=1 ORDER BY sort_order, id")
                quick_links = c.fetchall()
            else:
                quick_links = []
    finally:
        db_ql.close()

    return render_template("dashboard.html", balances=balances, portal_balances=portal_balances, recent=recent,
                           off_day=off_day, schedule_exists=schedule_exists,
                           today=today, user=session["user"],
                           dtr_records=dtr_records,
                           dtr_page=dtr_page, dtr_pages=dtr_pages,
                           dtr_from=dtr_from, dtr_to=dtr_to,
                           quick_links_visible=quick_links_visible,
                           quick_links=quick_links,
                           is_admin=session.get("is_admin", False))

@app.route('/file-leave', methods=['GET', 'POST'])
@login_required
def file_leave():
    emp_number = session['user']['emp_number']
    balances, portal_balances = get_leave_balances(emp_number)

    if request.method == 'POST':
        leave_type_id = int(request.form['leave_type_id'])
        start_date    = datetime.strptime(request.form['start_date'], '%Y-%m-%d').date()
        end_date      = datetime.strptime(request.form['end_date'], '%Y-%m-%d').date()
        notes         = request.form.get('notes', '').strip()
        duration      = request.form.get('duration', 'full')

        # Map duration to shift_half enum
        duration_map = {
            'first_half': '1st Half',
            'second_half': '2nd Half',
            'full': None,
            'remaining': None
        }
        shift_value = duration_map.get(duration)
        use_remaining = (duration == 'remaining')

        # Basic validations
        if start_date > end_date:
            flash('Start date must be before or equal to end date.', 'danger')
            return render_template('file_leave.html', balances=balances, user=session['user'])

        if duration in ('first_half', 'second_half') and start_date != end_date:
            flash('First Half / Second Half can only be filed for a single day.', 'danger')
            return render_template('file_leave.html', balances=balances, user=session['user'])

        # Calculate deductions
        deductions = calculate_deduction(emp_number, start_date, end_date, duration)
        # Check holidays first before generic error
        from datetime import timedelta as _td
        check_date = start_date
        while check_date <= end_date:
            holiday_name = get_holiday_name(check_date)
            if holiday_name:
                flash(f'Cannot file leave on {check_date.strftime("%b %d, %Y")} — it is a public holiday ({holiday_name.strip()}).', 'danger')
                return render_template('file_leave.html', balances=balances, user=session['user'])
            check_date += _td(days=1)
        if not deductions:
            flash('No valid working days found. Please check if the dates fall on rest days.', 'warning')
            return render_template('file_leave.html', balances=balances, user=session['user'])

        # Block filing on public holidays
        leave_dates_check = [d['date'] for d in deductions if not d['is_off_day']]
        for ld in leave_dates_check:
            holiday_name = get_holiday_name(ld)
            if holiday_name:
                flash(f'Cannot file leave on {ld.strftime("%b %d, %Y")} — it is a public holiday ({holiday_name.strip()}).', 'danger')
                return render_template('file_leave.html', balances=balances, user=session['user'])

        # Check for overlapping active leaves
        leave_dates = [d['date'] for d in deductions if not d['is_off_day']]
        if leave_dates:
            db_check = get_db()
            try:
                with db_check.cursor() as c:
                    fmt = ','.join(['%s'] * len(leave_dates))
                    c.execute(f"""
                        SELECT leave_date FROM leave4day_requests
                        WHERE emp_number = %s
                          AND leave_date IN ({fmt})
                          AND status NOT IN ('rejected', 'cancelled')
                    """, [emp_number] + leave_dates)
                    overlaps = c.fetchall()
                    if overlaps:
                        overlap_str = ', '.join(o['leave_date'].strftime('%b %d') for o in overlaps)
                        flash(f'You already have an active leave on: {overlap_str}. Please choose different dates.', 'danger')
                        return render_template('file_leave.html', balances=balances, user=session['user'])
            finally:
                db_check.close()

        total_hours = sum(d['hours'] for d in deductions)
        total_days  = sum(d['days'] for d in deductions)
        if total_hours == 0:
            flash(
                'No deductible hours for the selected date(s). '
                'All selected days appear to be off-days or holidays. '
                'If you believe this is an error, please contact your admin.',
                'danger'
            )
            return render_template('file_leave.html', balances=balances, user=session['user'])

        # Advance notice check — check portal entitlements first, fall back to OrangeHRM
        balance = next((b for b in portal_balances if b['leave_type_id'] == leave_type_id), None)
        if not balance:
            balance = next((b for b in balances if b['leave_type_id'] == leave_type_id), None)
        if balance:
            violated = check_advance_notice(balance['leave_type_name'], leave_dates)
            if violated:
                violated_str = ', '.join(d.strftime('%b %d') for d in violated)
                flash(
                    f'{balance["leave_type_name"]} requires at least {ADVANCE_NOTICE_DAYS} days advance notice. '
                    f'These dates are too soon: {violated_str}',
                    'danger'
                )
                return render_template('file_leave.html', balances=balances, user=session['user'])

        # Check balance
        if not balance:
            flash('Selected leave type not found.', 'danger')
            return render_template('file_leave.html', balances=balances, user=session['user'])
        if use_remaining:
            # Use exactly the remaining balance
            available = balance['remaining_hours']
            if available <= 0:
                flash(f'No remaining balance for {balance["leave_type_name"]}.', 'danger')
                return render_template('file_leave.html', balances=balances, user=session['user'])
            # Distribute available hours across deduction days
            total_base = sum(d['hours'] for d in deductions)
            ratio = available / total_base if total_base > 0 else 0
            for d in deductions:
                d['hours'] = round(d['hours'] * ratio, 2)
                d['days']  = round(d['days'] * ratio, 4)
            total_hours = available
            total_days  = sum(d['days'] for d in deductions)
            flash(f'Remaining balance of {available:.1f} hrs will be fully used.', 'info')
        elif total_hours > balance['remaining_hours']:
            if balance['remaining_hours'] <= 0:
                flash(f'Insufficient balance. You have no remaining hours for {balance["leave_type_name"]}.', 'danger')
                return render_template('file_leave.html', balances=balances, user=session['user'])
            flash(f'Insufficient balance. Available: {balance["remaining_hours"]:.1f} hrs | Required: {total_hours:.1f} hrs', 'danger')
            return render_template('file_leave.html', balances=balances, user=session['user'])

        # Insert leave
        db = get_db()
        try:
            with db.cursor() as c:
                # 1. Insert ohrm_leave_request
                c.execute("""
                    INSERT INTO ohrm_leave_request (leave_type_id, date_applied, emp_number)
                    VALUES (%s, %s, %s)
                """, (leave_type_id, date.today(), emp_number))
                leave_request_id = c.lastrowid

                # Get employee_id for this emp_number
                c.execute("SELECT employee_id FROM hs_hr_employee WHERE emp_number = %s", (emp_number,))
                emp_row = c.fetchone()
                emp_employee_id = emp_row['employee_id'] if emp_row else None

                for d in deductions:
                    # 2. Insert into leave4day_requests including shift_half and employee_id
                    c.execute("""
                        INSERT INTO leave4day_requests
                            (emp_number, employee_id, leave_type_id, leave_date, hours_deducted,
                             days_deducted, is_off_day, notes, status, leave_request_id, shift_half)
                        VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
                    """, (emp_number, emp_employee_id, leave_type_id, d['date'], d['hours'],
                          d['days'], int(d['is_off_day']), notes, 'pending', leave_request_id, shift_value))

                    # 3. Insert into ohrm_leave
                    c.execute("""
                        INSERT INTO ohrm_leave
                            (date, length_hours, length_days, status,
                             leave_request_id, leave_type_id, emp_number, duration_type)
                        VALUES (%s, %s, %s, 1, %s, %s, %s, 0)
                    """, (d['date'], d['hours'], d['days'], leave_request_id, leave_type_id, emp_number))

                # 4. Deduct from correct entitlement source
                if total_days > 0:
                    # Check if portal entitlement exists for this employee/type/year
                    c.execute("""
                        SELECT id FROM leave4day_entitlements
                        WHERE emp_number = %s AND leave_type_id = %s
                          AND YEAR(from_date) = YEAR(CURDATE())
                        LIMIT 1
                    """, (emp_number, leave_type_id))
                    portal_ent = c.fetchone()
                    if portal_ent:
                        c.execute("""
                            UPDATE leave4day_entitlements
                            SET days_used = days_used + %s
                            WHERE emp_number = %s AND leave_type_id = %s
                              AND YEAR(from_date) = YEAR(CURDATE())
                        """, (total_days, emp_number, leave_type_id))
                    else:
                        c.execute("""
                            UPDATE ohrm_leave_entitlement
                            SET days_used = days_used + %s
                            WHERE emp_number = %s AND leave_type_id = %s AND deleted = 0
                              AND YEAR(from_date) = YEAR(CURDATE())
                        """, (total_days, emp_number, leave_type_id))

            db.commit()
            flash(f'Leave filed! {total_hours:.1f} hrs ({total_days:.2f} days) deducted. Awaiting supervisor approval.', 'success')

            # Email agent
            agent_email = session['user']['email']
            agent_name  = session['user']['name']
            dates_str   = ', '.join(d['date'].strftime('%b %d') for d in deductions)
            send_email(agent_email, 'Leave Filed Successfully',
                f"""<p>Hi {agent_name},</p>
                <p>Your leave has been filed and is awaiting supervisor approval.</p>
                <ul>
                  <li><b>Leave Type:</b> {balance['leave_type_name']}</li>
                  <li><b>Dates:</b> {dates_str}</li>
                  <li><b>Hours:</b> {total_hours:.1f} hrs</li>
                </ul>
                <p><a href="https://hrportal.cohere.ph">View HR Portal</a></p>""")

            # Email supervisor
            sup_email = get_supervisor_email(emp_number)
            if sup_email:
                send_email(sup_email, f'Leave Request from {agent_name}',
                    f"""<p>Hi,</p>
                    <p><b>{agent_name}</b> has filed a leave request awaiting your approval.</p>
                    <ul>
                      <li><b>Leave Type:</b> {balance['leave_type_name']}</li>
                      <li><b>Dates:</b> {dates_str}</li>
                      <li><b>Hours:</b> {total_hours:.1f} hrs</li>
                    </ul>
                    <p><a href="https://hrportal.cohere.ph">Approve / Reject on HR Portal</a></p>""")

            return redirect(url_for('dashboard'))
        except Exception as e:
            db.rollback()
            flash(f'Error saving leave: {str(e)}', 'danger')
        finally:
            db.close()
    # Get recent leaves for sidebar
    db_rl = get_db()
    try:
        with db_rl.cursor() as c:
            c.execute("""
                SELECT r.id, r.leave_date, r.status, r.hours_deducted,
                       r.is_off_day, lt.name AS leave_type_name, r.leave_request_id
                FROM leave4day_requests r
                JOIN ohrm_leave_type lt ON lt.id = r.leave_type_id
                WHERE r.emp_number = %s
                AND YEAR(r.leave_date) = YEAR(CURDATE())
                ORDER BY r.leave_date DESC
                LIMIT 30
            """, (emp_number,))
            recent_leaves = c.fetchall()
    finally:
        db_rl.close()
    return render_template('file_leave.html', balances=balances, user=session['user'], recent_leaves=recent_leaves)

# ── Holiday Management ──────────────────────────────────────────────
@app.route('/admin/holidays', methods=['GET', 'POST'])
@permission_required('can_settings')
def admin_holidays():
    db = get_db()
    try:
        if request.method == 'POST':
            action = request.form.get('action')

            if action == 'add':
                description = request.form.get('description', '').strip()
                date_val    = request.form.get('date', '').strip()
                recurring   = 1 if request.form.get('recurring') else 0
                if not description or not date_val:
                    flash('Description and date are required.', 'danger')
                    return redirect(url_for('admin_holidays'))
                with db.cursor() as c:
                    c.execute("""
                        INSERT INTO leave4day_holidays (description, date, recurring, length)
                        VALUES (%s, %s, %s, 0)
                    """, (description, date_val, recurring))
                db.commit()
                flash(f'Holiday "{description}" added!', 'success')

            elif action == 'edit':
                holiday_id  = int(request.form.get('holiday_id'))
                description = request.form.get('description', '').strip()
                date_val    = request.form.get('date', '').strip()
                recurring   = 1 if request.form.get('recurring') else 0
                with db.cursor() as c:
                    c.execute("""
                        UPDATE ohrm_holiday
                        SET description = %s, date = %s, recurring = %s
                        WHERE id = %s
                    """, (description, date_val, recurring, holiday_id))
                db.commit()
                flash(f'Holiday updated!', 'success')

            elif action == 'delete':
                holiday_id = int(request.form.get('holiday_id'))
                with db.cursor() as c:
                    c.execute("DELETE FROM ohrm_holiday WHERE id = %s", (holiday_id,))
                db.commit()
                flash('Holiday deleted.', 'success')

            return redirect(url_for('admin_holidays'))

        # GET — list all holidays (merged from both sources)
        year = int(request.args.get('year', date.today().year))
        with db.cursor() as c:
            c.execute("""
                SELECT id, description, date, recurring, 'orangehrm' AS source
                FROM ohrm_holiday
                WHERE YEAR(date) = %s OR recurring = 1

                UNION ALL

                SELECT id, description, date, recurring, 'own' AS source
                FROM leave4day_holidays
                WHERE YEAR(date) = %s OR recurring = 1

                ORDER BY MONTH(date), DAY(date)
            """, (year, year))
            holidays = c.fetchall()
    finally:
        db.close()

    return render_template('admin/holidays.html',
                           holidays=holidays, year=year,
                           user=session['user'])


# ── Helper: get holiday names for a date (for error messages) ────────
def get_holiday_name(target_date):
    db = get_db()
    try:
        with db.cursor() as c:
            # Check OrangeHRM holidays first
            c.execute("""
                SELECT description FROM ohrm_holiday
                WHERE date = %s
                   OR (recurring = 1 AND MONTH(date) = %s AND DAY(date) = %s)
                LIMIT 1
            """, (target_date, target_date.month, target_date.day))
            row = c.fetchone()
            if row:
                return row['description']
            # Check own holidays
            c.execute("""
                SELECT description FROM leave4day_holidays
                WHERE date = %s
                   OR (recurring = 1 AND MONTH(date) = %s AND DAY(date) = %s)
                LIMIT 1
            """, (target_date, target_date.month, target_date.day))
            row = c.fetchone()
            return row['description'] if row else None
    finally:
        db.close()

@app.route('/api/my-calendar')
@login_required
def my_calendar():
    emp_number = session['user']['emp_number']
    year  = int(request.args.get('year',  date.today().year))
    month = int(request.args.get('month', date.today().month))

    db = get_db()
    try:
        with db.cursor() as c:
            # Get employee_id
            c.execute("SELECT employee_id FROM hs_hr_employee WHERE emp_number = %s", (emp_number,))
            row = c.fetchone()
            employee_id = row['employee_id'] if row else None

            # Get schedule for the month
            schedule = []
            if employee_id:
                c.execute("""
                    SELECT schedule_date, shift_time, is_rest_day
                    FROM central_db.employee_schedules
                    WHERE employee_id = %s
                      AND YEAR(schedule_date) = %s
                      AND MONTH(schedule_date) = %s
                """, (employee_id, year, month))
                for s in c.fetchall():
                    schedule.append({
                        'date':        str(s['schedule_date']),
                        'shift':       s['shift_time'] or '',
                        'is_rest_day': bool(s['is_rest_day'])
                    })

            # Get leaves for the month
            c.execute("""
                SELECT leave_date, status, hours_deducted, is_off_day
                FROM leave4day_requests
                WHERE emp_number = %s
                  AND YEAR(leave_date) = %s
                  AND MONTH(leave_date) = %s
                  AND status NOT IN ('rejected', 'cancelled')
            """, (emp_number, year, month))
            leaves = []
            for l in c.fetchall():
                leaves.append({
                    'date':   str(l['leave_date']),
                    'status': l['status'],
                    'hours':  float(l['hours_deducted']),
                    'is_off_day': bool(l['is_off_day'])
                })
    finally:
        db.close()

    return jsonify({'schedule': schedule, 'leaves': leaves})

@app.route('/preview-leave')
@login_required
def preview_leave():
    emp_number    = session['user']['emp_number']
    leave_type_id = request.args.get('leave_type_id')
    start_str     = request.args.get('start_date')
    end_str       = request.args.get('end_date')
    if not all([leave_type_id, start_str, end_str]):
        return jsonify({'error': 'Missing parameters'}), 400
    start = datetime.strptime(start_str, '%Y-%m-%d').date()
    end   = datetime.strptime(end_str,   '%Y-%m-%d').date()
    if (end - start).days > 30:
        return jsonify({'error': 'Date range cannot exceed 30 days.'}), 400
    duration    = request.args.get('duration', 'full')
    deductions  = calculate_deduction(emp_number, start, end, duration)
    total_hours = sum(d['hours'] for d in deductions)
    total_days  = sum(d['days']  for d in deductions)
    # Check advance notice
    balances, portal_balances = get_leave_balances(emp_number)
    balance  = next((b for b in balances if b['leave_type_id'] == int(leave_type_id)), None)
    violated = []
    if balance:
        leave_dates = [d['date'] for d in deductions if not d['is_off_day']]
        violated    = [str(d) for d in check_advance_notice(balance['leave_type_name'], leave_dates)]

    return jsonify({
        'breakdown': [{'date': str(d['date']), 'day_name': d['day_name'],
                       'is_off_day': d['is_off_day'], 'hours': d['hours'],
                       'note': d['note']} for d in deductions],
        'total_hours':    total_hours,
        'total_days':     round(total_days, 2),
        'advance_notice_violated': violated
    })

@app.route('/history')
@login_required
def history():
    emp_number  = session['user']['emp_number']
    is_admin    = session.get('is_admin', False)

    # Filters from GET params
    date_from   = request.args.get('date_from', '')
    date_to     = request.args.get('date_to', '')
    status      = request.args.get('status', '')
    leave_type  = request.args.get('leave_type', '')
    emp_search  = request.args.get('emp_search', '')

    db = get_db()
    try:
        with db.cursor() as c:
            # Get leave types for filter dropdown
            c.execute("SELECT id, name FROM ohrm_leave_type ORDER BY name")
            leave_types = c.fetchall()

            # Build query
            where  = ["r.emp_number = %s"] if not is_admin else ["1=1"]
            params = [emp_number] if not is_admin else []

            if date_from:
                where.append("r.leave_date >= %s")
                params.append(date_from)
            if date_to:
                where.append("r.leave_date <= %s")
                params.append(date_to)
            if status:
                where.append("r.status = %s")
                params.append(status)
            if leave_type:
                where.append("r.leave_type_id = %s")
                params.append(leave_type)
            if emp_search and is_admin:
                where.append("(e.emp_firstname LIKE %s OR e.emp_lastname LIKE %s)")
                params.extend([f'%{emp_search}%', f'%{emp_search}%'])

            query = f"""
                SELECT r.*, lt.name AS leave_type_name,
                       e.emp_firstname, e.emp_lastname
                FROM leave4day_requests r
                JOIN ohrm_leave_type lt ON r.leave_type_id = lt.id
                JOIN hs_hr_employee e   ON r.emp_number = e.emp_number
                WHERE {' AND '.join(where)}
                ORDER BY r.leave_date DESC
            """
            c.execute(query, params)
            records = c.fetchall()
    finally:
        db.close()

    return render_template('history.html', records=records, user=session['user'],
                           leave_types=leave_types, is_admin=is_admin,
                           date_from=date_from, date_to=date_to,
                           status=status, leave_type=leave_type, emp_search=emp_search)

@app.route('/api/pending-count')
@login_required
def api_pending_count():
    emp_number = session['user']['emp_number']
    db = get_db()
    try:
        with db.cursor() as c:
            if session.get('is_admin'):
                c.execute("SELECT COUNT(DISTINCT COALESCE(leave_request_id, id)) AS cnt FROM leave4day_requests WHERE status='pending' AND YEAR(leave_date) = YEAR(CURDATE())")
            else:
                subs = get_subordinates(emp_number)
                if not subs:
                    return jsonify({'count': 0})
                fmt = ','.join(['%s'] * len(subs))
                c.execute(f"SELECT COUNT(DISTINCT COALESCE(leave_request_id, id)) AS cnt FROM leave4day_requests WHERE status='pending' AND YEAR(leave_date) = YEAR(CURDATE()) AND emp_number IN ({fmt})", subs)
            row = c.fetchone()
            return jsonify({'count': row['cnt'] if row else 0})
    finally:
        db.close()

@app.route('/admin/supervisors', methods=['GET', 'POST'])
@admin_required
def admin_supervisors():
    db = get_db()
    try:
        if request.method == 'POST':
            action = request.form.get('action')

            # ----- SINGLE ASSIGNMENT -----
            if action == 'assign':
                emp_number = resolve_emp_number(
                    request.form.get('emp_number'),
                    request.form.get('employee_id')
                )
                supervisor_email = request.form.get('supervisor_email', '').strip()

                if not emp_number or not supervisor_email:
                    flash('Employee and supervisor must be selected.', 'danger')
                    return redirect(url_for('admin_supervisors'))

                try:
                    emp_number = int(emp_number)
                except ValueError:
                    flash('Invalid employee number.', 'danger')
                    return redirect(url_for('admin_supervisors'))

                with db.cursor() as c:
                    # Resolve supervisor
                    c.execute("SELECT emp_number, employee_id FROM hs_hr_employee WHERE emp_work_email=%s LIMIT 1",
                              (supervisor_email,))
                    sup = c.fetchone()
                    if not sup:
                        flash('Supervisor email not found.', 'danger')
                        return redirect(url_for('admin_supervisors'))
                    supervisor_emp = sup['emp_number']
                    sup_employee_id = sup['employee_id']

                    # Resolve subordinate employee_id
                    c.execute("SELECT employee_id FROM hs_hr_employee WHERE emp_number=%s", (emp_number,))
                    sub = c.fetchone()
                    sub_employee_id = sub['employee_id'] if sub else None

                    # Insert/update
                    c.execute("""
                        INSERT INTO leave4day_supervisor_assignments
                            (emp_number, supervisor_emp, assigned_by, sub_employee_id, sup_employee_id)
                        VALUES (%s, %s, %s, %s, %s)
                        ON DUPLICATE KEY UPDATE
                            supervisor_emp=%s, assigned_by=%s, sub_employee_id=%s, sup_employee_id=%s
                    """, (emp_number, supervisor_emp, session['user']['emp_number'],
                          sub_employee_id, sup_employee_id,
                          supervisor_emp, session['user']['emp_number'],
                          sub_employee_id, sup_employee_id))
                db.commit()
                flash('Supervisor assignment saved!', 'success')

            # ----- REMOVE OVERRIDE -----
            elif action == 'remove':
                emp_number = resolve_emp_number(
                    request.form.get('emp_number'),
                    request.form.get('employee_id')
                )
                if not emp_number:
                    flash('Employee must be selected.', 'danger')
                    return redirect(url_for('admin_supervisors'))

                with db.cursor() as c:
                    c.execute("DELETE FROM leave4day_supervisor_assignments WHERE emp_number=%s", (emp_number,))
                db.commit()
                flash('Override removed — will fall back to OrangeHRM assignment.', 'success')

            # ----- BATCH ASSIGNMENT -----
            elif action == 'remove_batch':
                emp_ids = request.form.getlist('employee_ids')
                if not emp_ids:
                    flash('No employees selected.', 'warning')
                    return redirect(url_for('admin_supervisors'))
                with db.cursor() as c:
                    for eid in emp_ids:
                        emp_num = resolve_emp_number(None, eid)
                        if emp_num:
                            c.execute("DELETE FROM leave4day_supervisor_assignments WHERE emp_number=%s", (emp_num,))
                        else:
                            c.execute("DELETE FROM leave4day_supervisor_assignments WHERE sub_employee_id=%s", (eid,))
                db.commit()
                flash(f'Override removed for {len(emp_ids)} employee(s).', 'success')

            elif action == 'assign_batch':
                supervisor_email = request.form.get('supervisor_email', '').strip()
                emp_numbers = request.form.getlist('emp_numbers') or request.form.getlist('employee_id')  # list of selected employees

                if not supervisor_email or not emp_numbers:
                    flash('Please select a supervisor and at least one employee.', 'danger')
                    return redirect(url_for('admin_supervisors'))

                with db.cursor() as c:
                    # Resolve supervisor
                    c.execute("SELECT emp_number, employee_id FROM hs_hr_employee WHERE emp_work_email=%s LIMIT 1",
                              (supervisor_email,))
                    sup = c.fetchone()
                    if not sup:
                        flash('Supervisor email not found.', 'danger')
                        return redirect(url_for('admin_supervisors'))
                    supervisor_emp = sup['emp_number']
                    sup_employee_id = sup['employee_id']

                   # Loop through selected employees
                    for emp in emp_numbers:
                        try:
                            emp_number_int = int(resolve_emp_number(emp, emp))
                        except ValueError:
                            continue  # skip invalid

                        if not emp_number_int:
                            continue

                        # Get subordinate employee_id
                        c.execute("SELECT employee_id FROM hs_hr_employee WHERE emp_number=%s", (emp_number_int,))
                        sub = c.fetchone()
                        sub_employee_id = sub['employee_id'] if sub else None

                        # Insert/update
                        c.execute("""
                            INSERT INTO leave4day_supervisor_assignments
                                (emp_number, supervisor_emp, assigned_by, sub_employee_id, sup_employee_id)
                            VALUES (%s, %s, %s, %s, %s)
                            ON DUPLICATE KEY UPDATE
                                supervisor_emp=%s, assigned_by=%s, sub_employee_id=%s, sup_employee_id=%s
                        """, (emp_number_int, supervisor_emp, session['user']['emp_number'],
                              sub_employee_id, sup_employee_id,
                              supervisor_emp, session['user']['emp_number'],
                              sub_employee_id, sup_employee_id))
                db.commit()
                flash(f'Supervisor assigned to {len(emp_numbers)} employees!', 'success')

            return redirect(url_for('admin_supervisors'))

        # ----- GET REQUEST -----
        search = request.args.get('search', '').strip()
        group_filter = request.args.get('group', '')

        with db.cursor() as c:
            # Fetch groups
            c.execute("""
                SELECT DISTINCT group_name
                FROM central_db.gsheet_employees
                WHERE status NOT IN ('Separated') AND group_name IS NOT NULL
                ORDER BY group_name
            """)
            groups = [r['group_name'] for r in c.fetchall()]

            # Fetch employees
            sql = """
                SELECT
                    COALESCE(h.emp_number, pu.emp_number) AS emp_number,
                    COALESCE(g.schedule_name, g.employee_id) AS emp_firstname,
                    '' AS emp_lastname,
                    g.employee_id, g.email, g.group_name, g.tl,
                    g.approver AS gsheet_approver,
                    sa.supervisor_emp AS override_sup_emp,
                    COALESCE(so_email.emp_work_email, spu.email) AS override_sup_email,
                    CASE
                        WHEN so.emp_number IS NOT NULL THEN CONCAT(so.emp_firstname, ' ', so.emp_lastname)
                        WHEN spu.emp_number IS NOT NULL THEN CONCAT(spu.firstname, ' ', spu.lastname)
                        ELSE NULL
                    END AS override_sup_name
                FROM central_db.gsheet_employees g
                LEFT JOIN hs_hr_employee h ON h.employee_id = g.employee_id
                LEFT JOIN leave4day_portal_users pu ON pu.employee_id = g.employee_id
                LEFT JOIN leave4day_supervisor_assignments sa ON sa.emp_number = COALESCE(h.emp_number, pu.emp_number)
                LEFT JOIN hs_hr_employee so ON so.emp_number = sa.supervisor_emp
                LEFT JOIN hs_hr_employee so_email ON so_email.emp_number = sa.supervisor_emp
                LEFT JOIN leave4day_portal_users spu ON spu.emp_number = sa.supervisor_emp
                WHERE g.status NOT IN ('Separated')
            """
            params = []
            if group_filter:
                sql += " AND g.group_name=%s"
                params.append(group_filter)
            if search:
                sql += " AND (g.schedule_name LIKE %s OR g.employee_id LIKE %s)"
                params += [f"%{search}%", f"%{search}%"]

            sql += " ORDER BY g.group_name, g.schedule_name"
            c.execute(sql, params)
            employees = c.fetchall()

            # Supervisor dropdown options
            c.execute("""
                SELECT DISTINCT
                    g.approver AS email,
                    COALESCE(g2.schedule_name, g.approver) AS emp_firstname
                FROM central_db.gsheet_employees g
                LEFT JOIN central_db.gsheet_employees g2 ON g2.email = g.approver
                WHERE g.approver IS NOT NULL
                  AND g.approver != ''
                  AND g.approver NOT LIKE '%#%'
                  AND g.status NOT IN ('Separated')
                ORDER BY emp_firstname
            """)
            all_employees = c.fetchall()

    except Exception as e:
        db.rollback()
        flash(f"Error: {str(e)}", "danger")
        employees, all_employees, groups = [], [], []

    finally:
        db.close()

    return render_template(
        'admin/supervisors.html',
        employees=employees,
        all_employees=all_employees,
        groups=groups,
        group_filter=group_filter,
        search=search,
        user=session.get('user')
    )

@app.route('/admin/sub-admins', methods=['GET', 'POST'])
@admin_required
def admin_sub_admins():
    db = get_db()
    try:
        if request.method == 'POST':
            action     = request.form.get('action')
            emp_number = int(request.form.get('emp_number'))
            if action == 'save':
                perms = {
                    'can_all_leaves':   1 if request.form.get('can_all_leaves') else 0,
                    'can_approve':      1 if request.form.get('can_approve') else 0,
                    'can_file_for_emp': 1 if request.form.get('can_file_for_emp') else 0,
                    'can_schedules':    1 if request.form.get('can_schedules') else 0,
                    'can_reports':      1 if request.form.get('can_reports') else 0,
                    'can_absences':     1 if request.form.get('can_absences') else 0,
                    'can_work_mode':    1 if request.form.get('can_work_mode') else 0,
                    'can_settings':     1 if request.form.get('can_settings') else 0,
                    'can_entitlements': 1 if request.form.get('can_entitlements') else 0,
                    'can_file_requests': 1 if request.form.get('can_file_requests') else 0,
                    'can_material_requests': 1 if request.form.get('can_material_requests') else 0,
                    'can_final_approval': 1 if request.form.get('can_final_approval') else 0,
                    'can_view_tickets': 1 if request.form.get('can_view_tickets') else 0,
                    'can_facilities_review': 1 if request.form.get('can_facilities_review') else 0,
                    'can_facilities_final': 1 if request.form.get('can_facilities_final') else 0,
                    'can_view_approved_items': 1 if request.form.get('can_view_approved_items') else 0,
                    'can_onboarding': 1 if request.form.get('can_onboarding') else 0,
                }
                with db.cursor() as c:
                    c.execute("""
                        INSERT INTO leave4day_sub_admins
                            (emp_number, can_all_leaves, can_approve, can_file_for_emp,
                             can_schedules, can_reports, can_work_mode, can_settings, can_absences,
                             can_entitlements, can_file_requests, can_material_requests,
                             can_final_approval, can_view_tickets, can_facilities_review, can_facilities_final, can_view_approved_items, can_onboarding, assigned_by)
                        VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)
                        ON DUPLICATE KEY UPDATE
                            can_all_leaves=%s, can_approve=%s, can_file_for_emp=%s,
                            can_schedules=%s, can_reports=%s, can_work_mode=%s, can_absences=%s,
                            can_settings=%s, can_entitlements=%s, can_file_requests=%s,
                            can_material_requests=%s, can_final_approval=%s,
                            can_view_tickets=%s, can_facilities_review=%s, can_facilities_final=%s, can_view_approved_items=%s, can_onboarding=%s, assigned_by=%s
                    """, (
                        emp_number,
                        perms['can_all_leaves'], perms['can_approve'], perms['can_file_for_emp'],
                        perms['can_schedules'], perms['can_reports'], perms['can_work_mode'],
                        perms['can_settings'], perms['can_absences'], perms['can_entitlements'], perms['can_file_requests'],
                        perms['can_material_requests'], perms['can_final_approval'],
                        perms['can_view_tickets'], perms['can_facilities_review'], perms['can_facilities_final'], perms['can_view_approved_items'], perms['can_onboarding'], session['user']['emp_number'],
                        perms['can_all_leaves'], perms['can_approve'], perms['can_file_for_emp'],
                        perms['can_schedules'], perms['can_reports'], perms['can_work_mode'],
                        perms['can_settings'], perms['can_absences'], perms['can_entitlements'], perms['can_file_requests'],
                        perms['can_material_requests'], perms['can_final_approval'],
                        perms['can_view_tickets'], perms['can_facilities_review'], perms['can_facilities_final'], perms['can_view_approved_items'], perms['can_onboarding'], session['user']['emp_number']
                    ))
                db.commit()
                flash('Sub-admin permissions updated!', 'success')
            elif action == 'remove':
                with db.cursor() as c:
                    c.execute("DELETE FROM leave4day_sub_admins WHERE emp_number = %s", (emp_number,))
                db.commit()
                flash('Sub-admin removed!', 'success')

            elif action == 'bulk_group':
                group_name = request.form.get('bulk_group', '').strip()
                perms = {
                    'can_all_leaves':       1 if request.form.get('can_all_leaves') else 0,
                    'can_approve':          1 if request.form.get('can_approve') else 0,
                    'can_file_for_emp':     1 if request.form.get('can_file_for_emp') else 0,
                    'can_schedules':        1 if request.form.get('can_schedules') else 0,
                    'can_reports':          1 if request.form.get('can_reports') else 0,
                    'can_work_mode':        1 if request.form.get('can_work_mode') else 0,
                    'can_settings':         1 if request.form.get('can_settings') else 0,
                    'can_entitlements':     1 if request.form.get('can_entitlements') else 0,
                    'can_file_requests':    1 if request.form.get('can_file_requests') else 0,
                    'can_material_requests':1 if request.form.get('can_material_requests') else 0,
                    'can_final_approval':   1 if request.form.get('can_final_approval') else 0,
                    'can_view_tickets':     1 if request.form.get('can_view_tickets') else 0,
                    'can_facilities_review': 1 if request.form.get('can_facilities_review') else 0,
                    'can_facilities_final':  1 if request.form.get('can_facilities_final') else 0,
                    'can_view_approved_items': 1 if request.form.get('can_view_approved_items') else 0,
                    'can_onboarding': 1 if request.form.get('can_onboarding') else 0,
                }
                if not group_name:
                    flash('Please select a group.', 'danger')
                else:
                    with db.cursor() as c:
                        c.execute("""
                            SELECT h.emp_number FROM hs_hr_employee h
                            JOIN central_db.gsheet_employees g ON g.employee_id = h.employee_id COLLATE utf8mb4_unicode_ci
                            WHERE g.group_name = %s AND g.status != 'Separated'
                        """, (group_name,))
                        emps = [r['emp_number'] for r in c.fetchall()]
                        count = 0
                        for en in emps:
                            c.execute("""
                                INSERT INTO leave4day_sub_admins
                                    (emp_number, can_all_leaves, can_approve, can_file_for_emp,
                                     can_schedules, can_reports, can_work_mode, can_settings,
                                     can_entitlements, can_file_requests, can_material_requests,
                                     can_final_approval, can_view_tickets, can_facilities_review, can_facilities_final, can_view_approved_items, can_onboarding, assigned_by)
                                VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)
                                ON DUPLICATE KEY UPDATE
                                    can_all_leaves=%s, can_approve=%s, can_file_for_emp=%s,
                                    can_schedules=%s, can_reports=%s, can_work_mode=%s,
                                    can_settings=%s, can_entitlements=%s, can_file_requests=%s,
                                    can_material_requests=%s, can_final_approval=%s,
                                    can_view_tickets=%s, can_facilities_review=%s, can_facilities_final=%s, can_view_approved_items=%s, can_onboarding=%s, assigned_by=%s
                            """, (
                                en,
                                perms['can_all_leaves'], perms['can_approve'], perms['can_file_for_emp'],
                                perms['can_schedules'], perms['can_reports'], perms['can_work_mode'],
                                perms['can_settings'], perms['can_entitlements'], perms['can_file_requests'],
                                perms['can_material_requests'], perms['can_final_approval'],
                                perms['can_view_tickets'], perms['can_facilities_review'], perms['can_facilities_final'], perms['can_view_approved_items'], perms['can_onboarding'], session['user']['emp_number'],
                                perms['can_all_leaves'], perms['can_approve'], perms['can_file_for_emp'],
                                perms['can_schedules'], perms['can_reports'], perms['can_work_mode'],
                                perms['can_settings'], perms['can_entitlements'], perms['can_file_requests'],
                                perms['can_material_requests'], perms['can_final_approval'],
                                perms['can_view_tickets'], perms['can_facilities_review'], perms['can_facilities_final'], perms['can_view_approved_items'], perms['can_onboarding'], session['user']['emp_number']
                            ))
                            count += 1
                    db.commit()
                    flash(f'Permissions assigned to {count} employees in {group_name}!', 'success')

            return redirect(url_for('admin_sub_admins'))

        # GET — load all employees + current sub-admins
        with db.cursor() as c:
            c.execute("""
                SELECT h.emp_number, h.emp_firstname, h.emp_lastname, h.employee_id,
                       g.group_name,
                       sa.can_all_leaves, sa.can_approve, sa.can_file_for_emp,
                       sa.can_schedules, sa.can_reports, sa.can_work_mode,
                       sa.can_settings, sa.can_absences, sa.can_entitlements, sa.can_file_requests,
                       sa.can_material_requests, sa.can_final_approval, sa.can_view_tickets, sa.can_facilities_review, sa.can_facilities_final, sa.can_view_approved_items, sa.can_onboarding
                FROM hs_hr_employee h
                JOIN ohrm_user u ON u.emp_number = h.emp_number
                LEFT JOIN leave4day_sub_admins sa ON sa.emp_number = h.emp_number
                LEFT JOIN central_db.gsheet_employees g ON g.employee_id COLLATE utf8mb4_unicode_ci = h.employee_id
                WHERE h.emp_number != 1 AND u.deleted = 0
                AND (g.status IS NULL OR g.status != 'Separated')
                ORDER BY sa.emp_number DESC, h.emp_lastname
            """)
            employees = c.fetchall()
            # Get groups for bulk assign
            c.execute("""
                SELECT DISTINCT group_name FROM central_db.gsheet_employees
                WHERE group_name IS NOT NULL AND status != 'Separated'
                ORDER BY group_name
            """)
            groups = [r['group_name'] for r in c.fetchall()]
    finally:
        db.close()
    return render_template('admin/sub_admins.html', employees=employees, groups=groups, user=session['user'])

# ============================================================
# NIGHT DIFFERENTIAL REPORT
# ============================================================
def parse_shift_time(shift_str):
    """Parse shift string like '10pm-7am' into (start_hour, end_hour) in 24h float."""
    if not shift_str or shift_str.strip() in ('#REF!', ''):
        return None, None
    shift_str = shift_str.strip().lower().replace(' ', '')
    parts = shift_str.split('-')
    if len(parts) != 2:
        return None, None

    def to_hour(s):
        s = s.strip()
        if s == '12mn' or s == '12am':
            return 0.0
        if s == '12nn' or s == '12pm':
            return 12.0
        if s.endswith('mn'):
            return 0.0
        if s.endswith('nn'):
            return 12.0
        if s.endswith('am'):
            h = float(s[:-2])
            return 0.0 if h == 12 else h
        if s.endswith('pm'):
            h = float(s[:-2])
            return h if h == 12 else h + 12
        return None

    try:
        start = to_hour(parts[0])
        end   = to_hour(parts[1])
        return start, end
    except:
        return None, None

def calc_night_diff_hours(start_h, end_h):
    """Calculate hours within 22:00-06:00 window."""
    if start_h is None or end_h is None:
        return 0.0
    # Night diff window: 22 to 30 (6am next day = 30)
    nd_start = 22.0
    nd_end   = 30.0  # 6AM next day

    # Normalize shift to handle overnight
    if end_h <= start_h:
        end_h += 24  # overnight shift

    # Intersect [start_h, end_h] with [22, 30]
    overlap_start = max(start_h, nd_start)
    overlap_end   = min(end_h, nd_end)

    if overlap_end > overlap_start:
        return round(overlap_end - overlap_start, 2)
    return 0.0


@app.route('/admin/ot-tickets')
@login_required
def admin_ot_tickets():
    if not (session.get('is_admin') or session.get('permissions', {}).get('can_view_tickets')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))

    from datetime import timedelta as _td
    _today = datetime.now()
    date_from  = request.args.get('date_from', (_today - _td(days=30)).strftime('%Y-%m-%d'))
    date_to    = request.args.get('date_to', _today.strftime('%Y-%m-%d'))
    req_type   = request.args.get('req_type', '')
    sub_type   = request.args.get('sub_type', '')
    emp_search = request.args.get('emp_search', '').strip()
    tl_filter  = request.args.get('tl', '')
    approver_filter = request.args.get('approver', '') if session.get('is_admin') else ''

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("""
                SELECT DISTINCT tl FROM gsheet_employees
                WHERE tl IS NOT NULL AND tl != '' AND status != 'Separated'
                UNION
                SELECT DISTINCT SUBSTRING_INDEX(schedule_name, ' ', 1)
                FROM gsheet_employees
                WHERE group_name LIKE '%TL%' AND status != 'Separated'
                ORDER BY tl
            """)
            tl_list = [r['tl'] for r in c.fetchall()]
            approver_list = []
            if session.get('is_admin'):
                c.execute("""SELECT DISTINCT approver FROM gsheet_employees
                    WHERE approver IS NOT NULL AND approver != '' AND approver != '#N/A' AND status != 'Separated'
                    ORDER BY approver""")
                approver_list = [r['approver'] for r in c.fetchall()]

            records = []
            extra_params = []
            tl_clause = "AND g.tl = %s" if tl_filter else ""
            emp_clause = "AND (g.schedule_name LIKE %s OR o.employee_id LIKE %s)" if emp_search else ""
            tl_p  = [tl_filter] if tl_filter else []
            emp_p = [f"%{emp_search}%", f"%{emp_search}%"] if emp_search else []
            approver_clause = "AND g.approver = %s" if approver_filter else ""
            approver_p = [approver_filter] if approver_filter else []

            if not req_type or req_type == 'OT':
                c.execute(f"""
                    SELECT 'OT' AS req_type, o.id AS req_id, t.ticket_number,
                           g.schedule_name AS employee_name, o.employee_id,
                           o.ot_date AS req_date, o.ot_type AS details,
                           o.start_time, o.end_time, o.status AS req_status, g.tl
                    FROM ot_tickets t
                    JOIN ot_requests o ON o.id = t.ot_request_id
                    LEFT JOIN gsheet_employees g ON g.employee_id = o.employee_id COLLATE utf8mb4_unicode_ci
                    WHERE o.ot_date BETWEEN %s AND %s AND o.deleted_at IS NULL
                    {tl_clause} {approver_clause} {emp_clause}
                    ORDER BY g.tl, o.ot_date DESC
                """, [date_from, date_to] + tl_p + approver_p + emp_p)
                records.extend(c.fetchall())

            if not req_type or req_type == 'RDW':
                emp_clause_rd = "AND (g.schedule_name LIKE %s OR r.employee_id LIKE %s)" if emp_search else ""
                c.execute(f"""
                    SELECT 'RDW' AS req_type, r.id AS req_id, t.ticket_number,
                           g.schedule_name AS employee_name, r.employee_id,
                           r.rd_date AS req_date, r.work_category AS details,
                           r.start_time, r.end_time, r.status AS req_status, g.tl
                    FROM ot_tickets t
                    JOIN rd_requests r ON r.id = t.rd_request_id
                    LEFT JOIN gsheet_employees g ON g.employee_id = r.employee_id COLLATE utf8mb4_unicode_ci
                    WHERE r.rd_date BETWEEN %s AND %s AND r.deleted_at IS NULL
                    {tl_clause} {approver_clause} {emp_clause_rd}
                    ORDER BY g.tl, r.rd_date DESC
                """, [date_from, date_to] + tl_p + approver_p + emp_p)
                records.extend(c.fetchall())

    finally:
        cdb.close()

    # Group records by request for template
    grouped = {}
    for r in records:
        key = r['req_type'] + '_' + str(r['req_id'])
        if key not in grouped:
            grouped[key] = {
                'req_type': r['req_type'],
                'req_id': r['req_id'],
                'employee_name': r['employee_name'],
                'employee_id': r['employee_id'],
                'req_date': r['req_date'],
                'details': r['details'],
                'start_time': r['start_time'],
                'end_time': r['end_time'],
                'req_status': r['req_status'],
                'tl': r['tl'] or '—',
                'tickets': []
            }
        if r.get('ticket_number'):
            grouped[key]['tickets'].append(r['ticket_number'])

    # Sort by TL then date
    grouped_list = sorted(grouped.values(), key=lambda x: (x['tl'].lower(), str(x['req_date'] or '')), reverse=True)
    grouped_list = sorted(grouped_list, key=lambda x: x['tl'].lower())

    return render_template('admin/ot_tickets.html',
                           grouped_list=grouped_list, tl_list=tl_list,
                           records=records,
                           date_from=date_from, date_to=date_to,
                           req_type=req_type, emp_search=emp_search,
                           tl_filter=tl_filter,
                           approver_filter=approver_filter,
                           approver_list=approver_list,
                           sub_type=sub_type)

@app.route('/admin/night-differential')
@login_required
@permission_required('can_reports')
def admin_night_diff():
    from datetime import date as _date
    import calendar

    today = _date.today()
    import calendar as _cal

    def prev_month(d):
        if d.month == 1:
            return d.replace(year=d.year-1, month=12, day=1)
        return d.replace(month=d.month-1, day=1)

    def next_month(d):
        if d.month == 12:
            return d.replace(year=d.year+1, month=1, day=1)
        return d.replace(month=d.month+1, day=1)

    # Cycle A: 8th-22nd
    if today.day >= 8:
        cycle_a_from = today.replace(day=8)
        cycle_a_to   = today.replace(day=22)
    else:
        prev = prev_month(today)
        cycle_a_from = prev.replace(day=8)
        cycle_a_to   = prev.replace(day=22)

    # Cycle B: 23rd-7th
    if today.day >= 23:
        cycle_b_from = today.replace(day=23)
        cycle_b_to   = next_month(today).replace(day=7)
    else:
        prev = prev_month(today)
        cycle_b_from = prev.replace(day=23)
        cycle_b_to   = today.replace(day=7)

    default_from = cycle_b_from.strftime('%Y-%m-%d')
    default_to   = cycle_b_to.strftime('%Y-%m-%d')
    date_from  = request.args.get('date_from', default_from)
    date_to    = request.args.get('date_to', default_to)
    tl_filter  = request.args.get('tl', '')
    emp_search = request.args.get('emp_search', '').strip()
    month_str  = date_from[:7]
    try:
        year, month = map(int, month_str.split('-'))
    except:
        year, month = today.year, today.month

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            # Get TL list
            c.execute("""SELECT DISTINCT tl FROM gsheet_employees
                         WHERE tl IS NOT NULL AND tl != '' AND status != 'Separated'
                         ORDER BY tl""")
            tl_list = [r['tl'] for r in c.fetchall()]

            # Build filters
            where  = ["es.is_rest_day = 0", "es.shift_time IS NOT NULL",
                      "es.shift_time != '#REF!'",
                      "es.schedule_date BETWEEN %s AND %s"]
            params = [date_from, date_to]

            if tl_filter:
                where.append("g.tl = %s")
                params.append(tl_filter)
            if emp_search:
                where.append("(g.schedule_name LIKE %s OR es.employee_id LIKE %s)")
                params += [f'%{emp_search}%', f'%{emp_search}%']

            c.execute(f"""
                SELECT es.employee_id, g.schedule_name, g.tl, g.group_name,
                       es.schedule_date, es.shift_time
                FROM employee_schedules es
                JOIN gsheet_employees g ON g.employee_id = es.employee_id
                WHERE {' AND '.join(where)}
                ORDER BY g.tl, g.schedule_name, es.schedule_date
            """, params)
            rows = c.fetchall()
    finally:
        cdb.close()

    # Process records
    SPECIAL_END_HOURS = {1.0, 2.0, 3.0}  # 1am, 2am, 3am

    emp_map = {}  # employee_id -> { name, tl, group, days: [...] }
    emp_map_special = {}

    for r in rows:
        start_h, end_h = parse_shift_time(r['shift_time'])
        nd_hours = calc_night_diff_hours(start_h, end_h)

        # Normalize end for special check
        end_norm = end_h
        if end_h is not None and end_h >= 24:
            end_norm = end_h - 24

        is_special = end_norm in SPECIAL_END_HOURS if end_norm is not None else False
        target_map = emp_map_special if is_special else emp_map

        key = r['employee_id']
        if key not in target_map:
            target_map[key] = {
                'employee_id': r['employee_id'],
                'name':        r['schedule_name'],
                'tl':          r['tl'] or '—',
                'group_name':  r['group_name'] or '—',
                'total_nd_hours': 0.0,
                'days': []
            }
        target_map[key]['total_nd_hours'] = round(
            target_map[key]['total_nd_hours'] + nd_hours, 2)
        if nd_hours > 0:
            target_map[key]['days'].append({
                'date':       r['schedule_date'].strftime('%b %d'),
                'shift':      r['shift_time'],
                'nd_hours':   nd_hours
            })

    results         = sorted(emp_map.values(),         key=lambda x: (x['tl'], x['name']))
    results_special = sorted(emp_map_special.values(), key=lambda x: (x['tl'], x['name']))

    months = [(f"{y}-{m:02d}", f"{calendar.month_name[m]} {y}")
              for y in range(2025, _date.today().year + 1)
              for m in range(1, 13)
              if (y, m) <= (_date.today().year, _date.today().month)]
    months.reverse()

    return render_template('admin/night_diff.html',
                           results=results, results_special=results_special,
                           date_from=date_from, date_to=date_to,
                           tl_list=tl_list, tl_filter=tl_filter,
                           emp_search=emp_search, year=year, month=month,
                           months=months, user=session['user'],
                           cycle_a_from=cycle_a_from.strftime('%Y-%m-%d'),
                           cycle_a_to=cycle_a_to.strftime('%Y-%m-%d'),
                           cycle_b_from=cycle_b_from.strftime('%Y-%m-%d'),
                           cycle_b_to=cycle_b_to.strftime('%Y-%m-%d'))



@app.route('/admin/analytics')
@login_required
def admin_analytics():
    if not (session.get('is_admin') or session.get('permissions', {}).get('can_reports')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))

    from datetime import date, timedelta
    import json

    period = request.args.get('period', 'monthly')
    today  = date.today()

    if period == 'weekly':
        period_start = today - timedelta(days=today.weekday())
        period_label = 'This Week'
    elif period == 'quarterly':
        q = (today.month - 1) // 3
        period_start = date(today.year, q * 3 + 1, 1)
        period_label = f'Q{q+1} {today.year}'
    elif period == 'yearly':
        period_start = date(today.year, 1, 1)
        period_label = f'YTD {today.year}'
    else:
        period_start = today.replace(day=1)
        period_label = today.strftime('%B %Y')

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            # ── KPI Cards ──────────────────────────────────────
            c.execute("SELECT COUNT(*) AS cnt FROM gsheet_employees WHERE status != 'Separated'")
            total_active = c.fetchone()['cnt']
            month_start = period_start

            c.execute("SELECT COUNT(*) AS cnt FROM gsheet_employees WHERE operational_date >= %s AND operational_date <= %s", (month_start, today))
            new_hires_mtd = c.fetchone()['cnt']

            c.execute("""SELECT COUNT(*) AS cnt FROM gsheet_employees
                WHERE exit_date >= %s AND exit_date <= %s
                AND (promotion_date IS NULL OR exit_date > promotion_date)""", (month_start, today))
            exits_mtd = c.fetchone()['cnt']
            c.execute("""SELECT COUNT(*) AS cnt FROM gsheet_employees
                WHERE exit_date >= %s AND exit_date <= %s
                AND promotion_date IS NOT NULL AND promotion_date > exit_date""", (month_start, today))
            promotions_mtd = c.fetchone()['cnt']

            c.execute("SELECT COUNT(*) AS cnt FROM gsheet_employees WHERE status != 'Separated' AND wfh = 1")
            wfh_count = c.fetchone()['cnt']

            c.execute("SELECT COUNT(*) AS cnt FROM gsheet_employees WHERE status != 'Separated' AND email_mode = 1")
            email_mode_count = c.fetchone()['cnt']

            c.execute("SELECT COUNT(*) AS cnt FROM gsheet_employees WHERE status != 'Separated' AND sme = 1")
            sme_count = c.fetchone()['cnt']

            # Attrition rate (exits this year / avg headcount)
            year_start = today.replace(month=1, day=1)
            c.execute("""SELECT COUNT(*) AS cnt FROM gsheet_employees
                WHERE exit_date >= %s AND exit_date <= %s
                AND (promotion_date IS NULL OR exit_date > promotion_date)""", (year_start, today))
            exits_ytd = c.fetchone()['cnt']
            attrition_rate = round((exits_ytd / total_active * 100), 1) if total_active > 0 else 0

            # ── Monthly Trend (last 12 months) ─────────────────
            monthly_data = []
            for i in range(11, -1, -1):
                if today.month - i <= 0:
                    m = today.month - i + 12
                    y = today.year - 1
                else:
                    m = today.month - i
                    y = today.year
                m_start = date(y, m, 1)
                if m == 12:
                    m_end = date(y+1, 1, 1)
                else:
                    m_end = date(y, m+1, 1)

                c.execute("SELECT COUNT(*) AS cnt FROM gsheet_employees WHERE operational_date >= %s AND operational_date < %s", (m_start, m_end))
                hires = c.fetchone()['cnt']
                c.execute("""SELECT COUNT(*) AS cnt FROM gsheet_employees
                    WHERE exit_date >= %s AND exit_date < %s
                    AND (promotion_date IS NULL OR exit_date > promotion_date)""", (m_start, m_end))
                exits = c.fetchone()['cnt']
                monthly_data.append({
                    'month': m_start.strftime('%b %Y'),
                    'hires': hires,
                    'exits': exits
                })

            # ── Headcount by Group ──────────────────────────────
            c.execute("""
                SELECT group_name, COUNT(*) AS cnt
                FROM gsheet_employees
                WHERE status != 'Separated' AND group_name IS NOT NULL AND group_name != ''
                GROUP BY group_name ORDER BY cnt DESC
            """)
            by_group = c.fetchall()

            # ── Headcount by TL ─────────────────────────────────
            c.execute("""
                SELECT tl, COUNT(*) AS cnt
                FROM gsheet_employees
                WHERE status != 'Separated' AND tl IS NOT NULL AND tl != ''
                GROUP BY tl ORDER BY cnt DESC
            """)
            by_tl = c.fetchall()

            # ── Tenure breakdown (calculated from operational_date) ──
            c.execute("""
                SELECT
                  CASE
                    WHEN DATEDIFF(CURDATE(), operational_date) < 90  THEN '0-3 months'
                    WHEN DATEDIFF(CURDATE(), operational_date) < 180 THEN '3-6 months'
                    WHEN DATEDIFF(CURDATE(), operational_date) < 365 THEN '6-12 months'
                    WHEN DATEDIFF(CURDATE(), operational_date) < 730 THEN '1-2 years'
                    ELSE '2+ years'
                  END AS tenure,
                  COUNT(*) AS cnt
                FROM gsheet_employees
                WHERE status != 'Separated' AND operational_date IS NOT NULL
                GROUP BY
                  CASE
                    WHEN DATEDIFF(CURDATE(), operational_date) < 90  THEN '0-3 months'
                    WHEN DATEDIFF(CURDATE(), operational_date) < 180 THEN '3-6 months'
                    WHEN DATEDIFF(CURDATE(), operational_date) < 365 THEN '6-12 months'
                    WHEN DATEDIFF(CURDATE(), operational_date) < 730 THEN '1-2 years'
                    ELSE '2+ years'
                  END
                ORDER BY MIN(operational_date)
            """)
            by_tenure = c.fetchall()

            # ── Recent hires (last 30 days) ─────────────────────
            c.execute("""
                SELECT employee_id, schedule_name, tl, group_name, operational_date
                FROM gsheet_employees
                WHERE operational_date >= %s AND operational_date <= %s
                ORDER BY operational_date DESC
            """, (today - timedelta(days=30), today))
            recent_hires = c.fetchall()

            # ── Recent exits (last 30 days) ─────────────────────
            c.execute("""
                SELECT employee_id, schedule_name, tl, group_name, exit_date
                FROM gsheet_employees
                WHERE exit_date >= %s AND exit_date <= %s
                AND (promotion_date IS NULL OR exit_date > promotion_date)
                ORDER BY exit_date DESC
            """, (today - timedelta(days=30), today))
            recent_exits = c.fetchall()

            # Monthly breakdown (last 12 months)
            monthly_breakdown = []
            for i in range(11, -1, -1):
                if today.month - i <= 0:
                    m = today.month - i + 12
                    y = today.year - 1
                else:
                    m = today.month - i
                    y = today.year
                m_start = date(y, m, 1)
                m_end   = date(y, m+1, 1) if m < 12 else date(y+1, 1, 1)
                c.execute('SELECT COUNT(*) AS cnt FROM gsheet_employees WHERE operational_date >= %s AND operational_date < %s', (m_start, m_end))
                hires = c.fetchone()['cnt']
                c.execute('SELECT COUNT(*) AS cnt FROM gsheet_employees WHERE exit_date >= %s AND exit_date < %s AND (promotion_date IS NULL OR exit_date > promotion_date)', (m_start, m_end))
                exits = c.fetchone()['cnt']
                c.execute('SELECT COUNT(*) AS cnt FROM gsheet_employees WHERE exit_date >= %s AND exit_date < %s AND promotion_date IS NOT NULL AND promotion_date > exit_date', (m_start, m_end))
                promotions = c.fetchone()['cnt']
                c.execute('SELECT COUNT(*) AS cnt FROM gsheet_employees WHERE operational_date < %s AND (exit_date IS NULL OR exit_date >= %s)', (m_end, m_start))
                headcount = c.fetchone()['cnt']
                attrition = round(exits / headcount * 100, 1) if headcount > 0 else 0
                monthly_breakdown.append({
                    'month': m_start.strftime('%b %Y'),
                    'headcount': headcount,
                    'hires': hires,
                    'exits': exits,
                    'promotions': promotions,
                    'attrition': attrition,
                })

    finally:
        cdb.close()

    return render_template('admin/analytics.html',
        total_active=total_active,
        new_hires_mtd=new_hires_mtd,
        exits_mtd=exits_mtd,
        promotions_mtd=promotions_mtd,
        wfh_count=wfh_count,
        email_mode_count=email_mode_count,
        sme_count=sme_count,
        attrition_rate=attrition_rate,
        exits_ytd=exits_ytd,
        period=period,
        period_label=period_label,
        monthly_data=json.dumps(monthly_data),
        by_group=by_group,
        by_tl=by_tl,
        by_tenure=by_tenure,
        recent_hires=recent_hires,
        recent_exits=recent_exits,
        monthly_breakdown=monthly_breakdown,
        today=date.today()
    )


@app.route('/admin/onboarding-report')
@login_required
def admin_onboarding_report():
    if not (session.get('is_admin') or session.get('permissions', {}).get('can_onboarding') or session.get('permissions', {}).get('can_reports')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))
    from datetime import date, timedelta
    import json
    period = request.args.get('period', 'monthly')
    today  = date.today()
    if period == 'weekly':
        period_start = today - timedelta(days=today.weekday())
        period_label = 'This Week'
    elif period == 'quarterly':
        q = (today.month - 1) // 3
        period_start = date(today.year, q * 3 + 1, 1)
        period_label = f'Q{q+1} {today.year}'
    elif period == 'yearly':
        period_start = date(today.year, 1, 1)
        period_label = f'YTD {today.year}'
    else:
        period_start = today.replace(day=1)
        period_label = today.strftime('%B %Y')
    export = request.args.get('export')
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute("SELECT COUNT(*) AS cnt FROM employee_onboarding WHERE start_date >= %s AND start_date <= %s", (period_start, today))
            onboarded_period = c.fetchone()['cnt']
            c.execute("SELECT COUNT(*) AS cnt FROM employee_onboarding WHERE onboarding_status = 'Completed' AND completed_date >= %s AND completed_date <= %s", (period_start, today))
            onboarding_completed_period = c.fetchone()['cnt']
            c.execute("SELECT ROUND(AVG(DATEDIFF(completed_date, start_date)), 1) AS avg_days FROM employee_onboarding WHERE onboarding_status = 'Completed' AND completed_date IS NOT NULL")
            avg_turnaround = c.fetchone()['avg_days'] or 0
            c.execute("SELECT COUNT(*) AS cnt FROM employee_onboarding WHERE onboarding_status IN ('Pending','In Progress')")
            onboarding_active = c.fetchone()['cnt']
            c.execute("SELECT COUNT(*) AS cnt FROM employee_offboarding WHERE exit_date >= %s AND exit_date <= %s", (period_start, today))
            offboarded_period = c.fetchone()['cnt']
            c.execute("SELECT COUNT(*) AS cnt FROM employee_offboarding WHERE ad_disabled=1 AND keycloak_disabled=1 AND email_suspended=1 AND dashboard_disabled=1 AND biometric_deleted=1 AND exit_date >= %s AND exit_date <= %s", (period_start, today))
            fully_compliant = c.fetchone()['cnt']
            compliance_pct = round(fully_compliant / offboarded_period * 100, 1) if offboarded_period > 0 else 0
            monthly_data = []
            for i in range(11, -1, -1):
                m = (today.month - i - 1) % 12 + 1
                y = today.year + ((today.month - i - 1) // 12)
                m_start = date(y, m, 1)
                m_end = date(y+1, 1, 1) if m == 12 else date(y, m+1, 1)
                c.execute("SELECT COUNT(*) AS cnt FROM employee_onboarding WHERE start_date >= %s AND start_date < %s", (m_start, m_end))
                ob = c.fetchone()['cnt']
                c.execute("SELECT COUNT(*) AS cnt FROM employee_offboarding WHERE exit_date >= %s AND exit_date < %s", (m_start, m_end))
                ofb = c.fetchone()['cnt']
                monthly_data.append({'month': m_start.strftime('%b %Y'), 'onboarded': ob, 'offboarded': ofb})
            c.execute("""SELECT eo.id, eo.employee_id, eo.onboarding_status, eo.start_date, eo.expected_completion_date, eo.completed_date, eo.training_weeks, eo.notes, DATEDIFF(IFNULL(eo.completed_date, CURDATE()), eo.start_date) AS elapsed_days, g.schedule_name, g.group_name, g.tl FROM employee_onboarding eo LEFT JOIN gsheet_employees g ON g.employee_id = eo.employee_id ORDER BY eo.start_date DESC LIMIT 200""")
            onboarding_list = c.fetchall()
            c.execute("""SELECT eo.id, eo.employee_id, eo.exit_date, eo.reason, eo.ad_disabled, eo.keycloak_disabled, eo.email_suspended, eo.dashboard_disabled, eo.biometric_deleted, eo.processed_by, eo.processed_at, (eo.ad_disabled + eo.keycloak_disabled + eo.email_suspended + eo.dashboard_disabled + eo.biometric_deleted) AS flags_done, g.schedule_name, g.group_name, g.tl FROM employee_offboarding eo LEFT JOIN gsheet_employees g ON g.employee_id = eo.employee_id ORDER BY eo.exit_date DESC LIMIT 200""")
            offboarding_list = c.fetchall()
            if export == 'onboarding':
                import csv, io
                from flask import Response
                output = io.StringIO()
                w = csv.writer(output)
                w.writerow(['Employee ID','Name','Group','TL','Status','Start Date','Expected Completion','Completed Date','Elapsed Days','Training Weeks','Notes'])
                for r in onboarding_list:
                    w.writerow([r['employee_id'], r['schedule_name'], r['group_name'], r['tl'], r['onboarding_status'], r['start_date'], r['expected_completion_date'], r['completed_date'], r['elapsed_days'], r['training_weeks'], r['notes']])
                return Response(output.getvalue(), mimetype='text/csv', headers={'Content-Disposition': 'attachment;filename=onboarding_report.csv'})
            if export == 'offboarding':
                import csv, io
                from flask import Response
                output = io.StringIO()
                w = csv.writer(output)
                w.writerow(['Employee ID','Name','Group','TL','Exit Date','Reason','AD','Keycloak','Email','Dashboard','Biometric','Flags Done','Processed By'])
                for r in offboarding_list:
                    w.writerow([r['employee_id'], r['schedule_name'], r['group_name'], r['tl'], r['exit_date'], r['reason'], r['ad_disabled'], r['keycloak_disabled'], r['email_suspended'], r['dashboard_disabled'], r['biometric_deleted'], r['flags_done'], r['processed_by']])
                return Response(output.getvalue(), mimetype='text/csv', headers={'Content-Disposition': 'attachment;filename=offboarding_report.csv'})
    finally:
        cdb.close()
    return render_template('admin/onboarding_report.html', period=period, period_label=period_label, today=today, onboarded_period=onboarded_period, onboarding_completed_period=onboarding_completed_period, avg_turnaround=avg_turnaround, onboarding_active=onboarding_active, offboarded_period=offboarded_period, compliance_pct=compliance_pct, fully_compliant=fully_compliant, monthly_data=json.dumps(monthly_data), onboarding_list=onboarding_list, offboarding_list=offboarding_list)

@app.route('/admin/reports')
@permission_required('can_reports')
def admin_reports():
    year   = int(request.args.get('year', date.today().year))
    export = request.args.get('export', '')
    tab    = request.args.get('tab', 'detail')

    if export == '1':
        db = get_db()
        try:
            with db.cursor() as c:
                c.execute("""
                    SELECT id, name FROM ohrm_leave_type
                    WHERE name NOT IN ('Leave Without Pay (LWOP)', 'Paternity Leave')
                    ORDER BY name
                """)
                leave_types = c.fetchall()
                c.execute("""
                    SELECT e.employee_id, e.emp_firstname, e.emp_lastname,
                           lt.name AS leave_type, le.no_of_days,
                           COALESCE((
                               SELECT SUM(ol.length_hours) / 8
                               FROM ohrm_leave ol
                               WHERE ol.emp_number = le.emp_number
                                 AND ol.leave_type_id = le.leave_type_id
                                 AND ol.status IN (1,2,3)
                                 AND YEAR(ol.date) = %s
                           ), 0) AS days_used
                    FROM ohrm_leave_entitlement le
                    JOIN hs_hr_employee e ON e.emp_number = le.emp_number
                    JOIN ohrm_leave_type lt ON lt.id = le.leave_type_id
                    JOIN ohrm_user u ON u.emp_number = le.emp_number
                    WHERE le.deleted = 0 AND u.deleted = 0
                      AND e.termination_id IS NULL
                      AND YEAR(le.from_date) = %s
                      AND lt.name NOT IN ('Leave Without Pay (LWOP)', 'Paternity Leave')
                    ORDER BY e.emp_lastname, e.emp_firstname
                """, (year, year))
                rows = c.fetchall()
        finally:
            db.close()

        # Build per-employee map
        bal_map = {}
        for r in rows:
            key = r['employee_id']
            if key not in bal_map:
                bal_map[key] = {
                    'employee_id': r['employee_id'],
                    'first_name':  r['emp_firstname'],
                    'last_name':   r['emp_lastname'],
                    'types': {}
                }
            total     = round(float(r['no_of_days']) * 8, 1)
            used      = round(float(r['days_used']) * 8, 1)
            remaining = round(total - used, 1)
            bal_map[key]['types'][r['leave_type']] = {
                'total': total, 'used': used, 'remaining': remaining
            }

        import csv, io
        lt_names = [lt['name'] for lt in leave_types]
        output = io.StringIO()
        writer = csv.writer(output)
        header = ['Employee ID', 'First Name', 'Last Name']
        for lt in lt_names:
            header += [f'{lt} Total (hrs)', f'{lt} Total (days)',
                       f'{lt} Used (hrs)',  f'{lt} Used (days)',
                       f'{lt} Remaining (hrs)', f'{lt} Remaining (days)']
        writer.writerow(header)
        for e in bal_map.values():
            row = [e['employee_id'], e['first_name'], e['last_name']]
            for lt in lt_names:
                t = e['types'].get(lt, {'total':0,'used':0,'remaining':0})
                row += [t['total'], round(t['total']/8,2),
                        t['used'],  round(t['used']/8,2),
                        t['remaining'], round(t['remaining']/8,2)]
            writer.writerow(row)

        from flask import Response
        return Response(
            output.getvalue(),
            mimetype='text/csv',
            headers={'Content-Disposition': f'attachment;filename=leave_balances_{year}.csv'}
        )

    db   = get_db()
    try:
        with db.cursor() as c:
            # 1. Status summary
            c.execute("""
                SELECT status, COUNT(*) AS cnt, SUM(hours_deducted) AS total_hrs
                FROM leave4day_requests
                WHERE YEAR(leave_date) = %s AND status != 'cancelled'
                GROUP BY status
            """, (year,))
            status_summary = c.fetchall()

            # 2. Leave type breakdown
            c.execute("""
                SELECT lt.name AS leave_type, COUNT(*) AS cnt,
                       SUM(r.hours_deducted) AS total_hrs
                FROM leave4day_requests r
                JOIN ohrm_leave_type lt ON lt.id = r.leave_type_id
                WHERE YEAR(r.leave_date) = %s AND r.status NOT IN ('cancelled','rejected')
                GROUP BY r.leave_type_id, lt.name
                ORDER BY total_hrs DESC
            """, (year,))
            type_breakdown = c.fetchall()

            # 3. Monthly trends
            c.execute("""
                SELECT MONTH(leave_date) AS month, COUNT(*) AS cnt,
                       SUM(hours_deducted) AS total_hrs
                FROM leave4day_requests
                WHERE YEAR(leave_date) = %s AND status NOT IN ('cancelled','rejected')
                GROUP BY MONTH(leave_date)
                ORDER BY month
            """, (year,))
            monthly_raw = c.fetchall()
            monthly = {m: {'cnt':0,'hrs':0} for m in range(1,13)}
            for row in monthly_raw:
                monthly[row['month']] = {'cnt': row['cnt'], 'hrs': float(row['total_hrs'] or 0)}

            # 4. Leave usage per employee
            c.execute("""
                SELECT CONCAT(e.emp_firstname,' ',e.emp_lastname) AS emp_name,
                       e.employee_id, COUNT(*) AS days_filed,
                       SUM(r.hours_deducted) AS total_hrs
                FROM leave4day_requests r
                JOIN hs_hr_employee e ON e.emp_number = r.emp_number
                WHERE YEAR(r.leave_date) = %s AND r.status NOT IN ('cancelled','rejected')
                GROUP BY r.emp_number
                ORDER BY total_hrs DESC
            """, (year,))
            emp_usage = c.fetchall()

            # 5. Low balance employees (less than 2 days = 16 hrs remaining)
            c.execute("""
                SELECT CONCAT(e.emp_firstname,' ',e.emp_lastname) AS emp_name,
                       e.employee_id, lt.name AS leave_type,
                       (le.no_of_days * 8) AS total_hrs,
                       COALESCE((
                           SELECT SUM(ol.length_hours)
                           FROM ohrm_leave ol
                           WHERE ol.emp_number = le.emp_number
                             AND ol.leave_type_id = le.leave_type_id
                             AND ol.status IN (1,2,3)
                             AND YEAR(ol.date) = %s
                       ),0) AS used_hrs
                FROM ohrm_leave_entitlement le
                JOIN hs_hr_employee e ON e.emp_number = le.emp_number
                JOIN ohrm_leave_type lt ON lt.id = le.leave_type_id
                WHERE le.deleted = 0 AND YEAR(le.from_date) = %s
                  AND le.leave_type_id NOT IN (
                      SELECT id FROM ohrm_leave_type WHERE name LIKE '%%Without Pay%%'
                   )
                HAVING (total_hrs - used_hrs) <= 16 AND total_hrs > 0
                ORDER BY (total_hrs - used_hrs) ASC
            """, (year, year))
            low_balance = c.fetchall()

            # 6. Employee leave balance summary table
        with db.cursor() as c:
            c.execute("""
                SELECT id, name FROM ohrm_leave_type
                WHERE name NOT IN ('Leave Without Pay (LWOP)', 'Paternity Leave')
                ORDER BY name
            """)
            leave_types = c.fetchall()

            c.execute("""
                SELECT e.employee_id, e.emp_firstname, e.emp_lastname,
                       lt.name AS leave_type,
                       le.no_of_days,
                       COALESCE((
                           SELECT SUM(ol.length_hours) / 8
                           FROM ohrm_leave ol
                           WHERE ol.emp_number = le.emp_number
                             AND ol.leave_type_id = le.leave_type_id
                             AND ol.status IN (1,2,3)
                             AND YEAR(ol.date) = %s
                       ), 0) AS days_used
                FROM ohrm_leave_entitlement le
                JOIN hs_hr_employee e ON e.emp_number = le.emp_number
                JOIN ohrm_leave_type lt ON lt.id = le.leave_type_id
                JOIN ohrm_user u ON u.emp_number = le.emp_number
                WHERE le.deleted = 0 AND u.deleted = 0
                  AND e.termination_id IS NULL
                  AND YEAR(le.from_date) = %s
                  AND lt.name NOT IN ('Leave Without Pay (LWOP)', 'Paternity Leave')
                ORDER BY e.emp_lastname, e.emp_firstname
            """, (year, year))
            rows = c.fetchall()

        # Structure into per-employee dict
        bal_map = {}
        for r in rows:
            key = r['employee_id']
            if key not in bal_map:
                bal_map[key] = {
                    'employee_id': r['employee_id'],
                    'first_name':  r['emp_firstname'],
                    'last_name':   r['emp_lastname'],
                    'types': {}
                }
            total     = round(float(r['no_of_days']) * 8, 1)
            used      = round(float(r['days_used']) * 8, 1)
            remaining = round(total - used, 1)
            bal_map[key]['types'][r['leave_type']] = {
                'total': total, 'used': used, 'remaining': remaining
            }
        # Fetch individual leave dates per employee per leave type
        with db.cursor() as c:
            c.execute("""
                SELECT r.employee_id, lt.name AS leave_type,
                       r.leave_date, r.hours_deducted, r.notes,
                       r.approver_name, r.approved_at, r.shift_half, r.status
                FROM leave4day_requests r
                JOIN ohrm_leave_type lt ON lt.id = r.leave_type_id
                WHERE r.status NOT IN ('cancelled','rejected')
                  AND YEAR(r.leave_date) = %s
                  AND lt.name NOT IN ('Leave Without Pay (LWOP)', 'Paternity Leave')
                ORDER BY r.leave_date
            """, (year,))
            leave_dates_raw = c.fetchall()

        for r in leave_dates_raw:
            key = r['employee_id']
            lt  = r['leave_type']
            if key in bal_map and lt in bal_map[key]['types']:
                if 'dates' not in bal_map[key]['types'][lt]:
                    bal_map[key]['types'][lt]['dates'] = []
                bal_map[key]['types'][lt]['dates'].append({
                    'date':     r['leave_date'].strftime('%b %d, %Y'),
                    'hrs':      round(float(r['hours_deducted']), 1),
                    'notes':    r['notes'] or '',
                    'approver': r['approver_name'] or '',
                    'approved': r['approved_at'].strftime('%b %d') if r['approved_at'] else '',
                    'half':     r['shift_half'] or '',
                    'status':   r['status'] or ''
                })

        emp_balances = list(bal_map.values())

    finally:
        db.close()

    months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
    return render_template('admin/reports.html',
                           year=year, months=months,
                           status_summary=status_summary,
                           type_breakdown=type_breakdown,
                           monthly=monthly,
                           emp_usage=emp_usage,
                           low_balance=low_balance,
                           leave_types=leave_types,
                           emp_balances=emp_balances,
                           tab=tab)

# ── Leave Types (own DB) ─────────────────────────────────────────────
@app.route('/admin/leave-types', methods=['GET', 'POST'])
@permission_required('can_entitlements')
def admin_leave_types():
    db = get_db()
    try:
        if request.method == 'POST':
            action = request.form.get('action')
            if action == 'add':
                name     = request.form['name'].strip()
                max_days = float(request.form.get('max_days', 0))
                with db.cursor() as c:
                    c.execute("INSERT INTO leave4day_leave_types (name, max_days) VALUES (%s, %s)", (name, max_days))
                db.commit()
                flash(f'Leave type "{name}" added!', 'success')
            elif action == 'toggle':
                lt_id = int(request.form['lt_id'])
                with db.cursor() as c:
                    c.execute("UPDATE leave4day_leave_types SET is_active = NOT is_active WHERE id = %s", (lt_id,))
                db.commit()
                flash('Leave type updated!', 'success')
            return redirect(url_for('admin_leave_types'))

        with db.cursor() as c:
            c.execute("SELECT * FROM leave4day_leave_types ORDER BY name")
            leave_types = c.fetchall()
    finally:
        db.close()
    return render_template('admin/leave_types.html', leave_types=leave_types, user=session['user'])


# ── Entitlements (own DB) ────────────────────────────────────────────
@app.route('/admin/entitlements', methods=['GET', 'POST'])
@permission_required('can_entitlements')
def admin_entitlements():
    db = get_db()
    try:
        if request.method == 'POST':
            action     = request.form.get('action')
            if action == 'assign':
                employee_id   = request.form['employee_id']
                with db.cursor() as c:
                    c.execute("SELECT emp_number FROM hs_hr_employee WHERE employee_id = %s", (employee_id,))
                    row = c.fetchone()
                if not row:
                    flash('Employee not found.', 'danger')
                    return redirect(url_for('admin_entitlements'))
                emp_number    = int(row['emp_number'])
                leave_type_id = int(request.form['leave_type_id'])
                no_of_days    = float(request.form['no_of_days'])
                year          = int(request.form['year'])
                from_date     = f'{year}-01-01'
                to_date       = f'{year}-12-31'
                with db.cursor() as c:
                    c.execute("""
                        INSERT INTO leave4day_entitlements
                            (emp_number, leave_type_id, no_of_days, from_date, to_date, created_by)
                        VALUES (%s, %s, %s, %s, %s, %s)
                        ON DUPLICATE KEY UPDATE
                            no_of_days = %s, updated_at = NOW()
                    """, (emp_number, leave_type_id, no_of_days, from_date, to_date,
                          session['user']['emp_number'], no_of_days))
                db.commit()
                flash('Entitlement saved!', 'success')
            elif action == 'delete':
                ent_id = int(request.form['ent_id'])
                with db.cursor() as c:
                    c.execute("DELETE FROM leave4day_entitlements WHERE id = %s", (ent_id,))
                db.commit()
                flash('Entitlement deleted!', 'success')
            return redirect(url_for('admin_entitlements'))

        year_filter = int(request.args.get('year', date.today().year))
        search      = request.args.get('search', '').strip()

        with db.cursor() as c:
            c.execute("SELECT * FROM leave4day_leave_types WHERE is_active = 1 ORDER BY name")
            leave_types = c.fetchall()
            c.execute("""
                SELECT h.emp_number, h.emp_firstname, h.emp_lastname, h.employee_id
                FROM hs_hr_employee h
                JOIN ohrm_user u ON u.emp_number = h.emp_number
                WHERE h.emp_number != 1
                ORDER BY h.emp_lastname
            """)
            employees = c.fetchall()
            sql = """
                SELECT e.id, e.emp_number, e.leave_type_id, e.no_of_days,
                       e.days_used, e.from_date, e.to_date,
                       CONCAT(h.emp_firstname, ' ', h.emp_lastname) AS emp_name,
                       h.employee_id, lt.name AS leave_type_name
                FROM leave4day_entitlements e
                JOIN hs_hr_employee h ON h.emp_number = e.emp_number
                JOIN leave4day_leave_types lt ON lt.id = e.leave_type_id
                WHERE YEAR(e.from_date) = %s
            """
            params = [year_filter]
            if search:
                sql += " AND (h.emp_firstname LIKE %s OR h.emp_lastname LIKE %s OR h.employee_id LIKE %s)"
                params += [f'%{search}%', f'%{search}%', f'%{search}%']
            sql += " ORDER BY h.emp_lastname, lt.name"
            c.execute(sql, params)
            entitlements = c.fetchall()

            # Also fetch OrangeHRM entitlements for reference
            ohrm_sql = """
                SELECT e.id, e.emp_number, e.no_of_days, e.days_used,
                       e.from_date, e.to_date,
                       CONCAT(h.emp_firstname, ' ', h.emp_lastname) AS emp_name,
                       h.employee_id, lt.name AS leave_type_name
                FROM ohrm_leave_entitlement e
                JOIN hs_hr_employee h ON h.emp_number = e.emp_number
                JOIN ohrm_leave_type lt ON lt.id = e.leave_type_id
                WHERE e.deleted = 0 AND YEAR(e.from_date) = %s
            """
            ohrm_params = [year_filter]
            if search:
                ohrm_sql += " AND (h.emp_firstname LIKE %s OR h.emp_lastname LIKE %s OR h.employee_id LIKE %s)"
                ohrm_params += [f'%{search}%', f'%{search}%', f'%{search}%']
            ohrm_sql += " ORDER BY h.emp_lastname, lt.name"
            c.execute(ohrm_sql, ohrm_params)
            ohrm_entitlements = c.fetchall()
    finally:
        db.close()

    return render_template('admin/entitlements.html',
                           entitlements=entitlements, leave_types=leave_types,
                           employees=employees, year_filter=year_filter,
                           search=search, user=session['user'],
                           ohrm_entitlements=ohrm_entitlements)


# ── Entitlement Source Toggle ────────────────────────────────────────
@app.route('/admin/entitlement-source', methods=['POST'])
@permission_required('can_settings')
def toggle_entitlement_source():
    source = request.form.get('source', 'orangehrm')
    db = get_db()
    try:
        with db.cursor() as c:
            c.execute("""
                UPDATE leave4day_settings SET setting_value = %s, updated_by = %s
                WHERE setting_key = 'entitlement_source'
            """, (source, session['user']['emp_number']))
        db.commit()
        label = 'Leave4Day (Own DB)' if source == 'own' else 'OrangeHRM'
        flash(f'Entitlement source switched to {label}!', 'success')
    finally:
        db.close()
    return redirect(url_for('admin_settings'))

@app.route('/admin/emp-settings', methods=['GET', 'POST'])
@permission_required('can_work_mode')
def admin_emp_settings():
    if request.method == 'POST':
        action = request.form.get('action')
        db = get_db()
        try:
            if action == 'bulk':
                group_name = request.form.get('bulk_group')
                work_mode  = request.form.get('bulk_mode')
                with db.cursor() as c:
                    c.execute("""
                        SELECT h.emp_number FROM hs_hr_employee h
                        JOIN central_db.gsheet_employees g ON g.employee_id = h.employee_id
                        WHERE g.group_name = %s AND g.status = 'Active'
                    """, (group_name,))
                    emps = c.fetchall()
                    count = 0
                    for e in emps:
                        if work_mode == 'global':
                            c.execute("DELETE FROM leave4day_emp_settings WHERE emp_number = %s", (e['emp_number'],))
                        else:
                            c.execute("""
                                INSERT INTO leave4day_emp_settings (emp_number, work_mode, updated_by)
                                VALUES (%s, %s, %s)
                                ON DUPLICATE KEY UPDATE work_mode = %s, updated_by = %s
                            """, (e['emp_number'], work_mode, session['user']['emp_number'],
                                  work_mode, session['user']['emp_number']))
                        count += 1
                db.commit()
                flash(f'Updated {count} employees in {group_name} to {"Global Default" if work_mode == "global" else work_mode}!', 'success')
            else:
                employee_id = request.form.get('employee_id', '').strip()
                work_mode   = request.form.get('work_mode', '')
                # Resolve emp_number from employee_id
                target_emp  = resolve_emp_number(None, employee_id) if employee_id else None
                if not target_emp:
                    flash('Employee not found.', 'danger')
                    return redirect(url_for('admin_emp_settings'))
                with db.cursor() as c:
                    if work_mode == 'global':
                        c.execute("DELETE FROM leave4day_emp_settings WHERE emp_number = %s", (target_emp,))
                    else:
                        c.execute("""
                            INSERT INTO leave4day_emp_settings (emp_number, work_mode, updated_by)
                            VALUES (%s, %s, %s)
                            ON DUPLICATE KEY UPDATE work_mode = %s, updated_by = %s
                        """, (target_emp, work_mode, session['user']['emp_number'],
                              work_mode, session['user']['emp_number']))
                db.commit()
                flash('Employee work mode updated successfully!', 'success')
        except Exception as e:
            db.rollback()
            flash(f'Error: {e}', 'danger')
        finally:
            db.close()
        return redirect(url_for('admin_emp_settings'))

    # GET — load employees excluding separated
    global_mode  = get_work_mode()
    group_filter = request.args.get('group', '')
    search       = request.args.get('search', '').strip()
    db = get_db()
    try:
        with db.cursor() as c:
            # Get distinct groups (active only)
            c.execute("""
                SELECT DISTINCT g.group_name
                FROM central_db.gsheet_employees g
                JOIN hs_hr_employee h ON h.employee_id = g.employee_id
                JOIN ohrm_user u ON u.emp_number = h.emp_number
                WHERE g.status != 'Separated'
                  AND g.group_name IS NOT NULL
                ORDER BY g.group_name
            """)
            groups = [r['group_name'] for r in c.fetchall()]

            sql = """
                SELECT h.emp_number, h.emp_firstname, h.emp_lastname,
                       h.employee_id, es.work_mode AS individual_mode,
                       g.group_name
                FROM hs_hr_employee h
                JOIN ohrm_user u ON u.emp_number = h.emp_number
                LEFT JOIN leave4day_emp_settings es ON es.emp_number = h.emp_number
                LEFT JOIN central_db.gsheet_employees g ON g.employee_id = h.employee_id
                WHERE h.emp_number != 1
                  AND u.deleted = 0
                  AND (g.status IS NULL OR g.status != 'Separated')
            """
            params = []
            if group_filter:
                sql += " AND g.group_name = %s"
                params.append(group_filter)
            if search:
                sql += " AND (h.emp_firstname LIKE %s OR h.emp_lastname LIKE %s OR h.employee_id LIKE %s)"
                params += [f'%{search}%', f'%{search}%', f'%{search}%']
            sql += " ORDER BY g.group_name, h.emp_lastname"
            c.execute(sql, params)
            employees = c.fetchall()
    finally:
        db.close()

    return render_template('admin/emp_settings.html', employees=employees,
                           global_mode=global_mode, groups=groups,
                           group_filter=group_filter, search=search,
                           user=session['user'])

@app.route('/admin/quick-links', methods=['GET', 'POST'])
@login_required
@admin_required
def admin_quick_links():
    db = get_db()
    try:
        if request.method == 'POST':
            action = request.form.get('action')
            if action == 'add':
                db.cursor().execute("""
                    INSERT INTO leave4day_quick_links (title, url, icon, color_from, color_to, sort_order)
                    VALUES (%s,%s,%s,%s,%s,%s)
                """, (
                    request.form.get('title'),
                    request.form.get('url'),
                    request.form.get('icon', 'bi-link-45deg'),
                    request.form.get('color_from', '#3b82f6'),
                    request.form.get('color_to', '#1d4ed8'),
                    int(request.form.get('sort_order', 0))
                ))
                db.commit()
                flash('Quick link added!', 'success')
            elif action == 'edit':
                with db.cursor() as c:
                    c.execute("""
                        UPDATE leave4day_quick_links SET
                            title=%s, url=%s, icon=%s,
                            color_from=%s, color_to=%s, sort_order=%s
                        WHERE id=%s
                    """, (
                        request.form.get('title'),
                        request.form.get('url'),
                        request.form.get('icon', 'bi-link-45deg'),
                        request.form.get('color_from', '#3b82f6'),
                        request.form.get('color_to', '#1d4ed8'),
                        int(request.form.get('sort_order', 0)),
                        int(request.form.get('link_id'))
                    ))
                db.commit()
                flash('Quick link updated!', 'success')
            elif action == 'toggle':
                with db.cursor() as c:
                    c.execute("UPDATE leave4day_quick_links SET is_active = NOT is_active WHERE id=%s",
                              (request.form.get('link_id'),))
                db.commit()
                flash('Quick link toggled!', 'success')
            elif action == 'delete':
                with db.cursor() as c:
                    c.execute("DELETE FROM leave4day_quick_links WHERE id=%s",
                              (request.form.get('link_id'),))
                db.commit()
                flash('Quick link deleted!', 'success')
            return redirect(url_for('admin_quick_links'))

        with db.cursor() as c:
            c.execute("SELECT * FROM leave4day_quick_links ORDER BY sort_order, id")
            links = c.fetchall()
            c.execute("SELECT setting_value FROM leave4day_settings WHERE setting_key = 'quick_links_visible'")
            row = c.fetchone()
            quick_links_visible = (row['setting_value'] == '1') if row else False
    finally:
        db.close()
    return render_template('admin/quick_links.html', links=links,
                           quick_links_visible=quick_links_visible, user=session['user'])


@app.route('/admin/settings', methods=['GET', 'POST'])
@permission_required('can_settings')
def admin_settings():
    if request.method == 'POST':
        work_mode = request.form.get('work_mode', '4day')
        db = get_db()
        try:
            with db.cursor() as c:
                c.execute("""
                    UPDATE leave4day_settings
                    SET setting_value = %s, updated_by = %s
                    WHERE setting_key = 'work_mode'
                """, (work_mode, session['user']['emp_number']))
            db.commit()
            flash(f'Work mode switched to {"4-Day Work Week" if work_mode == "4day" else "5-Day Work Week"} successfully!', 'success')
        except Exception as e:
