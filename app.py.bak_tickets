# ── FILE REQUESTS APPROVALS ──────────────────────────────────

@app.route('/file-requests/approvals')
@login_required
def file_requests_approvals():
    if not (session.get('is_supervisor') or session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))

    sup_email  = session['user']['email']
    is_admin   = session.get('is_admin')
    emp_ids    = get_supervisor_central_employees(sup_email) if not is_admin else []


    type_filter = request.args.get('req_type', '')
    tl_filter   = request.args.get('tl', '')
    from datetime import date as _today
    date_to     = request.args.get('date_to', _today.today().strftime('%Y-12-31'))
    date_from   = request.args.get('date_from', _today.today().strftime('%Y-01-01'))
    emp_search  = request.args.get('emp_search', '').strip()
    tl_list   = []
    fts_list = []
    ot_list  = []
    cws_list = []
    rdw_list = []

    if is_admin or emp_ids:
        conn   = get_central_db()
        cursor = conn.cursor()
        if is_admin:
            emp_filter_fts = ""
            emp_filter     = ""
            emp_params     = []
        else:
            placeholders   = ','.join(['%s'] * len(emp_ids))
            emp_filter_fts = f'AND f.employeeID IN ({placeholders})'
            emp_filter     = f'AND o.employee_id IN ({placeholders})'
            emp_params     = emp_ids


        # Filters (already set above with defaults)

        # TL list
        if is_admin:
            cursor.execute("""SELECT DISTINCT tl FROM gsheet_employees
                             WHERE tl IS NOT NULL AND tl != '' AND status != 'Separated'
                             ORDER BY tl""")
        else:
            cursor.execute("""SELECT DISTINCT tl FROM gsheet_employees
                             WHERE approver = %s AND tl IS NOT NULL AND tl != ''
                               AND status != 'Separated' ORDER BY tl""",
                          (session['user']['email'],))
        tl_list = [r['tl'] for r in cursor.fetchall()]

        def add_filters(base_filter, base_params, date_col, name_col, id_col):
            extra = base_filter
            params = list(base_params)
            if date_from:
                extra += f' AND {date_col} >= %s'
                params.append(date_from)
            if date_to:
                extra += f' AND {date_col} <= %s'
                params.append(date_to)
            if tl_filter:
                extra += ' AND g.tl = %s'
                params.append(tl_filter)
            if emp_search:
                extra += f' AND ({name_col} LIKE %s OR {id_col} LIKE %s)'
                params += [f'%{emp_search}%', f'%{emp_search}%']
            return extra, params

        # FTS
        if not type_filter or type_filter == 'FTS':
            fts_extra, fts_params = add_filters(emp_filter_fts, emp_params,
                'f.fts_date', 'f.employee_name', 'f.employeeID')
            cursor.execute(f"""
                SELECT f.id, f.employeeID, f.employee_name,
                       f.fts_date, f.fts_time, f.fts_type, f.created_at,
                       g.employee_id, g.tl
                FROM fts_requests f
                LEFT JOIN gsheet_employees g ON g.schedule_name COLLATE utf8mb4_unicode_ci = f.employee_name COLLATE utf8mb4_unicode_ci
                WHERE f.status = 'Pending'
                AND f.deleted_at IS NULL
                {fts_extra}
                ORDER BY f.created_at DESC
            """, fts_params)
            fts_list = cursor.fetchall()

        if not type_filter or type_filter == 'OT':
            ot_extra, ot_params = add_filters(emp_filter, emp_params,
                'o.ot_date', 'g.schedule_name', 'o.employee_id')
            cursor.execute(f"""
                SELECT o.id, o.employee_id,
                       MIN(g.schedule_name) AS employee_name,
                       o.ot_date, o.ot_type, o.regular_rate,
                       o.start_time, o.end_time,
                       COUNT(t.id) AS ticket_count,
                       MIN(g.tl) AS tl,
                       ROUND(MOD(TIMESTAMPDIFF(MINUTE,
                         CONCAT(o.ot_date," ",o.start_time),
                         CONCAT(o.ot_date," ",o.end_time)
                       ) + 1440, 1440) / 60, 2) AS ot_hours
                FROM ot_requests o
                JOIN gsheet_employees g ON g.employee_id COLLATE utf8mb4_unicode_ci = o.employee_id COLLATE utf8mb4_unicode_ci
                LEFT JOIN ot_tickets t ON t.ot_request_id = o.id
                WHERE o.status = 'Pending'
                AND o.deleted_at IS NULL
                {ot_extra}
                GROUP BY o.id, o.employee_id, o.ot_date, o.ot_type, o.regular_rate, o.start_time, o.end_time
                ORDER BY o.ot_date DESC
            """, ot_params)
            ot_list = cursor.fetchall()

        # CWS
        if not type_filter or type_filter == 'CWS':
            cws_base = emp_filter.replace("o.employee_id", "c.employee_id")
            cws_extra, cws_params = add_filters(cws_base, emp_params,
                'c.original_date', 'g.schedule_name', 'c.employee_id')
            cursor.execute(f"""
                SELECT c.id, c.employee_id,
                       g.schedule_name AS employee_name,
                       c.original_date, c.original_time,
                       c.new_date, c.new_time, c.reason, c.created_at,
                       g.tl
                FROM cws_requests c
                JOIN gsheet_employees g ON g.employee_id COLLATE utf8mb4_unicode_ci = c.employee_id COLLATE utf8mb4_unicode_ci
                WHERE c.status = 'Pending'
                AND c.deleted_at IS NULL
                {cws_extra}
                ORDER BY c.created_at DESC
            """, cws_params)
            cws_list = cursor.fetchall()

        # RDW
        if not type_filter or type_filter == 'RDW':
            rdw_base = emp_filter.replace("o.employee_id", "r.employee_id")
            rdw_extra, rdw_params = add_filters(rdw_base, emp_params,
                'r.rd_date', 'g.schedule_name', 'r.employee_id')
            cursor.execute(f"""
                SELECT r.id, r.employee_id,
                       g.schedule_name AS employee_name,
                       r.rd_date, r.start_time, r.end_time,
                       r.work_category, r.created_at, g.tl,
                       (SELECT COUNT(*) FROM ot_tickets t WHERE t.rd_request_id = r.id) AS ticket_count,
                       ROUND(MOD(TIMESTAMPDIFF(MINUTE,
                           CONCAT(r.rd_date,' ',r.start_time),
                           CONCAT(r.rd_date,' ',r.end_time)
                       ) + 1440, 1440) / 60, 2) AS rd_hours
                FROM rd_requests r
                JOIN gsheet_employees g ON g.employee_id COLLATE utf8mb4_unicode_ci = r.employee_id COLLATE utf8mb4_unicode_ci
                WHERE r.status = 'Pending'
                AND r.deleted_at IS NULL
                {rdw_extra}
                ORDER BY r.rd_date DESC
            """, rdw_params)
            rdw_list = cursor.fetchall()

        cursor.close()
        conn.close()

    # Combine and sort all records by TL then date
    combined = []
    for r in fts_list:
        combined.append({'req_type':'FTS','tl':r.get('tl') or '—','r':dict(r)})
    for r in ot_list:
        combined.append({'req_type':'OT','tl':r.get('tl') or '—','r':dict(r)})
    for r in cws_list:
        combined.append({'req_type':'CWS','tl':r.get('tl') or '—','r':dict(r)})
    for r in rdw_list:
        combined.append({'req_type':'RDW','tl':r.get('tl') or '—','r':dict(r)})
    combined.sort(key=lambda x: (x['tl'].lower(), x['req_type']))

    return render_template('file_requests/approvals.html',
                           combined=combined,
                           fts_list=fts_list, ot_list=ot_list,
                           cws_list=cws_list, rdw_list=rdw_list,
                           tl_list=tl_list, tl_filter=tl_filter,
                           emp_search=emp_search, date_from=date_from,
                           date_to=date_to, type_filter=type_filter)


@app.route('/file-requests/approvals/bulk-action', methods=['POST'])
@login_required
def file_requests_bulk_action():
    if not (session.get('is_supervisor') or session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')):
        flash('Access denied.', 'danger')
        return redirect(url_for('file_requests_approvals'))

    action   = request.form.get('action')
    selected = request.form.getlist('selected_reqs')  # "req_type|req_id|emp_id"

    if not selected:
        flash('No requests selected.', 'warning')
        return redirect(url_for('file_requests_approvals'))

    new_status    = 'Approved' if action == 'approve' else 'Rejected'
    approver_name = session['user']['name']
    now           = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    table_map     = {'fts': 'fts_requests', 'ot': 'ot_requests',
                     'cws': 'cws_requests', 'rdw': 'rd_requests'}
    count = 0
    conn  = get_central_db()
    try:
        cursor = conn.cursor()
        for item in selected:
            parts = item.split('|')
            if len(parts) != 3:
                continue
            req_type, req_id, emp_id = parts[0], parts[1], parts[2]
            if req_type not in table_map:
                continue
            table = table_map[req_type]
            cursor.execute(f"UPDATE {table} SET status=%s, approver_name=%s, approved_at=%s WHERE id=%s",
                           (new_status, approver_name, now, req_id))
            count += 1
            # Notify employee
            cursor.execute("SELECT Email, CONCAT(FirstName,' ',LastName) AS name FROM Employees WHERE EmployeeID=%s", (emp_id,))
            emp = cursor.fetchone()
            if emp and emp['Email']:
                req_label = {'fts':'FTS','ot':'OT','cws':'CWS','rdw':'Rest Day Work'}[req_type]
                send_email(emp['Email'], f'{req_label} Request {new_status}',
                    f"<p>Your <b>{req_label}</b> request has been <b>{new_status}</b> by {approver_name}.</p>")
        conn.commit()
    except Exception as e:
        conn.rollback()
        flash(f'Error: {e}', 'danger')
        return redirect(url_for('file_requests_approvals'))
    finally:
        cursor.close()
        conn.close()

    flash(f'{count} request(s) {new_status.lower()} successfully.', 'success')
    next_url = request.form.get('next', url_for('file_requests_approvals'))
    return redirect(next_url)


@app.route('/file-requests/approvals/action', methods=['POST'])
@login_required
def file_requests_action():
    if not (session.get('is_supervisor') or session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))

    req_type  = request.form.get('req_type')   # fts|ot|cws|rdw
    req_id    = request.form.get('req_id')
    action    = request.form.get('action')      # approve|reject
    emp_id    = request.form.get('emp_id')      # for email lookup

    if action not in ('approve', 'reject') or not req_id or not req_type:
        flash('Invalid action.', 'danger')
        return redirect(url_for('file_requests_approvals'))

    new_status    = 'Approved' if action == 'approve' else 'Rejected'
    approver_name = session['user']['name']
    now           = datetime.now().strftime('%Y-%m-%d %H:%M:%S')

    table_map = {
        'fts': ('fts_requests', 'id'),
        'ot':  ('ot_requests',  'id'),
        'cws': ('cws_requests', 'id'),
        'rdw': ('rd_requests',  'id'),
    }

    if req_type not in table_map:
        flash('Invalid request type.', 'danger')
        return redirect(url_for('file_requests_approvals'))

    table, id_col = table_map[req_type]

    conn   = get_central_db()
    cursor = conn.cursor()

    cursor.execute(f"""
        UPDATE {table}
        SET status = %s, approver_name = %s, approved_at = %s
        WHERE {id_col} = %s
    """, (new_status, approver_name, now, req_id))
    conn.commit()

    # Get employee email for notification
    if emp_id:
        cursor.execute(
            "SELECT Email, CONCAT(FirstName,' ',LastName) AS name FROM Employees WHERE EmployeeID = %s",
            (emp_id,)
        )
        emp = cursor.fetchone()
        if emp and emp['Email']:
            req_label = {'fts':'FTS','ot':'OT','cws':'CWS','rdw':'Rest Day Work'}[req_type]
            send_email(
                emp['Email'],
                f'{req_label} Request {new_status}',
                f"""<p>Hi {emp['name']},</p>
                <p>Your <b>{req_label}</b> request has been
                <b>{'approved ✅' if action == 'approve' else 'rejected ❌'}</b>
                by {approver_name}.</p>
                <p><a href="https://hrportal.cohere.ph">View HR Portal</a></p>"""
            )

    cursor.close()
    conn.close()

    flash(f'Request {new_status.lower()} successfully.', 'success')
    next_url = request.form.get('next', url_for('file_requests_approvals'))
    return redirect(next_url)



@app.route('/admin/delete-request', methods=['POST'])
@login_required
def admin_delete_request():
    if not session.get('is_admin'):
        return jsonify({'success': False, 'message': 'Unauthorized'}), 403

    req_type   = request.form.get('type', '').strip()
    req_id     = request.form.get('request_id', '').strip()
    reason     = request.form.get('reason', '').strip()
    deleted_by = session.get('employee_id') or session['user']['name']
    now        = datetime.now().strftime('%Y-%m-%d %H:%M:%S')

    if not req_type or not req_id:
        return jsonify({'success': False, 'message': 'Missing parameters'}), 400

    try:
        if req_type == 'material':
            conn   = get_central_db()
            cursor = conn.cursor(dictionary=True)
            cursor.execute("SELECT request_group_id FROM material_requests WHERE id = %s", (req_id,))
            row = cursor.fetchone()
            group_id = row['request_group_id'] if row else None
            if group_id:
                cursor.execute("""
                    UPDATE material_requests
                    SET status = 'Deleted', deleted_by = %s, deleted_at = %s, delete_reason = %s
                    WHERE request_group_id = %s
                """, (deleted_by, now, reason, group_id))
            else:
                cursor.execute("""
                    UPDATE material_requests
                    SET status = 'Deleted', deleted_by = %s, deleted_at = %s, delete_reason = %s
                    WHERE id = %s
                """, (deleted_by, now, reason, req_id))
            conn.commit()
            cursor.close()
            conn.close()

        else:
            table_map = {
                'fts': 'fts_requests',
                'ot':  'ot_requests',
                'cws': 'cws_requests',
                'rdw': 'rd_requests',
            }
            if req_type not in table_map:
                return jsonify({'success': False, 'message': 'Invalid request type'}), 400
            table  = table_map[req_type]
            conn   = get_central_db()
            cursor = conn.cursor()
            cursor.execute(f"""
                UPDATE {table}
                SET status = 'Deleted', deleted_by = %s, deleted_at = %s, delete_reason = %s
                WHERE id = %s
            """, (deleted_by, now, reason, req_id))
            conn.commit()
            cursor.close()
            conn.close()

        return jsonify({'success': True})

    except Exception as e:
        return jsonify({'success': False, 'message': str(e)}), 500

@app.route('/api/file-requests-pending-count')
@login_required
def file_requests_pending_count():
    """Badge count for supervisor sidebar."""
    if not (session.get('is_supervisor') or session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')):
        return jsonify({'count': 0})

    sup_email = session['user']['email']
    is_admin  = session.get('is_admin')
    emp_ids   = get_supervisor_central_employees(sup_email) if not is_admin else []

    conn   = get_central_db()
    cursor = conn.cursor()
    total  = 0

    for table, id_col in [
        ('fts_requests', 'employeeID'),
        ('ot_requests',  'employee_id'),
        ('cws_requests', 'employee_id'),
        ('rd_requests',  'employee_id'),
    ]:
        if is_admin:
            cursor.execute(f"SELECT COUNT(*) AS cnt FROM {table} WHERE status = 'Pending' AND deleted_at IS NULL")
        elif emp_ids:
            placeholders = ','.join(['%s'] * len(emp_ids))
            cursor.execute(f"SELECT COUNT(*) AS cnt FROM {table} WHERE {id_col} IN ({placeholders}) AND status = 'Pending' AND deleted_at IS NULL", emp_ids)
        else:
            continue
        total += cursor.fetchone()['cnt']

    cursor.close()
    conn.close()
    return jsonify({'count': total})

@app.route('/api/ot-tickets/<int:ot_request_id>')
@login_required
def get_ot_tickets(ot_request_id):
    conn   = get_central_db()
    cursor = conn.cursor()
    cursor.execute(
        """SELECT t.ticket_number, t.status, t.created_at
           FROM ot_tickets t
           WHERE t.ot_request_id = %s
           ORDER BY t.created_at ASC""",
        (ot_request_id,)
    )
    tickets = cursor.fetchall()

    # Check each ticket number for duplicates across all agents
    result = []
    for t in tickets:
        cursor.execute(
            """SELECT COUNT(*) as cnt FROM ot_tickets
               WHERE ticket_number = %s AND ot_request_id != %s""",
            (t['ticket_number'], ot_request_id)
        )
        dup = cursor.fetchone()
        result.append({
            'ticket_number':    t['ticket_number'],
            'status':           t['status'],
            'created_at':       str(t['created_at']),
            'duplicate_global': dup['cnt'] > 0,
            'duplicate_count':  dup['cnt']
        })
    cursor.close()
    conn.close()
    return jsonify(result)



def get_rd_tickets(rd_request_id):
    conn   = get_central_db()
    cursor = conn.cursor()
    cursor.execute(
        """SELECT t.ticket_number, t.status, t.created_at
           FROM ot_tickets t
           WHERE t.rd_request_id = %s
           ORDER BY t.created_at ASC""",
        (rd_request_id,)
    )
    tickets = cursor.fetchall()
    result = []
    for t in tickets:
        cursor.execute(
            """SELECT COUNT(*) as cnt FROM ot_tickets
               WHERE ticket_number = %s AND rd_request_id != %s""",
            (t['ticket_number'], rd_request_id)
        )
        dup = cursor.fetchone()
        result.append({
            'ticket_number':    t['ticket_number'],
            'status':           t['status'],
            'created_at':       str(t['created_at']),
            'duplicate_global': dup['cnt'] > 0,
        })
    cursor.close()
    conn.close()
    return result


@app.route('/api/rd-tickets/<int:rd_id>')
@login_required
def api_rd_tickets(rd_id):
    tickets = get_rd_tickets(rd_id)
    return jsonify(tickets)

@app.route('/api/chat', methods=['POST'])
@login_required
def chat():
    import requests as req
    data = request.json
    message = data.get('message')
    RAG_URL = 'https://ai.cohere.ph'
    try:
        response = req.post(f"{RAG_URL}/chat",
            json={'message': message},
            timeout=120,

        )
        reply = response.json().get('reply', 'No response')
        return jsonify({'reply': reply})
    except Exception as e:
        return jsonify({'reply': f'Error: {str(e)}'}), 500

