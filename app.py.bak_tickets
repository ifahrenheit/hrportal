# MAGIC CWS BALANCE ADMIN
# ─────────────────────────────────────────────────────────────

@app.route("/admin/magic-cws-balance", methods=["GET"])
@login_required
def magic_cws_balance_admin():
    if not session.get("is_admin"):
        flash("Access denied.", "danger")
        return redirect(url_for("dashboard"))

    conn = get_central_db()
    c    = conn.cursor()
    c.execute("""
        SELECT b.emp_number, b.employee_id,
               ge.schedule_name AS employee_name,
               ge.tl AS tl,
               b.initial_hrs, b.used_hrs,
               ROUND(b.initial_hrs - b.used_hrs, 2) AS remaining_hrs,
               b.updated_at
        FROM magic_cws_balance b
        LEFT JOIN gsheet_employees ge ON ge.employee_id = b.employee_id
        ORDER BY ge.tl, b.employee_id
    """)
    balances = c.fetchall()

    c.execute("""
        SELECT a.*
        FROM magic_cws_adjustments a
        ORDER BY a.created_at DESC LIMIT 50
    """)
    adjustments = c.fetchall()

    return render_template("admin/magic_cws_balance_admin.html",
                           balances=balances,
                           adjustments=adjustments)


@app.route("/admin/magic-cws-balance/bulk-add", methods=["POST"])
@login_required
def magic_cws_bulk_add():
    if not session.get("is_admin"):
        flash("Access denied.", "danger")
        return redirect(url_for("magic_cws_balance_admin"))

    raw      = request.form.get("bulk_data", "").strip()
    reason   = request.form.get("reason", "").strip()
    added_by = session["user"]["emp_number"]

    conn = get_central_db()
    c    = conn.cursor()

    success = 0
    errors  = []

    for i, line in enumerate(raw.splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        parts = [p.strip() for p in line.replace("\t", ",").split(",")]
        if len(parts) < 2:
            errors.append(f"Row {i}: invalid format — {line}")
            continue

        employee_id = parts[0].strip()
        try:
            hours = float(parts[1])
        except ValueError:
            errors.append(f"Row {i}: invalid hours — {parts[1]}")
            continue

        c.execute("""
            SELECT em.EmployeeID, CONCAT(em.FirstName,' ',em.LastName) AS name,
                   b.emp_number
            FROM Employees em
            LEFT JOIN magic_cws_balance b ON b.employee_id COLLATE utf8mb4_0900_ai_ci = em.EmployeeID
            WHERE em.EmployeeID = %s
            LIMIT 1
        """, (employee_id,))
        row = c.fetchone()
        if not row:
            errors.append(f"Row {i}: employee_id not found — {employee_id}")
            continue

        emp_number    = row["emp_number"]
        employee_name = row["name"] or ""

        c.execute("""
            INSERT INTO magic_cws_balance (emp_number, employee_id, initial_hrs, used_hrs)
            VALUES (%s, %s, %s, 0)
            ON DUPLICATE KEY UPDATE initial_hrs = initial_hrs + %s
        """, (emp_number, employee_id, hours, hours))

        c.execute("""
            INSERT INTO magic_cws_adjustments
              (emp_number, employee_id, employee_name, hours_added, reason, added_by)
            VALUES (%s, %s, %s, %s, %s, %s)
        """, (emp_number, employee_id, employee_name, hours, reason, added_by))

        success += 1

    conn.commit()

    if success:
        flash(f"{success} employee(s) updated successfully.", "success")
    for e in errors:
        flash(e, "warning")

    return redirect(url_for("magic_cws_balance_admin"))


@app.route("/admin/magic-cws-balance/prepopulate", methods=["POST"])
@login_required
def magic_cws_prepopulate():
    if not session.get("is_admin"):
        flash("Access denied.", "danger")
        return redirect(url_for("magic_cws_balance_admin"))

    conn = get_central_db()
    c    = conn.cursor()
    c.execute("""
        INSERT IGNORE INTO magic_cws_balance (emp_number, employee_id, initial_hrs, used_hrs)
        SELECT
            le.emp_number,
            NULL,
            ROUND((le.no_of_days - le.days_used) * 8, 2),
            0
        FROM orangehrm2.ohrm_leave_entitlement le
        JOIN orangehrm2.ohrm_leave_type lt ON lt.id = le.leave_type_id
        WHERE lt.name = 'Magic Leave'
          AND YEAR(le.from_date) = YEAR(CURDATE())
          AND le.deleted = 0
          AND (le.no_of_days - le.days_used) > 0
    """)
    conn.commit()
    inserted = c.rowcount
    flash(f"Pre-populated {inserted} new employee(s) from OrangeHRM Magic Leave.", "success")
    return redirect(url_for("magic_cws_balance_admin"))

@app.route("/admin/magic-cws-balance/edit", methods=["POST"])
@login_required
def magic_cws_balance_edit():
    if not session.get("is_admin"):
        flash("Access denied.", "danger")
        return redirect(url_for("magic_cws_balance_admin"))

    emp_number  = request.form.get("emp_number")
    employee_id = request.form.get("employee_id")
    initial_hrs = float(request.form.get("initial_hrs", 0))
    used_hrs    = float(request.form.get("used_hrs", 0))
    reason      = request.form.get("reason", "").strip()
    added_by    = session["user"]["emp_number"]

    conn = get_central_db()
    c    = conn.cursor()

    # Get old values for log
    c.execute("SELECT initial_hrs, used_hrs FROM magic_cws_balance WHERE emp_number = %s", (emp_number,))
    old = c.fetchone()
    hrs_diff = round((initial_hrs - float(old["initial_hrs"])) - (used_hrs - float(old["used_hrs"])), 2)

    c.execute("""
        UPDATE magic_cws_balance
        SET initial_hrs = %s, used_hrs = %s
        WHERE emp_number = %s
    """, (initial_hrs, used_hrs, emp_number))

    c.execute("""
        INSERT INTO magic_cws_adjustments
          (emp_number, employee_id, employee_name, hours_added, reason, added_by)
        VALUES (%s, %s,
          (SELECT schedule_name FROM gsheet_employees WHERE employee_id = %s LIMIT 1),
          %s, %s, %s)
    """, (emp_number, employee_id, employee_id, hrs_diff, f"[Manual Edit] {reason}", added_by))

    conn.commit()
    flash("Balance updated.", "success")
    return redirect(url_for("magic_cws_balance_admin"))

