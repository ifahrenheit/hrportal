@app.route('/file-requests/material/purchaser-view')
@login_required
def material_purchaser_view():
    if not (session.get('is_admin') or session.get('permissions', {}).get('can_view_approved_items')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))
    status_filter = request.args.get('status', 'all')
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            if status_filter == 'all':
                c.execute("SELECT * FROM material_requests WHERE deleted_at IS NULL ORDER BY FIELD(status,'Pending Final Approval','Approved','Released','Recommended','Pending','Rejected'), created_at DESC")
            else:
                c.execute("SELECT * FROM material_requests WHERE deleted_at IS NULL AND status=%s ORDER BY created_at DESC", (status_filter,))
            requests_ = c.fetchall()
    finally:
        cdb.close()
    return render_template('file_requests/material_purchaser.html',
                           requests=requests_, user=session['user'],
                           status_filter=status_filter)
