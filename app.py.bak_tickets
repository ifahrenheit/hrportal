@app.route('/file-requests/material/<int:req_id>/pdf')
@login_required
def material_request_pdf(req_id):
    from flask import send_file
    from reportlab.lib.pagesizes import A4
    from reportlab.lib import colors
    from reportlab.lib.units import mm
    from reportlab.platypus import Table, TableStyle, Paragraph
    from reportlab.lib.styles import ParagraphStyle
    from reportlab.lib.enums import TA_CENTER, TA_LEFT
    from reportlab.pdfgen import canvas as rl_canvas
    import io

    if not (session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')):
        abort(403)

    cdb = get_central_db()
    try:
        with cdb.cursor() as cur:
            cur.execute("SELECT * FROM material_requests WHERE id=%s AND deleted_at IS NULL", (req_id,))
            r = cur.fetchone()
    finally:
        cdb.close()

    if not r:
        abort(404)

    # ── build PDF ───────────────────────────────────────────────────────────
    buf = io.BytesIO()
    c = rl_canvas.Canvas(buf, pagesize=A4)
    W, H = A4
    M = 18 * mm

    # Header box
    c.setLineWidth(2)
    c.rect(M - 4, H - 38*mm, W - 2*M + 8, 30*mm)
    # Text on the left, logo on the right
    LOGO = "/var/www/html/leavesystem/static/img/cohere-logo-mrf.jpg"
    LOGO_W = 52*mm
    LOGO_H = 26*mm
    LOGO_X = W - M - LOGO_W - 2*mm
    LOGO_Y = H - 38*mm + (30*mm - LOGO_H) / 2
    try:
        c.drawImage(LOGO, LOGO_X, LOGO_Y,
                    width=LOGO_W, height=LOGO_H, preserveAspectRatio=True)
    except Exception:
        pass
    c.setFont("Helvetica-Bold", 14)
    c.drawString(M + 2*mm, H - 15*mm, "COHERE OUTSOURCING (PHILIPPINES) INC.")
    c.setFont("Helvetica-Bold", 10)
    c.drawString(M + 2*mm, H - 22*mm, "Material Requisition Form")
    c.setFont("Helvetica", 9)
    c.drawString(M + 2*mm, H - 28*mm, "Version 1  04.08.2025")

    y = H - 45*mm

    # Date
    date_str = r['created_at'].strftime('%B %d, %Y') if r.get('created_at') else ''
    c.setFont("Helvetica", 10)
    c.drawString(M, y, "Date:")
    c.line(M + 14*mm, y - 1.5, M + 75*mm, y - 1.5)
    c.drawString(M + 15*mm, y, date_str)

    y -= 10*mm

    # Department line (use category as department)
    prefix = "With your approval, may I request for the purchase of the following item/s to be used by:"
    c.setFont("Helvetica", 10)
    c.drawString(M, y, prefix)
    pw = c.stringWidth(prefix, "Helvetica", 10)
    c.line(M + pw + 3, y - 1.5, W - M, y - 1.5)
    c.drawString(M + pw + 5, y, r.get('category', ''))
    y -= 5*mm
    c.setFont("Helvetica-Oblique", 8)
    c.drawRightString(W - M, y, "(please state department)")
    y -= 5*mm

    # Items table
    col_w = [90*mm, 28*mm, 35*mm, 35*mm]
    hdr = ParagraphStyle("h", fontName="Helvetica-Bold", fontSize=9, alignment=TA_CENTER, leading=12)
    td  = ParagraphStyle("d", fontName="Helvetica",      fontSize=9, alignment=TA_LEFT,   leading=11)
    tdc = ParagraphStyle("c", fontName="Helvetica",      fontSize=9, alignment=TA_CENTER, leading=11)

    rows = [[
        Paragraph("ITEM DESCRIPTION", hdr),
        Paragraph("QUANTITY", hdr),
        Paragraph("Unit Cost<br/><font size='7'>(For Admin Use Only)</font>", hdr),
        Paragraph("Total Amount<br/><font size='7'>(For Admin Use Only)</font>", hdr),
    ]]

    # Single row merging request + admin purchase details
    item_desc = r.get('purchase_item_desc') or r.get('item_name', '')
    item_qty  = r.get('quantity', '')
    unit  = f"PHP {r['purchase_unit_cost']:,.2f}" if r.get('purchase_unit_cost') else ''
    total = f"PHP {r['purchase_total']:,.2f}"     if r.get('purchase_total')     else ''
    rows.append([
        Paragraph(item_desc, td),
        Paragraph(str(item_qty), tdc),
        Paragraph(unit,  tdc),
        Paragraph(total, tdc),
    ])
    while len(rows) < 11:
        rows.append(["", "", "", ""])
        rows.append(["", "", "", ""])

    tbl = Table(rows, colWidths=col_w, rowHeights=[13*mm] + [8*mm]*(len(rows)-1))
    tbl.setStyle(TableStyle([
        ("GRID",         (0,0), (-1,-1), 0.5, colors.black),
        ("VALIGN",       (0,0), (-1,-1), "MIDDLE"),
        ("ALIGN",        (1,0), (-1,-1), "CENTER"),
        ("TOPPADDING",   (0,0), (-1,-1), 2),
        ("BOTTOMPADDING",(0,0), (-1,-1), 2),
    ]))

    tbl_h = 13*mm + 10*8*mm
    tbl.wrapOn(c, sum(col_w), tbl_h)
    tbl.drawOn(c, M, y - tbl_h)
    y -= tbl_h + 7*mm

    # Justification
    c.setFont("Helvetica-Bold", 10)
    c.drawString(M, y, "JUSTIFICATION")
    c.setFont("Helvetica", 10)
    c.drawString(M + 32*mm, y, "(Please indicate clearly reasons for request).")
    y -= 7*mm

    justification = r.get('reason') or ''
    words, lines, cur_line = justification.split(), [], ""
    for w in words:
        test = (cur_line + " " + w).strip()
        if c.stringWidth(test, "Helvetica", 10) <= (W - 2*M):
            cur_line = test
        else:
            lines.append(cur_line); cur_line = w
    if cur_line: lines.append(cur_line)
    while len(lines) < 2: lines.append("")

    for ln in lines[:2]:
        c.drawString(M, y, ln)
        c.line(M, y - 2, W - M, y - 2)
        y -= 8*mm

    y -= 6*mm

    # Signatures
    sig_w = (W - 2*M) / 3
    for i, (label, name) in enumerate([
        ("Requested by:",   r.get('employee_name', '')),
        ("Recommended by:", r.get('som_name', '') or ''),
        ("Approved By:",    r.get('final_approver_name', '') or ''),
    ]):
        x = M + i * sig_w
        line_x1 = x + 2
        line_x2 = x + sig_w - 6

        # Label above
        c.setFont("Helvetica", 9)
        c.drawString(x, y, label)

        # Name centered on the signature line
        name_y = y - 9*mm
        if name:
            c.setFont("Helvetica", 9)
            name_w = c.stringWidth(name, "Helvetica", 9)
            name_cx = (line_x1 + line_x2) / 2
            c.drawCentredString(name_cx, name_y + 2, name)

        # Signature line
        c.setLineWidth(0.5)
        c.line(line_x1, name_y, line_x2, name_y)

        # Small label below line
        c.setFont("Helvetica", 7)
        c.drawCentredString((line_x1 + line_x2) / 2, name_y - 5, "Signature over Printed Name")

    y -= 14*mm

    # Dotted separator
    c.setDash(2, 3); c.setLineWidth(0.5)
    c.line(M, y, W - M, y)
    c.setDash(); y -= 7*mm

    # For Admin Use Only
    c.setFont("Helvetica-Bold", 11)
    c.drawCentredString(W/2, y, "FOR ADMIN USE ONLY")
    y -= 8*mm

    c.setFont("Helvetica", 10)
    c.drawString(M + 20*mm, y, "Remarks:")

    BOX = 3.5*mm
    admin_remarks = (r.get('admin_remarks') or '').strip()

    for cx, label, checked in [
        (M + 55*mm, "Need to Purchase", admin_remarks == 'Need to Purchase'),
        (M + 105*mm, "On Stock",        admin_remarks == 'On Stock'),
    ]:
        c.setLineWidth(0.8)
        c.rect(cx, y - 1, BOX, BOX)
        if checked:
            c.setLineWidth(1.2)
            c.line(cx + 0.5,        y + BOX/2, cx + BOX*0.4, y - 0.5)
            c.line(cx + BOX*0.4,    y - 0.5,   cx + BOX + 0.5, y + BOX)
        c.setFont("Helvetica", 10)
        c.drawString(cx + BOX + 2, y, label)

    c.save()
    buf.seek(0)

    filename = f"MRF-{req_id:04d}_{r['created_at'].strftime('%Y%m%d')}.pdf"
    return send_file(buf, mimetype='application/pdf',
                     as_attachment=True, download_name=filename)
# ── end MRF PDF ────────────────────────────────────────────────────────────────

@app.route('/file-requests/material/admin-action', methods=['POST'])
@login_required
def material_admin_action():
    if not (session.get('is_admin') or session.get('permissions', {}).get('can_material_requests')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))
    req_id             = int(request.form.get('req_id'))
    admin_remark       = request.form.get('admin_remarks', '').strip()
    action             = request.form.get('action')
    purchase_item_desc = request.form.get('purchase_item_desc', '').strip() or None
    purchase_quantity  = request.form.get('purchase_quantity') or None
    purchase_unit_cost = request.form.get('purchase_unit_cost') or None
    purchase_total     = request.form.get('purchase_total') or None
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            if action == 'reject':
                c.execute("UPDATE material_requests SET status='Rejected', admin_name=%s, admin_action_at=NOW(), admin_remarks=%s WHERE id=%s", (session['user']['name'], admin_remark, req_id))
                cdb.commit()
                flash('Request rejected.', 'success')
                return redirect(url_for('material_admin_review'))
            if action == 'process' and admin_remark in ('On Stock', 'Need to Purchase'):
                c.execute("""UPDATE material_requests
                             SET status='Pending Final Approval', admin_name=%s,
                                 admin_action_at=NOW(), admin_remarks=%s,
                                 purchase_item_desc=%s, purchase_quantity=%s,
                                 purchase_unit_cost=%s, purchase_total=%s
                             WHERE id=%s""",
                          (session['user']['name'], admin_remark,
                           purchase_item_desc, purchase_quantity,
                           purchase_unit_cost, purchase_total, req_id))
                c.execute('SELECT * FROM material_requests WHERE id=%s', (req_id,))
                req = c.fetchone()
                cdb.commit()
                eta = '36 hours' if admin_remark == 'On Stock' else '1 week'
                purchase_section = ''
                if admin_remark == 'Need to Purchase' and purchase_item_desc:
                    purchase_section = f"""<br><h4>Purchase Order Details</h4>
                    <ul>
                      <li><b>Item Description:</b> {purchase_item_desc}</li>
                      <li><b>Quantity:</b> {purchase_quantity}</li>
                      <li><b>Unit Cost:</b> &#8369;{purchase_unit_cost}</li>
                      <li><b>Total Amount:</b> &#8369;{purchase_total}</li>
                    </ul>"""
                for final_email in get_material_final_emails():
                  send_material_email(
                    final_email,
                    f'[Material Request] Approval Needed — {req["employee_name"]}',
                    f"<p>A material request requires your approval:</p><ul><li><b>Employee:</b> {req['employee_name']} ({req['employee_id']})</li><li><b>Category:</b> {req['category']}</li><li><b>Item:</b> {req['item_name']} (x{req['quantity']})</li><li><b>Reason:</b> {req['reason'] or '—'}</li><li><b>Admin Remark:</b> {admin_remark}</li><li><b>ETA:</b> {eta}</li></ul>{purchase_section}<p>Please <a href='https://hrportal.cohere.ph/file-requests/material/final-approval'>click here</a> to approve or reject.</p>"
                  )
                flash(f'Request marked as "{admin_remark}" and sent to final approver.', 'success')
            else:
                flash('Please select a valid remark.', 'danger')
    finally:
        cdb.close()
    return redirect(url_for('material_admin_review'))


@app.route('/file-requests/cancel/<req_type>/<int:req_id>', methods=['POST'])
@login_required
def cancel_file_request(req_type, req_id):
    employee_id = session['user'].get('employee_id', '')
    is_admin    = session.get('is_admin', False)

    table_map = {
        'ot':  ('ot_requests',  'employee_id', 'Pending'),
        'rdw': ('rd_requests',  'employee_id', 'Pending'),
        'fts': ('fts_requests', 'employeeID',  'Pending'),
        'cws': ('cws_requests', 'employee_id', 'Pending'),
    }
    if req_type not in table_map:
        flash('Invalid request type.', 'danger')
        return redirect(url_for('file_requests_hub'))

    table, emp_col, allowed_status = table_map[req_type]
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            c.execute(f"SELECT * FROM {table} WHERE id = %s", (req_id,))
            req = c.fetchone()
            if not req:
                flash('Request not found.', 'danger')
                return redirect(url_for('file_requests_hub'))
            if req[emp_col] != employee_id and not is_admin:
                flash('You do not have permission to cancel this request.', 'danger')
                return redirect(url_for('file_requests_hub'))
            if req['status'] != allowed_status:
                flash(f'Cannot cancel a request with status: {req["status"]}.', 'warning')
                return redirect(url_for('file_requests_hub'))
            c.execute(f"UPDATE {table} SET status = 'Cancelled', deleted_at = NOW() WHERE id = %s", (req_id,))
        cdb.commit()
        flash('Request cancelled successfully.', 'success')
    finally:
        cdb.close()
    # Redirect back to correct page
    redirect_map = {'ot': 'file_ot', 'rdw': 'file_ot', 'fts': 'file_fts', 'cws': 'file_cws'}
    return redirect(url_for(redirect_map[req_type]))


@app.route('/file-requests')
@login_required
def file_requests_hub():
    from datetime import date
    date_from  = request.args.get('date_from', date.today().strftime('%Y-01-01'))
    date_to    = request.args.get('date_to', date.today().strftime('%Y-%m-%d'))
    status_f   = request.args.get('status', '')
    req_type   = request.args.get('req_type', '')
    sub_type   = request.args.get('sub_type', '')
    emp_search = request.args.get('emp_search', '')
    tl_filter  = request.args.get('tl', '')
    approver_filter = request.args.get('approver', '') if session.get('is_admin') else ''

    is_admin      = bool(session.get('is_admin'))
    is_supervisor = bool(session.get('is_supervisor'))
    can_file_requests = bool(session.get('permissions', {}).get('can_file_requests'))
    user_email    = session['user']['email']
    own_emp_id    = get_central_employee_id(user_email)

    if is_admin or can_file_requests:
        allowed_ids = None
    elif is_supervisor:
        subs = get_supervisor_central_employees(user_email) or []
        allowed_ids = list({*subs, *([own_emp_id] if own_emp_id else [])})
    else:
        allowed_ids = [own_emp_id] if own_emp_id else []

    def build_filters(date_col, id_col, name_expr, tbl_alias='t'):
        where  = [] if is_admin else [f"{tbl_alias}.deleted_at IS NULL"]
        params = []
        if date_from:
            where.append(f"{date_col} >= %s");  params.append(date_from)
        if date_to:
            where.append(f"{date_col} <= %s");  params.append(date_to)
        if status_f:
            where.append(f"{tbl_alias}.status = %s");        params.append(status_f)
        if emp_search:
            where.append(f"({name_expr} LIKE %s OR {id_col} LIKE %s)")
            params += [f'%{emp_search}%', f'%{emp_search}%']
        if tl_filter:
            where.append("g.tl = %s");          params.append(tl_filter)
        if approver_filter:
            where.append("g.approver = %s");    params.append(approver_filter)
        if allowed_ids is not None:
            if not allowed_ids:
                where.append("1=0")
            else:
                ph = ','.join(['%s'] * len(allowed_ids))
                where.append(f"{id_col} IN ({ph})")
                params += list(allowed_ids)
        return ' AND '.join(where), params

    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            if is_admin:
                if approver_filter:
                    c.execute("""SELECT DISTINCT tl FROM gsheet_employees
                             WHERE approver = %s AND tl IS NOT NULL AND tl != '' AND status != 'Separated'
                             ORDER BY tl""", (approver_filter,))
                else:
                    c.execute("""SELECT DISTINCT tl FROM gsheet_employees
                             WHERE tl IS NOT NULL AND tl != '' AND status != 'Separated'
                             ORDER BY tl""")
            else:
                c.execute("""SELECT DISTINCT tl FROM gsheet_employees
                             WHERE approver = %s AND tl IS NOT NULL AND tl != ''
                               AND status != 'Separated' ORDER BY tl""",
                          (session['user']['email'],))
            tl_list = [r['tl'] for r in c.fetchall()]
            approver_list = []
            if session.get('is_admin'):
                c.execute("""SELECT DISTINCT approver FROM gsheet_employees
                    WHERE approver IS NOT NULL AND approver != '' AND approver != '#N/A' AND status != 'Separated'
                    ORDER BY approver""")
                approver_list = [r['approver'] for r in c.fetchall()]

            records = []

            if not req_type or req_type == 'FTS':
                w, p = build_filters('f.fts_date', 'f.employeeID', 'f.employee_name', 'f')
                c.execute(f"""
                    SELECT 'FTS' AS req_type, f.id, f.employeeID AS emp_id,
                           COALESCE(g.schedule_name, f.employee_name) AS employee_name,
                           f.fts_date AS req_date,
                           CONCAT(f.fts_type, ' @ ', TIME_FORMAT(f.fts_time,'%%H:%%i')) AS details,
                           f.status, f.created_at, f.approved_at, f.approver_name,
                           g.tl AS TL, g.group_name
                    FROM fts_requests f
                    LEFT JOIN gsheet_employees g ON g.employee_id = f.employeeID COLLATE utf8mb4_unicode_ci
                    WHERE {w}
                """, p)
                records.extend(c.fetchall())

            if not req_type or req_type == 'OT':
                w, p = build_filters('o.ot_date', 'o.employee_id', 'g.schedule_name', 'o')
                if sub_type and sub_type in ('PRE','POST','TEAM_MEETING','OVERHEAD_OT','DAILY_OT','QA_REFRESHER','OT260'):
                    w += ' AND o.ot_type = %s'; p.append(sub_type)
                c.execute(f"""
                    SELECT 'OT' AS req_type, o.id, o.employee_id AS emp_id,
                           COALESCE(g.schedule_name, o.employee_id) AS employee_name,
                           o.ot_date AS req_date,
                           CONCAT(o.ot_type, ' ',
                                  TIME_FORMAT(o.start_time,'%%H:%%i'), '-',
                                  TIME_FORMAT(o.end_time,'%%H:%%i')) AS details,
                           o.status, o.timestamp AS created_at, o.approved_at, o.approver_name,
                           g.tl AS TL, g.group_name,
                           ROUND(MOD(TIMESTAMPDIFF(MINUTE,
                               CONCAT(o.ot_date," ",o.start_time),
                               CONCAT(o.ot_date," ",o.end_time)
                           ) + 1440, 1440) / 60, 2) AS hours
                    FROM ot_requests o
                    LEFT JOIN gsheet_employees g ON g.employee_id = o.employee_id COLLATE utf8mb4_unicode_ci
                    WHERE {w}
                """, p)
                records.extend(c.fetchall())

            if not req_type or req_type == 'CWS':
                w, p = build_filters('c.original_date', 'c.employee_id', 'g.schedule_name', 'c')
                c.execute(f"""
                    SELECT 'CWS' AS req_type, c.id, c.employee_id AS emp_id,
                           COALESCE(g.schedule_name, c.employee_id) AS employee_name,
                           c.original_date AS req_date,
                           CONCAT(c.original_date, ' ', c.original_time,
                                  ' > ', c.new_date, ' ', c.new_time) AS details,
                           c.status, c.created_at, c.approved_at, c.approver_name,
                           g.tl AS TL, g.group_name
                    FROM cws_requests c
                    LEFT JOIN gsheet_employees g ON g.employee_id = c.employee_id COLLATE utf8mb4_unicode_ci
                    WHERE {w}
                """, p)
                records.extend(c.fetchall())

            if not req_type or req_type == 'RDW':
                w, p = build_filters('r.rd_date', 'r.employee_id', 'g.schedule_name', 'r')
                if sub_type and sub_type in ('REGULAR','OVERHEAD_OT','TEAM_MEETING','OT260','DAILY_OT'):
                    w += ' AND r.work_category = %s'; p.append(sub_type)
                c.execute(f"""
                    SELECT 'RDW' AS req_type, r.id, r.employee_id AS emp_id,
                           COALESCE(g.schedule_name, r.employee_id) AS employee_name,
                           r.rd_date AS req_date,
                           CONCAT(r.work_category, ' ',
                                  TIME_FORMAT(r.start_time,'%%H:%%i'), '-',
                                  TIME_FORMAT(r.end_time,'%%H:%%i')) AS details,
                           r.status, r.created_at, r.approved_at, r.approver_name,
                           g.tl AS TL, g.group_name,
                           ROUND(MOD(TIMESTAMPDIFF(MINUTE,
                               CONCAT(r.rd_date," ",r.start_time),
                               CONCAT(r.rd_date," ",r.end_time)
                           ) + 1440, 1440) / 60, 2) AS hours
                    FROM rd_requests r
                    LEFT JOIN gsheet_employees g ON g.employee_id = r.employee_id COLLATE utf8mb4_unicode_ci
                    WHERE {w}
                """, p)
                records.extend(c.fetchall())

    finally:
        cdb.close()

    records.sort(key=lambda r: (
        r.get('TL') or 'zzz',
        -(r['req_date'].toordinal() if r.get('req_date') else 0)
    ))

    # Get display name if emp_search is an employee_id
    emp_display = emp_search
    if emp_search and records:
        try:
            cdb2 = get_central_db()
            with cdb2.cursor() as cc:
                cc.execute('SELECT schedule_name FROM gsheet_employees WHERE employee_id = %s LIMIT 1', (emp_search,))
                gs = cc.fetchone()
                emp_display = gs['schedule_name'] if gs and gs['schedule_name'] else emp_search
            cdb2.close()
        except:
            pass

    return render_template('file_requests/index.html',
                           records=records, user=session['user'],
                           tl_list=tl_list,
                           is_admin=is_admin, is_supervisor=is_supervisor,
                           can_file_requests=can_file_requests,
                           date_from=date_from, date_to=date_to,
                           status=status_f, req_type=req_type,
                           emp_search=emp_search, emp_display=emp_display,
                           tl_filter=tl_filter,
                           approver_filter=approver_filter,
                           approver_list=approver_list,
                           sub_type=sub_type)


# ── FTS ──────────────────────────────────────────────────────
# Schema fixes:
#   - column is "employeeID" not "employee_id"
#   - "approver" is NOT NULL, must be included in INSERT
#   - history ORDER BY created_at (exists here, ok)

@app.route('/file-requests/fts', methods=['GET', 'POST'])
@login_required
def file_fts():
    email = session['user']['email']
    employee_id = get_central_employee_id(email)
    message = None
    msg_type = 'success'

    if request.method == 'POST':
        fts_date = request.form.get('fts_date', '').strip()
        fts_time = request.form.get('fts_time', '').strip()
        fts_type = request.form.get('fts_type', '').strip()

        if not all([fts_date, fts_time, fts_type]):
            message = 'All fields are required.'
            msg_type = 'danger'
        elif not employee_id:
            message = 'Your account is not linked to an Employee ID. Contact HR.'
            msg_type = 'danger'
        else:
            conn = get_central_db()
            cursor = conn.cursor()

            # Get employee full name
            cursor.execute(
                "SELECT CONCAT(FirstName,' ',LastName) AS name FROM Employees WHERE EmployeeID = %s",
                (employee_id,)
            )
            emp = cursor.fetchone()
            employee_name = emp['name'] if emp else email

            # Duplicate check
            cursor.execute(
                """SELECT id FROM fts_requests
                   WHERE employeeID = %s COLLATE utf8mb4_unicode_ci
                   AND fts_date = %s
                   AND fts_time = %s
                   AND fts_type = %s""",
                (employee_id, fts_date, fts_time, fts_type)
            )
            if cursor.fetchone():
                message = 'You already submitted this exact FTS request.'
                msg_type = 'warning'
            else:
                # "approver" is NOT NULL — pass employee_name as placeholder
                # (PHP sets it to the approver's name after approval,
                #  but it must not be empty on insert)
                cursor.execute(
                    """INSERT INTO fts_requests
                       (employeeID, employee_name, fts_date, fts_time, fts_type,
                        status, approver)
                       VALUES (%s, %s, %s, %s, %s, 'Pending', %s)""",
                    (employee_id, employee_name, fts_date, fts_time, fts_type,
                     '')   # approver starts empty, PHP fills it on approval
                )
                conn.commit()
                message = 'FTS request submitted successfully!'
                # ── Notify ──────────────────────────────────────
                emp_number = session['user']['emp_number']
                notify_file_request(emp_number, 'FTS', f"""
                    <ul>
                    <li><b>Date:</b> {fts_date}</li>
                    <li><b>Time:</b> {fts_time}</li>
                    <li><b>Type:</b> {fts_type}</li>
                    </ul>""")
            cursor.close()

    # Fetch history
    history = []
    if employee_id:
        conn = get_central_db()
        cursor = conn.cursor()
        cursor.execute(
            """SELECT fts_date, fts_time, fts_type, status,
                      approver_name, approved_at
               FROM fts_requests
               WHERE employeeID = %s COLLATE utf8mb4_unicode_ci
               ORDER BY created_at DESC
               LIMIT 30""",
            (employee_id,)
        )
        history = cursor.fetchall()
        cursor.close()

    return render_template('file_requests/fts.html',
                           message=message, msg_type=msg_type,
                           history=history)


# ── OT + RDW (combined) ──────────────────────────────────────

TICKET_REQUIRED_TYPES = {'PRE', 'POST', 'OT260'}
NO_TICKET_TYPES       = {'OVERHEAD_OT', 'TEAM_MEETING', 'QA_REFRESHER'}

@app.route('/file-requests/ot', methods=['GET', 'POST'])
@login_required
def file_ot():
    from datetime import datetime, timedelta
    import re

    email       = session['user']['email']
    employee_id = get_central_employee_id(email)
    message     = None
    msg_type    = 'success'

    time_options = [
        f"{h:02d}:{m}:00"
        for h in range(24)
        for m in ('00', '30')
    ]

    if request.method == 'POST':
        work_day_type = request.form.get('work_day_type', '').strip()
        ot_date       = request.form.get('ot_date', '').strip()
        start_time    = request.form.get('start_time', '').strip()
        end_time      = request.form.get('end_time', '').strip()

        # Regular OT specific
        ot_type       = request.form.get('ot_type', '').strip()
        regular_rate  = request.form.get('regular_rate', '').strip()
        tickets_raw   = request.form.get('ticket_numbers', '').strip()

        # Rest Day specific
        work_category = request.form.get('work_category', 'REGULAR').strip()

        # ── Validation ──────────────────────────────────────
        errors = []

        if not work_day_type:
            errors.append('Please select a Work Day Type.')
        if not ot_date:
            errors.append('Date is required.')
        if not start_time or not end_time:
            errors.append('Start and end time are required.')
        if not employee_id:
            errors.append('Your account is not linked to an Employee ID. Contact HR.')

        if work_day_type == 'REGULAR':
            if not ot_type:
                errors.append('OT Type is required.')
            if not regular_rate:
                errors.append('Regular Rate is required.')

        # Ticket validation
        # Regular OT: PRE and POST require tickets
        # Rest Day: REGULAR work category requires tickets
        ticket_list = []
        needs_tickets = (
            (work_day_type == 'REGULAR' and ot_type in TICKET_REQUIRED_TYPES) or
            (work_day_type == 'REST_DAY' and work_category in ('REGULAR', 'OT260'))
        )
        if needs_tickets:
            if not tickets_raw:
                errors.append('Ticket numbers are required for this request type.')
            else:
                raw_tickets = re.split(r'[\s,\n\r\t]+', tickets_raw)
                raw_tickets = [t.strip() for t in raw_tickets if t.strip()]
                invalid = []
                for t in raw_tickets:
                    if not t.isdigit():
                        invalid.append(f"{t} (non-numeric)")
                    elif len(t) < 5:
                        invalid.append(f"{t} (too short, min 5 digits)")
                    else:
                        ticket_list.append(t)
                if invalid:
                    errors.append(f"Invalid ticket(s): {', '.join(invalid)}")

        if errors:
            message  = ' | '.join(errors)
            msg_type = 'danger'
        else:
            # ── Calculate OT hours (handles overnight) ──────
            fmt      = '%H:%M:%S'
            dt_start = datetime.strptime(start_time, fmt)
            dt_end   = datetime.strptime(end_time, fmt)
            if dt_end <= dt_start:
                dt_end += timedelta(days=1)
            ot_hours = round((dt_end - dt_start).seconds / 3600, 2)

            conn   = get_central_db()
            cursor = conn.cursor()

            if work_day_type == 'REGULAR':
                # ── Duplicate check ──────────────────────────
                cursor.execute(
                    """SELECT id FROM ot_requests
                       WHERE employee_id = %s AND ot_date = %s
                       AND status IN ('Pending','Approved')
                       AND deleted_at IS NULL
                       AND start_time < %s AND end_time > %s""",
                    (employee_id, ot_date, end_time, start_time)
                )
                if cursor.fetchone():
                    message  = 'You already have an OT request with overlapping time on this date.'
                    msg_type = 'warning'
                else:
                    tickets_submitted_flag = 1 if ticket_list else 0
                    cursor.execute(
                        """INSERT INTO ot_requests
                           (employee_id, ot_date, ot_type, regular_rate,
                            start_time, end_time, status, tickets_submitted, timestamp)
                           VALUES (%s,%s,%s,%s,%s,%s,'Pending',%s,NOW())""",
                        (employee_id, ot_date, ot_type, regular_rate,
                         start_time, end_time, tickets_submitted_flag)
                    )
                    ot_request_id    = cursor.lastrowid
                    hours_per_ticket = round(ot_hours / len(ticket_list), 2) if ticket_list else ot_hours

                    for ticket_number in ticket_list:
                        cursor.execute(
                            """INSERT INTO ot_tickets
                               (ot_request_id, agent_id, ot_date,
                                ot_start_time, ot_end_time, ot_hours,
                                ticket_type, priority, status,
                                ticket_number, issue_description, resolution_notes)
                               VALUES (%s,%s,%s,%s,%s,%s,
                                       'general','medium','pending',
                                       %s,'OT ticket','')""",
                            (ot_request_id, employee_id, ot_date,
                             start_time, end_time, hours_per_ticket,
                             ticket_number)
                        )
                    conn.commit()
                    if ticket_list:
                        message = f'OT request submitted with {len(ticket_list)} ticket(s)!'
                    else:
                        message = 'OT request submitted successfully!'
                    # ── Notify ──────────────────────────────────────
                    emp_number = session['user']['emp_number']
                    notify_file_request(emp_number, 'Overtime', f"""
                        <ul>
                        <li><b>Date:</b> {ot_date}</li>
                        <li><b>Type:</b> {ot_type}</li>
                        <li><b>Start:</b> {start_time} → <b>End:</b> {end_time}</li>
                        <li><b>Tickets:</b> {len(ticket_list) if ticket_list else 'N/A'}</li>
                        </ul>""")

            else:  # REST_DAY → rd_requests
                cursor.execute(
                    """SELECT id, status FROM rd_requests
                       WHERE employee_id = %s AND rd_date = %s
                       AND start_time < %s AND end_time > %s
                       AND status NOT IN ('Cancelled','Rejected','Deleted')""",
                    (employee_id, ot_date, end_time, start_time)
                )
                existing = cursor.fetchone()
                if existing:
                    message  = f'You already have a {existing["status"]} RDW request with overlapping time on this date.'
                    msg_type = 'warning'
                else:
                    cursor.execute(
                        """INSERT INTO rd_requests
                           (employee_id, rd_date, start_time, end_time,
                            work_category, status)
                           VALUES (%s,%s,%s,%s,%s,'Pending')""",
                        (employee_id, ot_date, start_time, end_time, work_category)
                    )
                    rd_request_id = cursor.lastrowid
                    hours_per_ticket = round(ot_hours / len(ticket_list), 2) if ticket_list else ot_hours
                    for ticket_number in ticket_list:
                        cursor.execute(
                            """INSERT INTO ot_tickets
                               (rd_request_id, agent_id, ot_date,
                                ot_start_time, ot_end_time, ot_hours,
                                ticket_type, priority, status,
                                ticket_number, issue_description, resolution_notes)
                               VALUES (%s,%s,%s,%s,%s,%s,
                                       'general','medium','pending',
                                       %s,'RDW ticket','')""",
                            (rd_request_id, employee_id, ot_date,
                             start_time, end_time, hours_per_ticket,
                             ticket_number)
                        )
                    conn.commit()
                    if ticket_list:
                        message = f'Rest Day Work request submitted with {len(ticket_list)} ticket(s)!'
                    else:
                        message = 'Rest Day Work request submitted successfully!'
                    # ── Notify ──────────────────────────────────────
                    emp_number = session['user']['emp_number']
                    notify_file_request(emp_number, 'Rest Day Work', f"""
                        <ul>
                        <li><b>Date:</b> {ot_date}</li>
                        <li><b>Time:</b> {start_time} → {end_time}</li>
                        <li><b>Category:</b> {work_category}</li>
                        <li><b>Tickets:</b> {len(ticket_list) if ticket_list else 'N/A'}</li>
                        </ul>""")

            cursor.close()
            conn.close()

    # ── History: OT ─────────────────────────────────────────
    ot_history = []
    rd_history = []
    if employee_id:
        conn   = get_central_db()
        cursor = conn.cursor()

        cursor.execute(
            """SELECT o.id, o.ot_date, o.ot_type, o.regular_rate,
                      o.start_time, o.end_time, o.status,
                      o.approver_name, o.approved_at, o.deleted_at,
                      COUNT(t.id) AS ticket_count
               FROM ot_requests o
               LEFT JOIN ot_tickets t ON t.ot_request_id = o.id
               WHERE o.employee_id = %s
               GROUP BY o.id
               ORDER BY o.ot_date DESC, o.timestamp DESC
               LIMIT 20""",
            (employee_id,)
        )
        ot_history = cursor.fetchall()

        cursor.execute(
            """SELECT id, rd_date, start_time, end_time, work_category,
                      status, approver_name, approved_at
               FROM rd_requests
               WHERE employee_id = %s
               ORDER BY rd_date DESC, created_at DESC
               LIMIT 20""",
            (employee_id,)
        )
        rd_history = cursor.fetchall()
        cursor.close()
        conn.close()

    return render_template('file_requests/ot.html',
                           message=message, msg_type=msg_type,
                           ot_history=ot_history, rd_history=rd_history,
                           time_options=time_options,
                           ticket_required_types=list(TICKET_REQUIRED_TYPES),
                           no_ticket_types=list(NO_TICKET_TYPES))


