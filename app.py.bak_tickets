@app.route('/file-requests/facilities/final-action', methods=['POST'])
@login_required
def facilities_final_action():
    if not (session.get('is_admin') or session.get('permissions', {}).get('can_facilities_final')):
        flash('Access denied.', 'danger')
        return redirect(url_for('dashboard'))
    req_id = int(request.form.get('req_id'))
    action = request.form.get('action')
    cdb = get_central_db()
    try:
        with cdb.cursor() as c:
            if action == 'approve':
                c.execute("""UPDATE facilities_requests
                             SET status='Approved', final_approver_name=%s,
                                 final_action_at=NOW()
                             WHERE id=%s""",
                          (session['user']['name'], req_id))
                cdb.commit()
                c.execute("SELECT * FROM facilities_requests WHERE id=%s", (req_id,))
                fac_r = c.fetchone()
                for email in get_facilities_reviewer_emails():
                    send_facilities_email(
                        email,
                        f'[Facilities] Request Approved — {fac_r["employee_name"] if fac_r else ""}',
                        f"""<p>A facilities request has been <b>approved</b>. Please add work details.</p>
                        <ul>
                          <li><b>Employee:</b> {fac_r["employee_name"] if fac_r else ""}</li>
                          <li><b>Department/Location:</b> {fac_r["department_location"] if fac_r else ""}</li>
                          <li><b>Issue:</b> {fac_r["issue_description"] if fac_r else ""}</li>
                        </ul>
                        <p><a href="https://hrportal.cohere.ph/file-requests/facilities/review">Add work details here</a></p>"""
                    )
                flash('Request approved.', 'success')
            else:
                c.execute("""UPDATE facilities_requests
                             SET status='Rejected', final_approver_name=%s,
                                 final_action_at=NOW()
                             WHERE id=%s""",
                          (session['user']['name'], req_id))
                cdb.commit()
                flash('Request rejected.', 'success')
            cdb.commit()
    finally:
        cdb.close()
    return redirect(url_for('facilities_final'))


